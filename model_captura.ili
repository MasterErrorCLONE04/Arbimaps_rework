          !!@ ili2db.dispName="Estaci├│n de bombeo"
          Estacion_Bombeo,
          /** Instalaci├│n que permite el tr├ínsito de personas y la conexi├│n con sistemas de transporte como buses, metro, tren, tranv├¡a, terminales y estaciones, destinadas para la movilidad de las personas.
           */
          !!@ ili2db.dispName="Estaci├│n de sistema de transporte"
