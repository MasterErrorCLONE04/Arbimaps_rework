        !!@ ili2db.dispName="Tarjeta de identidad"
        Tarjeta_Identidad,
        /** Registro donde se hacen constar por autoridades competentes los nacimientos, matrimonios, defunciones y dem├ís hechos relativos al estado civil de las personas. En el modelo se tendr├í en cuenta el n├║mero de registro como identificaci├│n personal de las personas de 0 a 7 a├▒os.
         */
        !!@ ili2db.dispName="Registro civil"
        Registro_Civil,
        /** Es un consecutivo asignado autom├íticamente en registro en lugar del n├║mero de la identificaci├│n de la persona que hace el tr├ímite, se usa especialmente en tr├ímites de construcci├│n cuando el proyecto est├í a nombre de una Fiducia el cual tiene el mismo n├║mero del banco.
