INTERLIS 2.3;

!!@ technicalContact=mailto:info@arbitrium.com.co
MODEL Captura_ArbiMaps_V1_0 (es)
AT "https://www.arbitrium.com.co"
VERSION "1.0"  // Modelo ArbiMaps personalizado, versi├│n 1.0 // =
  IMPORTS ISO19107_PLANAS_V3_0;

  UNIT

    PesoColombiano [COP] EXTENDS INTERLIS.MONEY;

    Area (ABSTRACT) = (INTERLIS.LENGTH * INTERLIS.LENGTH);

    MetroCuadrado [m2] EXTENDS Captura_ArbiMaps_V1_0.Area = (INTERLIS.m * INTERLIS.m);

    Centrimetro [cm] = 1 / 100 [INTERLIS.m];

  TOPIC Captura_ArbiMaps =
    BASKET OID AS INTERLIS.UUIDOID;
    OID AS INTERLIS.UUIDOID;

    DOMAIN

      ARB_AdjuntoElementoTipo = (
        !!@ ili2db.dispName=Fachada
        Fachada,
        !!@ ili2db.dispName=Acabados
        Acabados,
        !!@ ili2db.dispName=Estructura
        Estructura,
        !!@ ili2db.dispName=Ba├▒os
        Banios,
        !!@ ili2db.dispName=Cocina
        Cocina,
        !!@ ili2db.dispName=Cerchas
        Cerchas,
        !!@ ili2db.dispName="Unidad No Convencional"
        Unidad_No_Convencional,
        !!@ ili2db.dispName=Lote
        Lote,
        !!@ ili2db.dispName=Otro
        Otro
      );

      ARB_AnexoTipo = (
        !!@ ili2db.dispName="Ramadas o cobertizos o caneyes"
        Ramadas_Cobertizos_Caneyes(
          /** Ramada construida con materiales no tradicionales, sin cimentaci├│n ni cerramientos fijos, - soportes de cubierta en madera o en perfiles met├ílicos, (tubos con concreto), cubierta sencilla tipo paja, o tejas de zinc, sobre palos de madera o perfil met├ílicos, piso en tierra. Vida ├║til: 15 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: (Sin cimentaci├│n), soportes de cubierta con madera y perfiles met├ílicos
           * Muros: No presenta
           * Cubierta: Tejas de zinc, madera o paja
           * Fachada: No presenta - (muros).
           * Pisos: En tierra pisada.
           */
          !!@ ili2db.dispName="(Ramadas o cobertizos o caneyes) Sencilla"
          Sencilla_Tipo_40,
          /** Ramada construida con materiales no tradicionales, soportes de cubierta en madera, perfiles met├ílicos y tubos con concreto, cubierta sencilla en laminas galvanizadas o en acero, tejas de zinc, teja de fibrocemento, sobre estructura met├ílica o madera rolliza o tipo durmiente, piso en tierra-cemento, o gravilla compactada, o cemento pobre afinado. Vida ├║til: 30 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: (Sin cimentaci├│n), soportes de cubierta con madera y perfiles met├ílicos
           * Muros: No presenta
           * Cubierta: Laminas galvanizadas o en acero, tejas de zinc, teja de fibrocemento, soportado sobre estructura met├ílica o madera rolliza/durmiente
           * Fachada: No presenta - (muros).
           * Pisos: En tierra-cemento o gravilla compactado, - en concreto pobre.
           */
          !!@ ili2db.dispName="(Ramadas o cobertizos o caneyes) Media"
          Media_Tipo_60,
          /** Ramada construida con materiales tradicionales, con cimentaci├│n sencilla mediante dados o zapatas en concreto reforzado, soportes de cubierta sobre cerchas met├ílicas, las cuales se encuentran apoyadas sobre elementos verticales construidos en concreto reforzado o en estructura met├ílica resistente, cubierta sencilla en teja de fibrocemento, arquitect├│nica, met├ílica autoportante y policarbonato y piso afinado en concreto o baldos├¡n. Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: soporte vertical sobre elementos en concreto reforzado (columnas) o elementos en estructura met├ílica
           * Muros: No presenta
           * Cubierta: soporte sobre cerchas met├ílicas en teja de fibrocemento, arquitect├│nica, met├ílica autoportante y policarbonato.
           * Fachada: No presenta - (muros).
           * Pisos: afinado en concreto o baldos├¡n.
           */
          !!@ ili2db.dispName="(Ramadas o cobertizos o caneyes) Plus"
          Plus_Tipo_80
        ),
        /** Unidad construida con destino a la cr├¡a y/o protecci├│n de aves principalmente para explotaci├│n av├¡cola. Conformada por estructura cubierta pisos y muros que son parcialmente elaborados en ladrillo y el resto descubierto o con alg├║n material provisional (pl├ísticos, alambres, etc.).
         */
        !!@ ili2db.dispName="Galpones o gallineros"
        Galpones_Gallineros(
          /** Galp├│n con soporte principal de cubierta en palos de madera com├║n, tubos met├ílicos, o en soportes - tipo columna de concreto artesanal, - todos (Hincados), cerramiento perimetral en polisombra o malla pl├ística hexagonal, o en alambre galvanizado (eslabonada y/o hexagonal), con cerramiento adicional en bloque a 2 y 3 hiladas - (tipo antepecho) - estructura de cubierta en palos de madera com├║n y perfiles met├ílicos, con tejas de zinc y eternit de fibrocemento - piso en tierra. - (hasta - m├íximo 350 m2). Vida ├║til: 30 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: Soportes en estructura de madera com├║n, hierro y pilar de cemento artesanal.
           * Muros: Antepecho con 2 o 3 hiladas en bloque
           * Cubierta: En tejas de zinc (met├ílicos), y en tejas tipo eternit en fibrocemento
           * Cerramiento: Con polisombra, malla hexagonal pl├ística, y en malla en alambre galvanizado.
           * Pisos: En tierra pisada
           */
          !!@ ili2db.dispName="(Galpones o gallineros) Sencillo"
          Sencillo_Tipo_40,
          /** Galp├│n con soporte principal de cubierta en estructura "hincada" de madera tratada aserrada, estructura met├ílica (perfiles y tubos), o pilar de concreto fundido en sitio o prefabricado, cerramiento perimetral en malla de alambre galvanizado (eslabonada y/o hexagonal), con cerramiento perimetral tipo (antepecho) en bloque de 3 a 5 hiladas - estructura de cubierta en madera acerrada o con perfiles met├ílicos, con tejas galvanizadas acanaladas, eternit de fibrocemento y zinc, (puede incluir aislantes t├®rmicos), acabados de piso en cemento afinado liso con acabados en mineral tipo gres - (con ├íreas mayores a 300 m2 y hasta m├íximo 1.000 m2). Vida ├║til: 50 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Ver Diccionario de Datos
           */
          !!@ ili2db.dispName="(Galpones o gallineros) Medio"
          Medio_Tipo_60,
          /** Galp├│n tecnificado de producci├│n especializada, cubierta en estructura met├ílica (perfiles y tubos), sobre dados en concreto o en columnas de concreto sobre zapatas, cerramiento perimetral en malla eslabonada o en laminas met├ílicas galvanizadas y/o con muros en bloque tipo (antepecho) en bloque de 3 a 5 hiladas - estructura de cubierta con cerchas y perfiles met├ílicos, con refuerzos en madera aserrada y guadua, - cuentan con tejas industriales galvanizadas acanaladas y pl├ísticas tipo eternit, acabados de piso en cemento afinado liso con acabados en mineral tipo gres - (aplica para ├íreas grandes y peque├▒as - entre 300 ha m├íximo 2.000 m2)  -se caracteriza por contar con sistemas tecnificados de control de temperatura con equipos de ventilaci├│n y red completa de sistema de iluminaci├│n. Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Ver Diccionario de Datos
           */
          !!@ ili2db.dispName="(Galpones o gallineros) Tecnificado"
          Tecnificado_Tipo_80
        ),
        /** Lugar cubierto donde se encierra ganado o caballos y/o se realizan actividades propias de su explotaci├│n, constituidos por estructura, cubierta, muros y pisos.
         */
        !!@ ili2db.dispName="Establos o pesebreras"
        Establos_Pesebreras(
          /** Establo en estructura sencilla sobre tierra pisada o cemento pobre, con pilares verticales en madera, tubo met├ílico o en Tuvo de PVC, (relleno en concreto), o pilar de concreto artesanal, como soporte de cubierta sencilla en madera con tejas de zinc o en paja.  - Cerramiento parcial en palos de madera artesanal. Vida ├║til: 50 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: Soportes en estructura de madera com├║n, tubos met├ílicos y pilar de cemento artesanal.
           * Muros: No presenta
           * Cubierta: En tejas de zinc (met├ílica), y en tejas tipo eternit en fibrocemento
           * Cerramiento: Cerramiento total o parcial en tablas de madera com├║n.
           */
          !!@ ili2db.dispName="(Establos o pesebreras) Sencillo"
          Sencillo_Tipo_20,
          /** Establo b├ísico, con pisos terminados en cemento afinado o adoqu├¡n, como placa de contrapiso, estructura en columnas de concreto (fundido en sitio o prefabricado), estructura de cubierta en madera o con cerchas met├ílicas y tejas de zinc o laminas galvanizadas acanaladas, cuentan con ├íreas parciales terminadas con muros de bloque y/o ladrillo - y cerramientos en madera tratada inmunizada o en perfiles met├ílicos, - aplican ├íreas acondicionadas para comedero. Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: Soportes en estructura de madera tratada aserrada, met├ílico (perfiles y tubos), o pilar de concreto. - aplica tambi├®n armaz├│n en ladrillo.
           * Muros: Presenta cerramiento parcial en muros de bloque o ladrillo a la vista o en pintura.
           * Cubierta: En tejas de zinc (met├ílicos), tejas tipo eternit en fibrocemento, tejas galvanizadas acanaladas
           * Cerramiento: En madera tratada inmunizada o en perfiles met├ílicos
           * Pisos: En cemento afinado, o adoqu├¡n.
           */
          !!@ ili2db.dispName="(Establos o pesebreras) Medio"
          Medio_Tipo_60,
          /** Establo mas elaborado, tipo exhibici├│n, (modular independiente), - cuenta con pisos en concreto y cemento afinado, o adoqu├¡n en ladrillo, piedra o baldosas de cemento, - estructura vertical en columnas de concreto, o en estructura met├ílica, cubiertas con estructura tipo cerchas o perfiles met├ílicos, acabados con tejas galvanizadas, PVC, o prefabricada de barro, - incluye acabados adicionales de enlucimiento como cielo rasos, redes de iluminaci├│n, puntos hidr├íulicos  - divisiones internas terminadas en muros de bloque, madera tratada o en tubos met├ílicos, con puertas independientes en madera y met├ílicas. Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Ver Diccionario de Datos.
           */
          !!@ ili2db.dispName="(Establos o pesebreras) Tecnificado"
          Tecnificado_Tipo_80
        ),
        /** Construcci├│n destinada a la cr├¡a y albergue de cerdos. Se utiliza cualquiera de los tres nombres enunciados seg├║n la regi├│n donde se ubique; los elementos que la conforman son: estructura, cubierta, muros y pisos.
         */
        !!@ ili2db.dispName="Cocheras o marraneras o porquerizas"
        Cocheras_Marraneras_Porquerizas(
          /** Cochera b├ísica, elaborado de forma artesanal, con pisos en tierra - (tierra cemento/o cemento pobre), muros de antepecho en ladrillo y bloque pintado, con cerramiento en reja de hierro o malla met├ílica. Vida ├║til: 30 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: Estructura en bloque y ladrillo o tubos met├ílicos.
           * Muros: Muros en ladrillo o bloque a media altura - (tipo antepecho).
           * Cubierta: En tejas de zinc, pl├ísticas y en eternit de fibrocemento.
           * Cerramiento: Cuenta con cerramiento en muro o en malla met├ílica, o en tablas.
           * Pisos: En tierra pisada o en tierra-cemento - cemento pobre.
           */
          !!@ ili2db.dispName="(Cocheras o marraneras o porquerizas) Sencilla"
          Sencilla_Tipo_20,
          /** Cochera clasificaci├│n (Medio), con cerramiento perimetral en tablas y/o postes de madera tratada acerrada - inmunizada, (Hincada), con cerramiento en alambrado de 4 y 5 hilos (sencillo o doble) y tablas de madera. - Incluye ├íreas parciales de cubierta en teja de zinc sobre soportes de madera. - Piso en tierra. - puede incluir rampa de carga. Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: En concreto y estructura met├ílica
           * Muros: Muros a media altura terminados en bloque y ladrillo con revestimiento en pa├▒ete.
           * Cubierta: ├üreas parciales con cubierta en teja de zinc y galvanizada, traslapadas con tejas eternit pl├ísticas para iluminaci├│n.
           * Cerramiento: En malla met├ílica, - cada modulo cuenta con reja en hierro.
           * Pisos: En cemento o concreto afinado.
           */
          !!@ ili2db.dispName="(Cocheras o marraneras o porquerizas) Media"
          Media_Tipo_40,
          /** Cocheras o marraneras tecnificadas, con pisos en concreto terminados en cemento afinado, o en adoqu├¡n, cerramiento perimetral terminado en postes de madera tratada inmunizada, con tablas acerradas, o en postes de concreto y tubos met├ílicos, - cuentan con estructura de cubierta en palos de madera inmunizado o en cerchas met├ílicas, empotrados en placa de concreto "contrapiso", cubierta en tejas de zinc y galvanizadas. Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Armaz├│n: Postes en concreto y en estructura met├ílica (perfiles y tubos).
           * Muros: Muros a media altura en bloque y ladrillo con revestimiento, y subdivisiones en estructura met├ílica.
           * Cubierta: En tejas de zinc (met├ílicos), tejas galvanizadas acanaladas, sobre cerchas met├ílicas.
           * Cerramiento: En tablas de madera tratada aserrada inmunizada, con postes en concreto y/o con tubos met├ílicos.
           * Pisos: Concreto afinado, adoqu├¡n en piedra o baldosa de cemento
           */
          !!@ ili2db.dispName="(Cocheras o marraneras o porquerizas) Tecnificada"
          Tecnificada_Tipo_80
        ),
        /** Construcci├│n de grandes dimensiones que sirve para almac├®n o dep├│sito, se except├║an los silos cafeteros (ver beneficiaderos).
         */
        !!@ ili2db.dispName=Silos
        Silos(
          /** Sistemas hidr├íulicos para transportar agua a grandes distancias (de tres o cuatro kil├│metros generalmente), las aguas subterr├íneas son bombeadas a este gran dep├│sito de almacenamiento hasta que queda totalmente lleno.
           * La conducci├│n del l├¡quido se realiza a partir de la columna hidr├íulica generada, por lo general est├í entre los 7 y 8 metros de altura, para ser distribuida por gravedad a bebederos, lotes y casas que se encuentren en un radio de influencia del equipo. Este tipo de estructuras son usuales y muy ├║tiles en el sector rural, para temas ganaderos, av├¡cola, porcicola y almacenamiento. Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas: Estructura en concreto reforzado fabricado en sitio cumpliendo con los requerimientos de dise├▒os de la NSR10, forma cil├¡ndrica, impermeabilizaci├│n interior y exterior, capacidad de almacenamiento de 20.000 Litros (20m3).
           */
          !!@ ili2db.dispName="(Silos) En concreto"
          En_concreto_Tipo_40,
          /** Sistemas hidr├íulicos para transportar agua a grandes distancias (de tres o cuatro kil├│metros generalmente), las aguas subterr├íneas son bombeadas a este gran dep├│sito de almacenamiento hasta que queda totalmente lleno.
           * La conducci├│n del l├¡quido se realiza a partir de la columna hidr├íulica generada, por lo general est├í entre los 7 y 8 metros de altura, para ser distribuida por gravedad a bebederos, lotes y casas que se encuentren en un radio de influencia del equipo. Este tipo de estructuras son usuales y muy ├║tiles en el sector rural, para temas ganaderos, av├¡cola, porcicola y almacenamiento. Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Ver Diccionario de Datos.
           */
          !!@ ili2db.dispName="(Silos) En Acero Galvanizado"
          En_Acero_Galvanizado_Tipo_80
        ),
        /** Estanque artificial con destino al deporte o a la recreaci├│n. Se diferencia por sus acabados y especificaciones t├®cnicas para su mantenimiento y operaci├│n; sus dimensiones deben darse en unidades de ├írea (m2).
         */
        !!@ ili2db.dispName=Piscinas
        Piscinas(
          /** Piscina com├║n de viviendas privadas - com├║n en casas de fincas de campo, enchapadas en cer├ímica, con borde perimetral cubierto en baldos├¡n, piedra o granito. - (incluye equipos hidroneum├íticos) - (├íreas m├íximas de 30 m2). Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas: Estructura de piscina en concreto, ladrillo, recubrimientos en hormig├│n o ladrillo, sobre pisos compactados y limpiados, revestimientos cer├ímicos, estructura perimetral de piso en cemento con acabados, o en adoqu├¡n.
           */
          !!@ ili2db.dispName="(Piscinas) Peque├▒a"
          Pequena_Tipo_40,
          /** Piscina mediana de fincas campestres - y zona rural -  - centros de recreaci├│n, enchapadas en cer├ímica, con bordes en granito, borde perimetral con baldos├¡n, piedra o granito. - (incluye equipos hidroneum├íticos) - (├íreas m├íximas de 60 m2). Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas: Estructura de piscina en concreto, recubrimientos en hormig├│n o ladrillo, sobre pisos compactados y limpiados, revestimientos cer├ímicos, estructura perimetral de piso en cemento con acabados, o en adoqu├¡n.
           */
          !!@ ili2db.dispName="(Piscinas) Mediana"
          Mediana_Tipo_50,
          /** Piscinas semi ol├¡mpicas, con sistemas de purificaci├│n; enchape en azulejo y cer├ímica fina, comunes en clubes y centros de recreativos vacacionales, bordes en granitos, cer├ímicas antideslizantes, gres, con sistemas de desag├╝es perimetrales, - puede incluir cerramientos parciales de seguridad de acceso a piscina. Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Estructura de piscina en concreto, recubrimientos en hormig├│n o ladrillo, sobre pisos compactados y limpiados, revestimientos cer├ímicos, estructura perimetral de piso en cemento con acabados, o en adoqu├¡n.
           */
          !!@ ili2db.dispName="(Piscinas) Grande"
          Grande_Tipo_60,
          /** Piscinas prefabricadas, - modernas - corresponden a estructuras prefabricadas y que para su instalaci├│n se realiza obra civil, como excavaci├│n para empotrar, con adecuaciones de pisos perimetrales como zonas duras en granitos, o baldosa, (Su estructura es en Fibra de Vidrio o en PVC) - (Incluye equipos hidroneum├íticos). Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Prefabricados en Fibra de Vidrio y en PVC. (Aplica si se encuentra empotrada en el terreno).
           */
          !!@ ili2db.dispName="(Piscinas) Prefabricada"
          Prefabricada_Tipo_80
        ),
        /** Dep├│sitos subterr├íneos o de altura, construidos en zonas con deficiencias en abastecimiento de agua para el consumo de los habitantes o para el uso agr├¡cola. El elemento a calificar es la estructura relacionada con la capacidad de almacenamiento medida en metros c├║bicos.
         * 
         * Se excluyen de este tipo de construcci├│n los tanques de almacenamiento domiciliario, los cuales quedan integrados en el avalu├│ de las viviendas.
         */
        !!@ ili2db.dispName=Tanques
        Tanques(
          /** Compuesta de varios elementos estructurales en concreto, sobre la cual se soportan los tanques elevados que generalmente son utilizados en predios de tendencia rural y en ocasiones urbana. Altura promedio de 3 a 4 metros (No incluye el tanque ni acometidas). Capacidad m├íxima de almacenamiento de 1000 litros (1 m3). Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Estructura compuesta b├ísicamente por tres elementos estructurales, uno de cimentaci├│n (zapata), estructura (pila o columna) y soporte (placa elevada); todos estos elementos estructurales en concreto reforzado. (no incluye valor del tanque ni de las acometidas).
           */
          !!@ ili2db.dispName="(Tanques) Soporte elevando sencillo"
          Soporte_Elevado_Sencillo_Tipo_10,
          /** Estructura en materiales convencionales destinadas a almacenamiento de insumos l├¡quidos, generalmente implementadas en viviendas de tendencia rural. capacidad de 1000 Litros (1m3). Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Tanques peque├▒os con altura menor a 3 metros o poca profundidad; estructura en ladrillo tolete com├║n SIN REVESTIR, incluye placa o losa de contrapiso, su dise├▒o es convencional y sencillo. Conservaci├│n regular a mala.
           */
          !!@ ili2db.dispName="(Tanques) Sencillo sin revestir"
          Sencillo_Sin_Revestir_Tipo_20,
          /** Estructura en materiales convencionales destinadas a almacenamiento de insumos l├¡quidos, generalmente implementadas en viviendas de tendencia rural. Capacidad de 1000 Litros (1m3). Vida ├║til: 70 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Tanques peque├▒os con estructura en ladrillo o bloque REVESTIDO en cemento por la totalidad de sus caras, con altura no mayor a 3 metros o poca profundidad,  incluye placa o losa de contrapiso, su dise├▒o es convencional y sencillo. Conservaci├│n buena a regular.
           */
          !!@ ili2db.dispName="(Tanques) Sencillo Revestido"
          Sencillo_Revestido_Tipo_30,
          /** Estructura en hormig├│n destinada a almacenamiento de insumos l├¡quidos, generalmente implementadas en viviendas de tendencia rural y obras de importancia municipal. Capacidad de 2000 a 3000 Litros (2 a 3m3). Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Tanques de mediana capacidad con altura o profundidad no superior a 5 metros; en buen estado de conservaci├│n, estructura en concreto, cuenta con revestimiento en todas sus caras, plantilla en concreto pobre, placa de contrapiso, sistema de ventilaci├│n y tapa en concreto.
           */
          !!@ ili2db.dispName="(Tanques) Medio"
          Medio_Tipo_40,
          /** Estructura en hormig├│n destinada a almacenamiento de insumos l├¡quidos, generalmente implementadas en viviendas de tendencia rural y obras de importancia municipal. Capacidad de 5000 a 7000 Litros (5 a 7 m3). Incluye sistema de ventilaci├│n, acceso e impermeabilizaci├│n. Vida ├║til: 100 a├▒os.
           * 
           * Especificaciones Constructivas:
           * Tanques de alta capacidad con altura o profundidad no superior a 10 metros; en buen estado de conservaci├│n, estructura en concreto, cuenta con impermeabilizaci├│n, revestimiento y acabados en todas sus caras, plantilla en concreto pobre, placa de contrapiso, sistema de ventilaci├│n, estructura met├ílica de acceso y salida y tapa en concreto.
           */
          !!@ ili2db.dispName="(Tanques) Plus"
          Plus_Tipo_50,
          /** Compuesta de varios elementos estructurales en concreto, sobre la cual se soportan los tanques elevados que generalmente son utilizados en predios de tendencia rural y en ocasiones urbana. Altura promedio de 4 a 5 metros (Incluye el tanque en concreto y acometidas). Capacidad de almacenamiento m├íxima de 3000 litros (3 m3). Vida ├║til: 100 a├▒os.
           * 
