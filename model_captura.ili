          !!@ ili2db.dispName=Toboganes
          Toboganes,
          /** Edificio en forma de torre, en cuya cima se sit├║a una sala de control, desde la que se dirige y controla el tr├ífico de un puerto, de un aeropuerto o de un circuito de carreras.
           */
          !!@ ili2db.dispName="Torre de control"
          Torre_de_Control,
          /** Son estructuras dise├▒adas para disminuir la temperatura del agua y otros medios.
