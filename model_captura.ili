          !!@ ili2db.dispName="(Fuente) Otro documento fuente"
          Otro_Documento_fuente,
          /** El documento privado es aquel documento que no cumple los requisitos del documento p├║blico, es decir, es un documento que no ha sido elaborado por un funcionario p├║blico, ni ha habido intervenci├│n de ├®ste para su elaboraci├│n.
           */
          !!@ ili2db.dispName="(Fuente) Documento privado"
          Documento_Privado
        ),
        /** Documentos que son fuente informativa intercultural en relaci├│n con la propiedad
