          !!@ ili2db.dispName="Galpones - Gallineros"
          Galpones_Gallineros,
          /** Construcci├│n en materiales livianos soportados sobre una base s├│lida anclada al piso, para uso temporal de vivienda (recreativa o de esparcimiento), generalmente aislada de otro tipo de construcciones
           */
          !!@ ili2db.dispName=Glamping
          Glamping,
          /** Espacio destinado para el almacenamiento y disposici├│n de aeronaves.
           */
          !!@ ili2db.dispName=Hangar
          Hangar,
          /** Construcci├│n consistente en una cubierta apoyada en columnas de materiales diferentes, elaborados con el fin de guarecer de la intemperie.
           */
          !!@ ili2db.dispName=Kioscos
          Kioscos,
          /** Son dep├│sitos construidos mediante la excavaci├│n y compactaci├│n de la tierra que almacenan agua de cualquier calidad por un periodo determinado
           */
          !!@ ili2db.dispName="Lagunas de oxidaci├│n"
          Lagunas_de_Oxidacion,
          /** Cobertizo dentro de una edificaci├│n de mayor extensi├│n o patio cubierto, clasificados seg├║n su estructura, pisos y el material de la cubierta.
           */
          !!@ ili2db.dispName="Marquesinas - Patios cubiertos"
          Marquesinas_Patios_Cubiertos,
          /** Deber├ín diferenciarse de acuerdo a su estructura, longitud, capacidad, usos tur├¡sticos o de carga
           */
          !!@ ili2db.dispName=Muelles
          Muelles,
          /** Se denomina muralla a un muro cerrado destinado a la protecci├│n y defensa de determinado sitio.
           */
          !!@ ili2db.dispName=Murallas
          Murallas,
          /** Las p├®rgolas son estructuras compuestas por columnas y una armaz├│n superior, cubiertas con mucho follaje o toldo especial que protegen de la lluvia y el sol, tambi├®n usadas como elemento decorativo en un espacio de las viviendas.
           */
          !!@ ili2db.dispName=P├®rgolas
          Pergolas,
          /** Estanque artificial con destino al deporte o a la recreaci├│n.  Se diferencia por sus acabados y especificaciones t├®cnicas para su mantenimiento y operaci├│n; sus dimensiones deben darse en unidades de ├írea (m2).
           */
          !!@ ili2db.dispName=Piscinas
          Piscinas,
          /** Edificaci├│n sin cubierta con que se identifican las pistas de los aeropuertos construidas en asfalto o concreto, incluye la zona o calle de redaje y calles de salida r├ípida.
           */
          !!@ ili2db.dispName="Pista aeropuerto"
          Pista_Aeropuerto,
          /** Perforaciones profundas  manuales para extraer agua subterr├ínea.  Medida en metros de profundidad.
           */
          !!@ ili2db.dispName=Pozos
          Pozos,
          /** Consiste en un sitio cubierto elaborado con el fin de resguardar de la intemperie; el nombre de enramadas, cobertizos o caney se utiliza seg├║n la forma de la cubierta y la regi├│n donde se ubique.
           */
          !!@ ili2db.dispName="Ramadas - Cobertizos - Caneyes"
          Ramadas_Cobertizos_Caneyes,
          /** Construcciones elaboradas con el objeto de secar en condiciones naturales el caf├® principalmente, aunque es com├║n su uso en otros productos.  Consta de estructura y pisos para su calificaci├│n
           */
          !!@ ili2db.dispName=Secaderos
          Secaderos,
