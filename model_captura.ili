      ARB_MobiliarioBanioTipo = (
        /** Cuenta con uno o m├íximo dos servicios entre lavamanos retrete y ducha; los porcelanizados, en caso de tenerlos, son muy econ├│micos; exceptuando los gabinetes peque├▒os de lat├│n, no tiene ning├║n otro mobiliario ni divisiones.
         */
        !!@ ili2db.dispName="(Mobiliario de ba├▒o) Pobre"
        Pobre,
        /** Esta categor├¡a de ba├▒os cuenta con tres servicios. Los porcenalizados de esta categor├¡a son del tipo standard, se encuentran gabinetes muy sencillos y en lat├│n y ocasionalmente peque├▒os armarios en madera burda o metal.
         */
        !!@ ili2db.dispName="(Mobiliario de ba├▒o) Sencillo"
        Sencillo,
        /** Tiene m├¡nimo tres servicios pero de tipo econ├│mico. Tienen gabinetes de regular tama├▒o, algunas veces empotrados, lavamanos con mueble o pedestal y divisi├│n de la ducha.
         */
        !!@ ili2db.dispName="(Mobiliario de ba├▒o) Regular"
        Regular,
        /** Cuenta como m├¡nimo con cuatro servicios, los porcenalizados son finos, en colores, con pedestales, adornos y grifer├¡a fina, tina, planchas de lavamanos generalmente en m├írmol con muebles en madera trabajada de tama├▒os regulares a grandes, con espejos m├ís o menos grandes con luz integrada, la tina forma parte de la ducha, en el mismo espacio.
         * 
         * Tambi├®n se encuentran peque├▒os armarios y gabinetes auxiliares en madera o acr├¡lico, empotrados o sobrepuestos. Normalmente presentan divisi├│n de la ducha, construida en aluminio y cristalita.
         */
        !!@ ili2db.dispName="(Mobiliario de ba├▒o) Bueno"
        Bueno,
        /** Presentan m├¡nimo cuatro servicios b├ísicos, a los cuales corresponde porcenalizados y grifer├¡a de los m├ís finos; a veces presenta tambi├®n servicios extras como saunas o turcos con acondicionamientos especiales; en general tienen gabinetes finos en madera, con auxiliares para el lavamanos especiales, donde todos los servicios tienen su propio espacio dise├▒ado.  Poseen tambi├®n closets grandes y vestiers, divisiones y puertas en materiales finos, todo debidamente alfombrado o con cer├ímica en el piso.
         */
        !!@ ili2db.dispName="(Mobiliario de ba├▒o) Lujoso"
        Lujoso
      );

      ARB_MobiliarioCocinaTipo = (
        /** Se caracteriza por la escasez de mobiliario, se encuentran mesas y alacenas en madera burda o de materiales muy baratos.  En el mejor de los casos se encuentra un tabl├│n o un planchon de cemento r├║stico que en oportunidades lleva empotrado un lavaplatos de lat├│n con grifer├¡a barata y entrepisos en madera burda para guardar los elementos de cocina.
         */
        !!@ ili2db.dispName="(Mobiliario de cocina) Pobre"
        Pobre,
        /** El mobiliario de una cocina es sencillo cuando cuenta con los elementos m├¡nimos necesarios para hacerla funcional, con un cierto grado de comodidad.  Tiene por ejemplo un planch├│n de cemento o su equivalente, que complementa el fregadero o lavaplatos y casi siempre va enchapado en baldos├¡n econ├│mico y con entrepa├▒os de la misma estructura y material; a veces tienen puertas; la grifer├¡a es de tipo standard.  En ocasiones se encuentran muebles secundarios como mesas o alacenas en maderas burdas.
         */
        !!@ ili2db.dispName="(Mobiliario de cocina) Sencillo"
        Sencillo,
        /** Cuenta con gabinetes inferiores o superiores construidos en metal o madera; la grifer├¡a es standard, mes├│n en acero inoxidable.
         */
        !!@ ili2db.dispName="(Mobiliario de cocina) Regular"
        Regular,
        /** Lo encontramos en aquellas cocinas dotadas de gabinetes completos, inferiores y de pared en madera trabajada, planchan en metal inoxidable, normalmente con cocina integral; sistemas auxiliares de extracci├│n y aireaci├│n.
         */
        !!@ ili2db.dispName="(Mobiliario de cocina) Bueno"
        Bueno,
        /** Lo encontramos en aquellas cocinas dotadas de gabinetes completos, inferiores y de pared en madera trabajada, planchan en metal inoxidable, normalmente con cocina integral; sistemas auxiliares de extracci├│n y aireaci├│n. Se encuentran trabajos en maderas finas y compactadores o trituradores de basura, muebles totalmente integrales cubriendo buena parte de los muros, donde el comedor auxiliar es parte de este mobiliario.  Su tama├▒o siempre es grande.
