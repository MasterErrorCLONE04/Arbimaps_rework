      );

      ARB_FachadaTipo = (
        /** Puerta: Fabricada con materiales como: Maderas burdas, l├ímina de zinc, lata o latones carecen por completo de lujos.
         * 
         * Ventanas: En la gran mayor├¡a de casos son peque├▒as, en madera burda o ├íngulo de hierro sencillo.
         * 
         * Cubrimiento del muro: Generalmente los muros no tienen cubrimiento, se presentan con ladrillo corrientes o bloque a la vista y en algunos casos pintura de cal o carburo directamente sobre el ladrillo, y en ocasiones pa├▒ete sin pintar o con pinturas muy econ├│micas.
         */
        !!@ ili2db.dispName="(Fachada) Pobre"
        Pobre,
        /** Puerta: En maderas sin trabajar o l├íminas met├ílicas sin ornamentaci├│n
         * 
