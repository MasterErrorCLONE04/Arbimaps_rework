    !!@ ili2db.dispName="(ARB) Adjunto Unidad de Construcci├│n"
    STRUCTURE ARB_AdjuntoUnidadConstruccionValor =
      !!@ ili2db.dispName="Tipo de elemento"
      Tipo_Elemento : MANDATORY ARB_AdjuntoElementoTipo;
      !!@ ili2db.dispName=NPN
      npn : TEXT*30;
      !!@ ili2db.dispName=Archivo
      Archivo : TEXT;
      !!@ ili2db.dispName=Observaci├│n
      Observacion : MTEXT;
    END ARB_AdjuntoUnidadConstruccionValor;

    /** Clase que permite agrupar las unidades de construcci├│n por identificador, uso y tipolog├¡a.
     */
    !!@ ili2db.dispName="(ARB) Caracter├¡sticas de la unidad de construcci├│n"
    CLASS ARB_CaracteristicasUnidadConstruccion =
      /** Identificador de la unidad de construcci├│n, su codificaci├│n puede ser por letras del abecedario.
       */
      !!@ ili2db.dispName=Identificador
      Identificador : MANDATORY TEXT*20;
      /** Es el conjunto de elementos constructivos que conforman una edificaci├│n y que de acuerdo a sus caracter├¡sticas pueden ser consideradas convencionales cuando son de uso residencial, comercial e industrial o no convencionales cuando son anexos de la construcci├│n.
       */
      !!@ ili2db.dispName="Tipo de unidad de construcci├│n"
      Tipo_Unidad_Construccion : MANDATORY ARB_UnidadConstruccionTipo;
      !!@ ili2db.dispName="Tipo de calificaci├│n"
      Tipo_Calificacion : MANDATORY ARB_CalificacionTipo;
      !!@ ili2db.dispName="ID Grupo (NPN)"
      ID_Grupo : MANDATORY TEXT*50;
      /** N├║mero total de plantas en la unidad de construcci├│n.
       */
      !!@ ili2db.dispName="Total de plantas"
      Total_Plantas : 0 .. 150;
      /** Destinaci├│n de los materiales de una unidad constructiva con respecto a la actividad econ├│mica desarrollada en la edificaci├│n del predio.
       */
      !!@ ili2db.dispName=Uso
      Uso : ARB_UsoUConsTipo;
      /** A├▒o de construcci├│n de la unidad de construcci├│n.
       */
      !!@ ili2db.dispName="A├▒o de construcci├│n"
      Anio_Construccion : 1512 .. 2500;
      /** ├ürea total construida en la unidad de construcci├│n.
       */
      !!@ ili2db.dispName="├ürea construida"
      Area_Construida : 0.0 .. 99999999999999.9 [Captura_ArbiMaps_V1_0.m2];
      /** ├ürea total privada de la unidad de construcci├│n para los predios en r├®gimen de propiedad horizontal.
       */
      !!@ ili2db.dispName="├ürea privada construida"
      Area_Privada_Construida : 0.0 .. 99999999999999.9 [Captura_ArbiMaps_V1_0.m2];
      /** Observaciones generales respecto de la unidad de construcci├│n.
       */
      !!@ ili2db.dispName=Observaciones
      Observaciones : MTEXT;
      /** Identifica la relevancia tradicional y cultural de las unidades de construcci├│n en predios de territorios y territorialidades ind├¡genas
       */
      !!@ ili2db.dispName="Usos Tradicionales Culturales"
      Usos_Tradicionales_Culturales : ARB_UsosTradicionalesCulturalesTipo;
      !!@ ili2db.dispName="Tipo de anexo"
      CNC_Tipo_Anexo : ARB_AnexoTipo;
      /** Estado de conservaci├│n de tipolog├¡a de construcci├│n.
       */
      !!@ ili2db.dispName="Conservacion anexo"
      CNC_Conservacion_Anexo : ARB_EstadoConservacionTipologiaTipo;
      !!@ ili2db.dispName="Tipo tipolog├¡a"
      CT_Tipo_Tipologia : ARB_TipologiaTipo;
      !!@ ili2db.dispName="Conservaci├│n de tipolog├¡a"
      CT_Conservacion_Tipologia : ARB_EstadoConservacionTipologiaTipo;
      /** Indica si la calificaci├│n de construcci├│n corresponde a residencial, comercial o industrial.
       */
      !!@ ili2db.dispName="Tipo a calificar"
      CC_Tipo_Calificar : ARB_CalificarTipo;
      /** Se refiere al conjunto compuesto por los cimientos, columnas, vigas, entrepisos y dem├ís componentes del esqueleto o armadura que soportan las cargas y sostienen la edificaci├│n.  El adobe, bahareque, tapia, calif├¡quelos con el puntaje correspondiente a madera.  En el caso de tener muros de carga en ladrillo, calif├¡quelos como armaz├│n de ladrillo.  En aquellas viviendas de hasta tres pisos y en donde se observe, vigas, columnas y planchas se colocan en la opci├│n ÔÇ£concreto hasta tres pisosÔÇØ.  La m├íxima calificaci├│n ser├í para edificaciones de concreto de 4 o m├ís pisos.
       */
      !!@ ili2db.dispName=Armaz├│n
      CC_Armazon : ARB_ArmazonTipo;
      /** Se refiere a los muros divisorios no considerados como parte del armaz├│n.
       */
      !!@ ili2db.dispName=Muros
      CC_Muros : ARB_MurosTipo;
      /** Techo exterior o tejado de la edificaci├│n.
       */
      !!@ ili2db.dispName=Cubierta
      CC_Cubierta : ARB_CubiertaTipo;
      /** CC_Conservacion_Estructura
       */
      !!@ ili2db.dispName="Conservaci├│n de estructura"
      CC_Conservacion_Estructura : ARB_EstadoConservacionTipo;
      /** Nombrase como tal al conjunto de elementos que constituyen el frente o parte exterior de una construcci├│n, que da cara a la v├¡a o camino, que incluye la puerta de acceso.  Tomada dentro de la variable, acabados principales constituyen un concepto bastante representativo de la calidad de la vivienda.
       */
      !!@ ili2db.dispName=Fachada
      CC_Fachada : ARB_FachadaTipo;
      /** Se califica de acuerdo al material y seg├║n las opciones que se presentan en el formulario, se tendr├í en cuenta que si aparece por lo menos el 80% en pa├▒ete, se marcar├í este material y si aparece por lo menos un 20% de otro material de los m├ís costosos (granito, madera, m├írmol), se marcar├í este en el formulario.  Si se encuentra por lo menos el 50% sin cubrimiento, se calificar├í como tal.  En caso de encontrarse un cubrimiento no completado en el formulario se asimilar├í, seg├║n el factor, m├ís cercano de los referidos.  El pa├▒ete se refiere al cubrimiento en el cual se emplea solamente arena y cemento; el estuco es el cubrimiento fino sobre pa├▒ete.
       */
      !!@ ili2db.dispName="Cubrimiento de muros"
      CC_Cubrimiento_Muros : ARB_CubrimientoMurosTipo;
      /** En esta componente, se inscribir├í lo referente al material predominante en el piso de la construcci├│n seg├║n las opciones indicadas en el formulario y el m├ís costoso si se encuentra en partes iguales.  Se marcar├í tambi├®n con una X seg├║n la unidad de aval├║o reconocida.
       */
      !!@ ili2db.dispName=Piso
      CC_Piso : ARB_PisoTipo;
      /** Estado de conservaci├│n del grupo calificado.
       */
      !!@ ili2db.dispName="Conservacion de acabados"
      CC_Conservacion_Acabados : ARB_EstadoConservacionTipo;
      /** Corresponde al tama├▒o del ba├▒o existente en la construcci├│n.
       */
      !!@ ili2db.dispName="Tama├▒o de ba├▒o"
      CC_Tamanio_Banio : ARB_TamanioBanioTipo;
      /** Se refiere al cubrimiento de los muros del ba├▒o principal, se calificar├í seg├║n las opciones establecidas en el formulario de reconocimiento, teniendo en cuenta que los materiales y condiciones no contemplados se deben asimilar al m├ís parecido de ellos de acuerdo con el costo.  Marque el material que corresponda al mayor porcentaje o al m├ís costoso si se encuentran por partes iguales.
       */
      !!@ ili2db.dispName="Enchape de ba├▒o"
      CC_Enchape_Banio : ARB_EnchapeBanioTipo;
      /** Conjunto de muebles que hacen parte del ba├▒o.
       */
      !!@ ili2db.dispName="Mobiliario de ba├▒o"
      CC_Mobiliario_Banio : ARB_MobiliarioBanioTipo;
      /** Estado de conservaci├│n del grupo calificado.
       */
      !!@ ili2db.dispName="Conservaci├│n de ba├▒o"
      CC_Conservacion_Banio : ARB_EstadoConservacionTipo;
      !!@ ili2db.dispName="Tama├▒o de cocina"
      CC_Tamanio_Cocina : ARB_TamanioCocinaTipo;
      /** Se refiere al cubrimiento de los muros de la cocina principal, se calificar├í seg├║n las opciones establecidas en el formulario de reconocimiento, teniendo en cuenta que los materiales y condiciones no contemplados se deben asimilar al m├ís parecido de ellos de acuerdo con el costo.  Marque el material que corresponda al mayor porcentaje o al m├ís costoso si se encuentran por partes iguales.
       */
      !!@ ili2db.dispName="Enchape de cocina"
      CC_Enchape_Cocina : ARB_EnchapeCocinaTipo;
      /** Conjunto de muebles que hacen parte de la cocina.
       */
      !!@ ili2db.dispName="Mobiliario de cocina"
      CC_Mobiliario_Cocina : ARB_MobiliarioCocinaTipo;
      /** Estado de conservaci├│n del grupo calificado.
       */
      !!@ ili2db.dispName="Conservaci├│n de cocina"
      CC_Conservacion_Cocina : ARB_EstadoConservacionTipo;
      !!@ ili2db.dispName="Cerchas de complemento industrial"
      CC_Cerchas_Complemento_Industria : ARB_CerchasComplementoIndustriaTipo;
      /** Es la altura de piso a techo de la cercha.
       */
      !!@ ili2db.dispName="Altura de cerchas"
      CC_Altura_Cerchas_Superior_6m : BOOLEAN;
      !!@ ili2db.dispName="Total habitaciones"
      Total_Habitaciones : 0 .. 999;
      !!@ ili2db.dispName="Total banios"
      Total_Banios : 0 .. 999;
      !!@ ili2db.dispName="Total locales"
      Total_Locales : 0 .. 999;
      !!@ ili2db.dispName="Total calificaci├│n"
      CC_Total_Calificacion : 0 .. 999999999;
    END ARB_CaracteristicasUnidadConstruccion;

    /** Clase que registra las instancias de los derechos que un interesado ejerce sobre un predio. Es una especializaci├│n de la clase COL_DRR del propio modelo.
     */
    !!@ ili2db.dispName="(ARB) Derecho Interesado Fuente"
    CLASS ARB_DerechoInteresadoFuente =
      /** Derecho que se ejerce.
