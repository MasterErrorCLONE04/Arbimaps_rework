      ARB_EstadoConservacionTipo = (
        /** Se agrupan en este concepto, aquellas estructuras con el mayor grado de deterioro que se puedan encontrar, en condiciones precarias lo cual las hace pr├ícticamente inhabitables. Generalmente se presenta en construcciones antiguas o con material de muy mala calidad.
         */
        !!@ ili2db.dispName=Malo
        Malo,
        /** En esta categor├¡a, se clasifican aquellas estructuras que tienen algunos da├▒os menores, (agrietamiento de paredes, hundimiento de pisos, etc.) pero que todav├¡a se encuentran en condiciones aceptables, sin peligros eminentes o exigencias imperativa de reparaciones inmediatas. Se presenta con frecuencia en construcciones m├ís o menos antiguas o materiales de regular calidad.
         */
        !!@ ili2db.dispName=Regular
        Regular,
        /** Se calificar├ín como tales, aquellas estructuras, no necesariamente nuevas, que se hallan cumpliendo a cabalidad con la funci├│n para las que fueron construidas, no demuestran deterioro, al menos visibles, y por efectos de uso se encuentran solamente un tanto deslucidas y sus materiales son de buena calidad.
