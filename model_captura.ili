      ARB_GrupoEtnicoTipo = (
        Etnico(
          /** Son el grupo humano que vive de acuerdo con las formas de relaci├│n con el medio natural en el que se asentaron los diferentes grupos abor├¡genes desde antes de la conquista y la han conservado y dinamizado a lo largo de la historia.
           */
          !!@ ili2db.dispName=Ind├¡gena
          Indigena,
          /** El pueblo Rrom o gitano se consolida y fortalece como grupo ├®tnico que hacer parte de la diversidad ├®tnica y cultural de la naci├│n colombiana. Su origen se remonta a m├ís de 1000 a├▒os, proviene del norte de la India y conserva un alto bagaje cultural que lo diferencia de otros pueblos y de la sociedad mayoritaria. En este sentido, cuenta con unos elementos identitarios que los diferencian notablemente de los dem├ís grupos ├®tnicos de la sociedad. S├® es Rrom o gitano por derecho de nacimiento y se lleva la sangre gitana.
           */
          !!@ ili2db.dispName=Rrom
          Rrom,
          /** Es la poblaci├│n nativa de las Islas de San Andr├®s, Providencia Y Santa Catalina descendientes de la uni├│n entre europeos (principalmente ingleses, espa├▒oles y holandeses) y esclavos africanos. Se distinguen por su cultura, lengua (creole), creencias religiosas (iglesia bautista) y pasado hist├│rico similar a los pueblos antillanos como Jamaica y Hait├¡.
           */
          !!@ ili2db.dispName=Raizal
          Raizal,
          /** La comunidad palenquera est├í conformada por los descendientes de los esclavizados que mediante actos de resistencia y de libertad, se refugiaron en los territorios de la Costa Norte de Colombia desde el Siglo XV denominados palenques. Existen 4 Palenques reconocidos: San Basilio de Palenque (Mahates ÔÇô Bol├¡var), San Jos├® de Ur├® (C├│rdoba), Jacobo P├®rez escobar (Magdalena) y La Libertad (Sucre)
           */
          !!@ ili2db.dispName=Palenquero
          Palenquero,
          /** Es el conjunto de familias de ascendencia afrocolombiana que poseen una cultura propia, comparten una historia y tienen sus propias tradiciones y costumbres dentro de la relaci├│n campo-poblado, adem├ís revelan y conservan conciencia de identidad que las distinguen de otros grupos ├®tnicos. Se suele denominar a este grupo humano como negros, morenos, mulatos y afrodescendientes.
           */
          !!@ ili2db.dispName="Negro o afrocolombiano"
          Negro_Afrocolombiano
        ),
        /** No pertenece a ning├║n grupo ├®tnico.
         */
        !!@ ili2db.dispName=Ninguno
        Ninguno
      );

      ARB_InteresadoDocumentoTipo = (
        /** Es un documento emitido por la Registradur├¡a Nacional del Estado Civil para permitir la identificaci├│n personal de los ciudadanos.
         */
        !!@ ili2db.dispName="C├®dula de ciudadan├¡a"
        Cedula_Ciudadania,
        /** Es el documento que cumple los fines de identificaci├│n de los extranjeros en el territorio nacional y su utilizaci├│n deber├í estar acorde con la visa otorgada al extranjero.
         */
        !!@ ili2db.dispName="C├®dula de extranjer├¡a"
        Cedula_Extranjeria,
