    /** Estructura que permite identificar las inconsistencias que puede tener el folio de matr├¡cula inmobiliaria producto de la din├ímica inmobiliaria identificada en el levantamiento catastral.
     */
    !!@ ili2db.dispName="(ARB) Novedad FMI Valor"
    STRUCTURE ARB_NovedadFMIValor =
      /** Es el consecutivo que se asigna a cada oficina de registro de instrumentos p├║blicos.
       */
      !!@ ili2db.dispName="C├│digo ORIP"
      Codigo_ORIP : MANDATORY TEXT*4;
      /** Es el consecutivo que se asigna a cada predio jur├¡dico abierto en la ORIP.
       */
      !!@ ili2db.dispName="N├║mero FMI"
      Numero_FMI : MANDATORY TEXT*80;
      !!@ ili2db.dispName="Tipo Novedad FMI"
      Tipo_Novedad_FMI : MANDATORY ARB_NovedadFMITipo;
    END ARB_NovedadFMIValor;

    /** Estructura que permite identificar las modificaciones que puede tener el n├║mero predial producto de la din├ímica inmobiliaria identificada en el levantamiento catastral.
     */
    !!@ ili2db.dispName="(ARB) Novedad Numero Predial Valor"
    STRUCTURE ARB_NovedadNumeroPredialValor =
      /** El predio no sufre modificaci├│n del c├│digo predial nacional de 30 d├¡gitos de acuerdo con la estructura.
       */
      !!@ ili2db.dispName="N├║mero predial"
      Numero_Predial : MANDATORY TEXT*30;
      /** Indica los diferentes tipos de modificaciones que puede tener el n├║mero predial producto de la din├ímica inmobiliaria identificada en el levantamiento catastral.
       */
      !!@ ili2db.dispName="Tipo de novedad"
      Tipo_Novedad : MANDATORY ARB_NovedadNumeroPredialTipo;
    END ARB_NovedadNumeroPredialValor;

    /** Corresponde a la exactitud horizontal del punto
     */
    !!@ ili2db.dispName="(ARB) Punto de Referencia"
    CLASS ARB_PuntoReferencia =
      !!@ ili2db.dispName="Tipo punto de referencia"
      Tipo_Punto_Referencia : MANDATORY ARB_PuntoReferenciaTipo;
      !!@ ili2db.dispName=Observaci├│n
      Observacion : MTEXT;
      /** Adjuntos asociados al punto
       */
      !!@ ili2db.dispName=Adjunto
      Adjunto : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AdjuntoPuntoReferenciaValor;
      /** Geometr├¡a 2D asociada a la localizaci├│n del punto
       */
      !!@ ili2db.dispName=Geometr├¡a
      Geometria : MANDATORY ISO19107_PLANAS_V3_0.GM_Point2D;
    END ARB_PuntoReferencia;

    /** Referencia a una clase externa para gestionar referencias registrales del sistema antiguo.
     */
    !!@ ili2db.dispName="(ARB) Referencia Registral del Sistema Antiguo Valor"
    STRUCTURE ARB_ReferenciaRegistralSistemaAntiguoValor =
      !!@ ili2db.dispName="Tipo de referencia"
      Tipo_Referencia : MANDATORY ARB_ReferenciaTipo;
      /** Nombre de la oficina de registro de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=Oficina
      Oficina : TEXT*50;
      /** N├║mero del libro indicado en el ficha catastral.
       */
      !!@ ili2db.dispName=Libro
      Libro : TEXT*1;
      /** N├║mero del tomo indicado en el ficha catastral.
       */
      !!@ ili2db.dispName=Tomo
      Tomo : TEXT*2;
      /** P├ígina de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=Pagina
      Pagina : TEXT*4;
      /** N├║mero de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=N├║mero
      Numero : TEXT*4;
      /** D├¡a de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=D├¡a
      Dia : TEXT*2;
      /** Mes de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=Mes
      Mes : TEXT*2;
      /** A├▒o de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=A├▒o
      Anio : 1850 .. 2024;
      /** N├║mero de la matr├¡cula de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName=Matr├¡cula
      Matricula : MANDATORY TEXT*20;
    END ARB_ReferenciaRegistralSistemaAntiguoValor;

    /** Porci├│n de tierra con una extensi├│n geogr├ífica definida.
     */
    !!@ ili2db.dispName="(ARB) Terreno"
    CLASS ARB_Terreno =
      !!@ ili2db.dispName=Etiqueta
      Etiqueta : TEXT*255;
      !!@ ili2db.dispName="Relacion superficie"
      Relacion_Superficie : ARB_RelacionSuperficieTerrenoTipo;
      !!@ ili2db.dispName="Estado terreno"
      Estado_Terreno : ARB_EstadoTerrenoTipo;
      !!@ ili2db.dispName=Adjunto
      Adjunto : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AdjuntoTerrenoValor;
      Geometria : ISO19107_PLANAS_V3_0.GM_MultiSurface2D;
    END ARB_Terreno;

    !!@ ili2db.dispName="(ARB) Tramite"
    CLASS ARB_Tramite =
      Entidad : ARB_EntidadTipo;
      Fecha_Radicacion : INTERLIS.XMLDate;
      !!@ ili2db.dispName="Numero de Radicaci├│n"
      Numero_Radicacion : TEXT*20;
      Tramite : ARB_TramiteTipo;
      !!@ ili2db.dispName="┬┐Fue resuelta?"
      Resuelta : BOOLEAN;
      !!@ ili2db.dispName=Observaci├│n
      Observacion : MTEXT;
    END ARB_Tramite;

    /** Clase especializada de BaUnit, que describe la unidad administrativa b├ísica para el caso de Colombia.
     * El predio es la unidad territorial legal propia de Catastro. Est├í formada por el terreno y puede o no tener construcciones asociadas.
     */
    !!@ ili2db.dispName="(ARB) Predio"
    CLASS ARB_Predio =
      /** Identificador ├║nico temporal de cada predio que se asigna en el desarrollo del levantamiento catastral.
       */
      !!@ ili2db.dispName="Identificador ├║nico de operaci├│n"
      Id_Operacion : MANDATORY TEXT*50;
      /** Direcci├│n del predio.
       */
      !!@ ili2db.dispName=Direcci├│n
      Direccion : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_Direccion;
      /** Nuevo C├│digo num├®rico de treinta (30) d├¡gitos, que se le asigna a cada predio y busca localizarlo inequ├¡vocamente en los documentos catastrales, seg├║n el modelo determinado por el Instituto Geogr├ífico Agust├¡n Codazzi.
       */
      !!@ ili2db.dispName="N├║mero predial"
      Numero_Predial : TEXT*30;
      Numero_Predial_Anterior : TEXT*20;
      /** Circulo registral
       */
      !!@ ili2db.dispName="C├│digo ORIP"
      Codigo_ORIP : TEXT*4;
      /** Matricula inmobiliaria
       */
      !!@ ili2db.dispName="Matr├¡cula inmobiliaria"
      Matricula_Inmobiliaria : 1 .. 9999999999;
      !!@ ili2db.dispName="Estado FMI"
      Estado_FMI : ARB_EstadoFMITipo;
      !!@ ili2db.dispName="Fecha apertura FMI"
      Fecha_Apertura_FMI : INTERLIS.XMLDate;
      !!@ ili2db.dispName="Fecha inscripci├â┬│n catastral"
      Fecha_Inscripcion_Catastral : INTERLIS.XMLDate;
      !!@ ili2db.dispName="Vigencia actualizaci├â┬│n"
      Vigencia_Actualizacion : INTERLIS.XMLDate;
      /** Registro asociado a la anotaci├│n en antiguo sistema de registro. (Libros)
       */
      !!@ ili2db.dispName="Referencia registral del sistema antiguo"
      Referencia_Registral_Sistema_Antiguo : Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_ReferenciaRegistralSistemaAntiguoValor;
      !!@ ili2db.dispName="├ürea registral en metros cuadrados"
      Area_Registral_M2 : 0.00 .. 10000000000000000000000.00 [Captura_ArbiMaps_V1_0.m2];
      /** Caracterizaci├│n tem├ítica del predio.
       */
      !!@ ili2db.dispName="Condici├│n del predio"
      Condicion_Predio : ARB_CondicionPredioTipo;
      !!@ ili2db.dispName="Coeficiente de Copropiedad"
      Coeficiente_Copropiedad : 0.0000000000 .. 100.0000000000;
      !!@ ili2db.dispName="Area Coeficiente de Copropiedad"
      Area_Coeficiente_Copropiedad : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];
      /** Es la clasificaci├│n para fines estad├¡sticos que se da a cada inmueble en su conjuntoÔÇôterreno, construcciones o edificaciones-, en el momento de la identificaci├│n predial de conformidad con la actividad predominante que en ├®l se desarrolle.
       */
      !!@ ili2db.dispName="Destinaci├│n econ├│mica"
      Destinacion_Economica : ARB_DestinacionEconomicaTipo;
      !!@ ili2db.dispName="Tipo de predio"
      Tipo : ARB_PredioTipo;
      !!@ ili2db.dispName="Resultado de la visita predial"
      Resultado_Visita : ARB_ResultadoVisitaTipo;
      !!@ ili2db.dispName="Fecha de visita predial"
      Fecha_Visita_Predial : INTERLIS.XMLDate;
      !!@ ili2db.dispName="Tipo de documento de quien atendi├│ la visita predial"
      Tipo_Documento_Quien_Atendio : ARB_InteresadoDocumentoTipo;
      !!@ ili2db.dispName="Numero de documento de quien atendi├│ la visita predial"
      Numero_Documento_Quien_Atendio : TEXT*50;
      /** Nombres y apellidos de la persona encargada de atender la visita de ejecuci├│n de actividades catastrales sobre el predio.
       */
      !!@ ili2db.dispName="Nombres y apellidos de quien atendi├│"
      Nombres_Apellidos_Quien_Atendio : TEXT*150;
      !!@ ili2db.dispName=Celular
      Celular : 0.0 .. 9999999999.0;
      !!@ ili2db.dispName="Correo electr├│nico"
      Correo_Electronico : TEXT*100;
      /** Direcci├│n de domicilio para notificaciones.
       */
      !!@ ili2db.dispName="Domicilio de notificaciones"
      Domicilio_Notificaciones : TEXT*255;
      /** Indica si autoriza las notificaciones administrativas por medio de v├¡a electr├│nica.
       */
      !!@ ili2db.dispName="Autoriza notificaciones"
      Autoriza_Notificaciones : BOOLEAN;
      /** Tipo de novedad asociada al predio
       */
      !!@ ili2db.dispName="Tipo de novedad"
      Novedad_FMI : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_NovedadFMIValor;
      !!@ ili2db.dispName="Novedad n├║mero predial"
      Novedad_Numero_Predial : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_NovedadNumeroPredialValor;
      /** M├®todo de captura del predio.
       */
      !!@ ili2db.dispName="Tipo de captura"
      Tipo_Captura : ARB_MetodoProduccionTipo;
      !!@ ili2db.dispName=Observaciones
      Observaciones : MTEXT;
      /** ├ürea consignada en el certificado de tradici├│n y  libertad, en la descripci├│n de cabida y linderos o en los tit├║los registrados, expresada en metros cuadrados.
       */
      !!@ ili2db.dispName="├ürea catastral del terreno en metros cuadrados"
      Area_Catastral_Terreno : 0.00 .. 1000000000000000000000000.00 [Captura_ArbiMaps_V1_0.m2];
      /** Nombre que recibe la unidad administrativa b├ísica, en muchos casos topon├¡mico, especialmente en terrenos r├║sticos.
       */
      Nombre : TEXT*255;
      /** Identificador ├║nico asociado al predio matriz
       */
      !!@ ili2db.dispName="Predio Matriz"
      Predio_Matriz : TEXT*30;
      /** Predios donde habitan comunidades ind├¡genas que han sido entregados en comodato por entidades territoriales y que, por su uso tradicional se constituyen en espacio de pr├ícticas culturales, materiales y espirituales   de   los pueblos ind├¡genas.
       */
      !!@ ili2db.dispName=Comodato
      Comodato : BOOLEAN;
      /** Las tierras adquiridas por el Instituto Colombiano para la Reforma Agraria (INCORA), Instituto Colombiano de Desarrollo Rural (INCODER), o la Agencia Nacional de Tierras (ANT) en beneficio de comunidades ind├¡genas.
       * Los predios provenientes del Fondo Nacional Agrario entregados y no titulados, y aquellos en proceso de entrega; as├¡ como los relacionados con el Fondo de Tierras del Acuerdo de Paz en beneficio de comunidades ind├¡genas.
       */
      !!@ ili2db.dispName="Beneficio de comunidades indigenas"
      Beneficio_Comunidades_Indigenas : BOOLEAN;
      /** Campo utilizado para realizar el seguimiento de la captura en campo
       */
      !!@ ili2db.dispName="Control de calidad"
      Control_Calidad : MTEXT;
      !!@ ili2db.dispName="┬┐V├ílido control de calidad?"
      Valido_Control_Calidad : BOOLEAN;
      !!@ ili2db.dispName="Cabida y linderos"
      Cabida_Linderos : MTEXT;
      !!@ ili2db.dispName="Observaci├│n jur├¡dica"
      Observacion_Juridica : MTEXT;
      /** El aval├║o consiste en la determinaci├│n del valor de los predios, obtenido mediante investigaci├│n y an├ílisis estad├¡stico del mercado inmobiliario. El aval├║o de cada predio se determinar├í por la adici├│n de los aval├║os parciales practicados independientemente para los terrenos y para las unidades de construcci├│n en ├®l comprendidos. El aval├║o corresponde a un porcentaje adoptado del aval├║o comercial seg├║n el estudio econ├│mico, dichos aval├║os se redondean a miles.
       */
      !!@ ili2db.dispName=Aval├║o
      Avaluo : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AvaluoValor;
      UNIQUE Id_Operacion;
    END ARB_Predio;
    /** Huella de construccion que agrupa multiples unidades de construccion.
     */
    !!@ ili2db.dispName="(ARB) Construccion"
    CLASS ARB_Construccion =
      !!@ ili2db.dispName=Identificador
      Identificador : MANDATORY TEXT*50;
      !!@ ili2db.dispName="Tipo construccion"
      Tipo_Construccion : ARB_TipoConstruccionTipo;
      !!@ ili2db.dispName="Tipo dominio"
      Tipo_Dominio : ARB_TipoDominioConstruccionTipo;
      !!@ ili2db.dispName="Total pisos"
      Total_Pisos : 0 .. 300;
      !!@ ili2db.dispName="Total sotanos"
      Total_Sotanos : 0 .. 100;
      !!@ ili2db.dispName="Total mezaninis"
      Total_Mezaninis : 0 .. 100;
      !!@ ili2db.dispName="Total semisotanos"
      Total_Semisotanos : 0 .. 100;
      !!@ ili2db.dispName="Area total construccion"
      Area_Total_Construccion : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];
      !!@ ili2db.dispName=Etiqueta
      Etiqueta : TEXT*100;
      !!@ ili2db.dispName="Estado construccion"
      Estado_Construccion : ARB_EstadoConstruccionTipo;
      !!@ ili2db.dispName=Observacion
      Observacion : MTEXT;
      Geometria : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface2D;
    END ARB_Construccion;

    /** Es cada conjunto de materiales consolidados dentro de un predio que tiene unas caracter├¡sticas espec├¡ficas en cuanto a elementos constitutivos f├¡sicos y usos de la misma.
     */
    !!@ ili2db.dispName="(ARB) Unidad de construcci├│n"
    CLASS ARB_UnidadConstruccion =
      !!@ ili2db.dispName="Tipo de planta"
      Tipo_Planta : MANDATORY ARB_ConstruccionPlantaTipo;
      !!@ ili2db.dispName="Planta ubicaci├│n"
      Planta_Ubicacion : MANDATORY 1 .. 300;
      /** Altura total de la unidad de construcci├│n.
       */
      !!@ ili2db.dispName=Altura
      Altura : 0.000 .. 1000.000 [INTERLIS.m];
      !!@ ili2db.dispName=Etiqueta
      Etiqueta : TEXT*100;
      !!@ ili2db.dispName="Relacion superficie"
      Relacion_Superficie : ARB_RelacionSuperficieConstruccionTipo;
      !!@ ili2db.dispName="Estado unidad construccion"
      Estado_Unidad_Construccion : ARB_EstadoConstruccionTipo;
      !!@ ili2db.dispName=Identificador
      Identificador : TEXT*50;
      !!@ ili2db.dispName=Adjunto
      Adjunto : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AdjuntoUnidadConstruccionValor;
      /** Observaciones generales respecto de la unidad de construcci├│n.
       */
      !!@ ili2db.dispName=Observaciones
      Observaciones : MTEXT;
      Geometria : ISO19107_PLANAS_V3_0.GM_MultiSurface2D;
    END ARB_UnidadConstruccion;

    ASSOCIATION arb_predio_derecho =
      derecho -- {0..*} ARB_DerechoInteresadoFuente;
      predio -- {1} ARB_Predio;
    END arb_predio_derecho;

    ASSOCIATION arb_predio_informacionph =
      arb_predio -- {1} ARB_Predio;
      arb_informacionph -- {0..1} ARB_InformacionPH;
    END arb_predio_informacionph;

    ASSOCIATION arb_predio_marca =
      predio -- {1} ARB_Predio;
      marca -- {0..*} ARB_Marca;
    END arb_predio_marca;

    ASSOCIATION arb_predio_puntoreferencia =
      predio -- {1} ARB_Predio;
      punto_referencia -- {0..*} ARB_PuntoReferencia;
    END arb_predio_puntoreferencia;

    ASSOCIATION arb_predio_terreno =
      predio -- {1} ARB_Predio;
      terreno -- {0..*} ARB_Terreno;
    END arb_predio_terreno;

    ASSOCIATION arb_predio_terrenohistorico =
      predio -- {1} ARB_Predio;
      terreno_historico -- {0..*} ARB_TerrenoHistorico;
    END arb_predio_terrenohistorico;

    ASSOCIATION arb_predio_tramite =
      predio -- {1} ARB_Predio;
      tramite -- {0..*} ARB_Tramite;
    END arb_predio_tramite;
    ASSOCIATION arb_predio_construccion =
      predio -- {1} ARB_Predio;
      construccion -- {0..*} ARB_Construccion;
    END arb_predio_construccion;

    ASSOCIATION arb_construccion_unidadconstruccion =
      construccion -- {1} ARB_Construccion;
      unidad_construccion -- {0..*} ARB_UnidadConstruccion;
    END arb_construccion_unidadconstruccion;

    ASSOCIATION unidadconstruccion_caracteristicasunidadconstruccion =
      caracteristicasunidadconstruccion -- {0..1} ARB_CaracteristicasUnidadConstruccion;
      unidadconstruccion -- {0..*} ARB_UnidadConstruccion;
    END unidadconstruccion_caracteristicasunidadconstruccion;

  END Captura_ArbiMaps;

END Captura_ArbiMaps_V1_0.


