      /** Relaciona todas aquellas diferencias e inexactitudes relativas al registro de los predios respecto de la informaci├│n juridica vigente.
       */
      ARB_NovedadFMITipo = (
        /** Cuando el estado del FMI del predio en estudio es CERRADO ante la SNR, pero pese a haberse realizado varios negocios jur├¡dicos sobre un predio (ventas, donaciones, segregaciones, etc.) se identifica que este posee un ├írea de remanente, lo que le permite continuar con su existencia jur├¡dica y su estado debe cambiar a ABIERTO.
         */
        !!@ ili2db.dispName="FMI debe estar abierto"
        FMI_Debe_Estar_Abierto,
        /** Cuando el estado del FMI del predio en estudio es ABIERTO ante la SNR, pero el folio ha sido cancelado por orden de autoridad  judicial y/o administrativa, o se agote su ├írea por englobes, desenglobes o cualquier otro negocio jur├¡dico  y su estado debe cambiar a CERRADO.
         */
        !!@ ili2db.dispName="FMI debe estar cerrado"
        FMI_Debe_Estar_Cerrado,
        /** Cuando no exista relaci├│n entre el predio segregado y el que se enuncia.
         */
        !!@ ili2db.dispName="FMI no es segregado del que se enuncia"
        FMI_No_Es_Segregado_Del_Que_Se_Enuncia,
        /** Cuando se ha aperturado dos o mas FMI sobre un mismo predio, en un mismo circulo registral o c├¡rculos registrales diferentes.
         */
        !!@ ili2db.dispName="FMI duplicado sobre el mismo bien inmueble"
        FMI_Duplicado_Sobre_El_Mismo_Bien_Inmueble,
        /** Cuando se presente una inconsistencia en el c├│digo registral con el que se registr├│ el acto jur├¡dico.
         */
        !!@ ili2db.dispName="FMI con error en la identificaci├│n de naturaleza jur├¡dica del acto"
        FMI_Con_Error_En_La_Identificacion_De_Naturaleza_Juridica_Del_Acto,
        /** Cuando se encuentra un titulo inscrito que no corresponde al predio objeto de estudio.
         */
        !!@ ili2db.dispName="T├¡tulo mal inscrito no corresponde al predio"
        Titulo_Mal_Inscrito_No_Corresponde_Al_Predio,
        /** FMI que despu├®s de la intervenci├│n, no fue posible identificar en territorio y no se encuentra relacionado a ning├║n predio del la base catastral resultante de la actualizaci├│n.
         */
        !!@ ili2db.dispName="FMI sin correspondencia catastral"
        FMI_Sin_Correspondencia_Catastral
      );


      /** Estado actual del folio de matr├â┬¡cula inmobiliaria.
       */
      ARB_EstadoFMITipo = (
        !!@ ili2db.dispName=Activo
        Activo,
        !!@ ili2db.dispName=Cerrado
        Cerrado
