      Observacion : MTEXT;
    END ARB_AdjuntoFuenteAdministrativaValor;

    /** Estructura que contiene el aval├║o del predio en la base de datos catastral.
     */
    !!@ ili2db.dispName="(ARB) Avaluo Valor"
    STRUCTURE ARB_AvaluoValor =
      /** Fecha de la vigencia del avaluo catastral.
       */
      !!@ ili2db.dispName="Fecha del aval├║o catastral"
      Fecha_Avaluo_Catastral : MANDATORY INTERLIS.XMLDate;
      /** Es el valor de un predio, resultante de un ejercicio t├®cnico que, en ning├║n caso, podr├í ser inferior al 60% del valor comercial o superar el valor de este ├║ltimo. Para su determinaci├│n no ser├í necesario calcular de manera separada el valor del suelo y el de la construcci├│n.
       */
      !!@ ili2db.dispName="Aval├║o catastral"
      Avaluo_Catastral : MANDATORY Peso;
      /** Es el derecho que tiene el propietario, poseedor u ocupante de predios de presentar antes del 30 de junio de cada a├▒o ante el gestor catastral, la autoestimaci├│n del aval├║o catastral. En los municipios donde no hubiere oficina de catastro o donde el gestor no tenga presencia, su presentaci├│n se har├í ante la Secretar├¡a de Hacienda o quien haga sus veces en el respectivo municipio o a trav├®s de los canales virtuales dispuestos por cada gestor.
       * 
       * Dicha autoestimaci├│n no podr├í ser inferior al aval├║o catastral vigente y se incorporar├í al catastro con fecha 31 de diciembre del a├▒o en el cual se haya efectuado, si el gestor catastral la encuentra justificada mediante las pruebas que aporte de las mutaciones f├¡sicas, valorizaci├│n, cambios de uso o mercado inmobiliario.
       * 
       * La autoestimaci├│n aqu├¡ definida se refiere a las disposiciones contenidas en la Ley 14 de 1983.
       */
      !!@ ili2db.dispName=Autoestimaci├│n
      Autoestimacion : MANDATORY BOOLEAN;
      /** Este valor es el derivado de los procesos de formaci├│n y actualizaci├│n de la gesti├│n catastral como el resultado de la investigaci├│n econ├│mica, las normas urban├¡sticas municipales, el an├ílisis del mercado inmobiliario y los costos de la construcci├│n.
       * 
       * El valor comercial corresponde a la suma del valor comercial de las unidades de construcci├│n m├ís el valor comercial total del terreno. Para algunos casos de Propiedad Horizontal PH, se obtiene un valor integral. Este valor debe ser mayor a cero (0).
       * 
       * Este valor comercial permanecer├í asociado para todos los predios p├║blicos y privados en la base de datos catastral, hasta que se realice un posterior proceso catastral que lo modifique.
       */
      !!@ ili2db.dispName="Aval├║o comercial"
      Valor_Comercial : Peso;
      /** Este valor es el derivado de los procesos de formaci├│n y actualizaci├│n de la gesti├│n catastral y es resultado de la investigaci├│n econ├│mica, las normas urban├¡sticas municipales y el an├ílisis del mercado inmobiliario.
       */
      !!@ ili2db.dispName="Aval├║o comercial terreno"
      Valor_Comercial_Terreno : Peso;
      /** Es el valor del terreno, resultante de un ejercicio t├®cnico que, en ning├║n caso, podr├í ser inferior al 60% del valor comercial del terreno o superar el valor de este ├║ltimo.
       */
      !!@ ili2db.dispName="Aval├║o catastral del terreno"
      Avaluo_Catastral_Terreno : Peso;
      /** Este valor es el derivado de los procesos de formaci├│n y actualizaci├│n de la gesti├│n catastral y es resultado de la investigaci├│n econ├│mica, las normas urban├¡sticas municipales y el an├ílisis del mercado inmobiliario de la suma total de las unidades de construcci├│n.
       */
      !!@ ili2db.dispName="Valor comercial total de las unidades de construcci├│n"
      Valor_Comercial_Total_Unidades_Construccion : Peso;
      /** Es el valor de la suma total de las unidades de construcci├│n, resultante de un ejercicio t├®cnico que, en ning├║n caso, podr├í ser inferior al 60% del valor comercial de la suma total de las unidades de construcci├│n o superar el valor de este ├║ltimo.
       */
      Avaluo_Catastral_Total_Unidades_Construccion : Peso;
    END ARB_AvaluoValor;

