          !!@ ili2db.dispName="Establos - Pesebreras - Caballerizas"
          Establos_Pesebreras_Caballerizas,
          /** Son obras arquitect├│nicas  que se construyen con el objeto de elevar el nivel del agua de la fuente de riego a los sitios donde se desea utilizar.
