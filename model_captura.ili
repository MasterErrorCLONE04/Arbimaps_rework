          !!@ ili2db.dispName="Albercas - Ba├▒aderas"
          Albercas_Banaderas,
          /** Nombre dado en zonas cafeteras a aquellas construcciones donde realizan el beneficio del caf├®. Consiste en ├íreas cubiertas dentro de las cuales se encuentran los elementos destinados a la labor de seleccionar, lavar y despulpar el grano y su posterior empaque
           */
          !!@ ili2db.dispName=Beneficiaderos
          Beneficiaderos,
          /** Construcci├│n para el desarrollo de proyectos acu├¡colas del cultivo de camarones.
