# API Configuration
APP_NAME="ArbitriumSAS API"
APP_VERSION="0.1.0"
STATIC_URL="/static"

# Database Configuration
# If using the host database from WSL, use 'host.docker.internal' or the host IP
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=Arbitrium2026*
DB_SSLMODE=prefer

# Box Configuration
BOX_AUTH_MODE=jwt
BOX_CONFIG_FILE=/app/box_config.json
BOX_TOKENS_FILE=/app/tokens/box_oauth_tokens.json

# Other Configuration
ASIG_RUNTIME_DDL=1
ASIG_WORKSPACE_STALE_MINUTES=20

# ili2pg Configuration (INTERLIS import/export)
ILI2PG_JAR=/opt/ili2pg/ili2pg-5.1.0.jar
ILI2PG_TIMEOUT_SEC=1800

# ilivalidator Configuration (XTF/ITF validation)
ILIVALIDATOR_JAR=/opt/ilivalidator/ilivalidator-1.14.1.jar
ILIVALIDATOR_LIB_DIR=/opt/ilivalidator/libs
