        !!@ ili2db.dispName = "(Comercial) Teatro - Cinemas"
        Teatro_Cinemas,
        /** Establecimiento destinado a la proyección de películas cinematográficas sometida o la presentación de obras artísticas actores o musicales en un predio sometido en régimen de propiedad horizontal.
