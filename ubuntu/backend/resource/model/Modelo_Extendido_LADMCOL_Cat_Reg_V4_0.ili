        !!@ ili2db.dispName = "(Institucional) Clínicas, hospitales, centros médicos"
        Clinicas_Hospitales_Centros_Medicos,
        /** Institución edificada destinada a la enseñanza primaria, secundaria y universitaria
         */
        !!@ ili2db.dispName = "(Institucional) Colegios y universidades"
        Colegio_y_Universidades,
        /** Teatro o edificio destinado a espectáculos con capacidad para un gran número de personas.
         */
        !!@ ili2db.dispName = "(Institucional) Coliseos"
        Coliseos,
        /** Institución edificada construcción con características arquitectónicas coloniales destinada a la enseñanza primaria
         */
        !!@ ili2db.dispName = "(Institucional) Entidad educativa colonial colegio colonial"
        Entidad_Educativa_Colonial_Colegio_Colonial,
        /** Un estadio es una construcción cerrada con graderías para los espectadores, destinado a competiciones deportivas. Puede ser al aire libre o cubierto.
         */
        !!@ ili2db.dispName = "(Institucional) Estadios"
        Estadios,
        /** Lugar construido  fuerte, cercado de murallas, baluartes, fosos y otras fortificaciones.
         */
        !!@ ili2db.dispName = "(Institucional) Fuertes y Castillos"
        Fuertes_y_Castillos,
        /** Edificación en la que se reúnen y consagran a los fieles que le rinden culto a un ser superior.
         */
        !!@ ili2db.dispName = "(Institucional) Iglesia"
        Iglesia,
        /** Edificación en la que se reúnen y consagran a los fieles que le rinden culto a un ser superior sometido a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Institucional) Iglesia en PH"
        Iglesia_en_PH,
        /** Construcciones adaptadas o utilizadas por los organismos de seguridad de una nación para acuartelar a las tropas y sus equipos. Estas son organizadas de una forma tal que les facilite cumplir con la rutina diaria de los cuerpos militares, desde dormitorios, patios de ejercicios, estacionamientos para los vehículos, parques, comedores, oficinas y son fortificadas a fin de presentar resistencia al momento de un posible ataque externo.
         */
        !!@ ili2db.dispName = "(Institucional) Instalaciones militares"
        Instalaciones_Militares,
        /** Construcción con características de una vivienda que se encarga de brindar educación y asistencia integral a los niños.
         */
        !!@ ili2db.dispName = "(Institucional) Jardín infantil en casa"
        Jardin_Infantil_en_Casa,
        /** Es un terreno que está destinado a árboles, jardines y prados donde se depositan los restos mortales o cadáveres.
         */
        !!@ ili2db.dispName = "(Institucional) Parque Cementerio"
        Parque_Cementerio,
        /** Centro cultural donde se realizan presentaciones astronómicas al público en general.
         */
        !!@ ili2db.dispName = "(Institucional) Planetario"
        Planetario,
        /** Son recintos cerrados, generalmente circulares y descubiertos, donde se celebran las corridas de toros.
         */
        !!@ ili2db.dispName = "(Institucional) Plaza de toros"
        Plaza_de_Toros,
        /** Edificio donde se atiende a la población en un primer nivel asistencial sanitario.
         */
        !!@ ili2db.dispName = "(Institucional) Puestos de salud"
        Puestos_de_Salud,
        /** Construcciones, oficiales o privadas, destinadas a salvaguardar obras de arte, reliquias o antigüedades de carácter histórico, religioso o científico, que representan un periodo, una época de la humanidad o del país.
         */
        !!@ ili2db.dispName = "(Institucional) Museos"
        Museos,
        /** Edificación donde habitan congregaciones religiosas de distintas órdenes menticantes en el itinerario de formación o consagración religiosa.
         */
        !!@ ili2db.dispName = "(Institucional) Seminarios, conventos"
        Seminarios_Conventos,
        /** Edificio o sala destinados a la representación de obras de teatro o de otro tipo de espectáculos, que dispone de un escenario y gradas o asientos para el público, se caracterizan por sus condiciones arquitectónicas.
         */
        !!@ ili2db.dispName = "(Institucional) Teatro"
        Teatro,
        /** Escenario deportivo destinado a la práctica de distintas disciplinas deportivas.
         */
        !!@ ili2db.dispName = "(Institucional) Unidad deportiva"
        Unidad_Deportiva,
        /** Instalación deportiva donde se desarrollan carreras ciclistas o de patinaje.
         */
        !!@ ili2db.dispName = "(Institucional) Velódromo, patinódromo"
        Velodromo_Patinodromo
      ),
      !!@ ili2db.dispName = "Anexo"
      Anexo(
        /** Depósito de agua construido a nivel del terreno con el propósito de almacenar agua, o en el caso de las bañadera con el fin de hacer limpieza al ganado, estas construcciones son cubiertas para guardar de la intemperie.
         */
        !!@ ili2db.dispName = "(Anexo) Albercas - Bañaderas"
        Albercas_Banaderas,
        /** Nombre dado en zonas cafeteras a aquellas construcciones donde realizan el beneficio del café. Consiste en áreas cubiertas dentro de las cuales se encuentran los elementos destinados a la labor de seleccionar, lavar y despulpar el grano y su posterior empaque.
         */
        !!@ ili2db.dispName = "(Anexo) Beneficiaderos"
        Beneficiaderos,
        /** Construcción para el desarrollo de proyectos acuícolas del cultivo de camarones.
         */
        !!@ ili2db.dispName = "(Anexo) Camaroneras"
        Camaroneras,
        /** Superficie de terreno adecuada sobre un placa para la practica de deportes como fútbol de salón, voleibol, balocento u alguna otra disciplina que haga uso de la cancha, todo ello a pequeña escala. Se excluyen las canchas de tenis, los estadios, coliseo u otras edificaciones de gran tamaño.
         */
        !!@ ili2db.dispName = "(Anexo) Canchas"
        Canchas,
        /** Superficie terreno rectangular cruzada al medio por una red baja.
         */
        !!@ ili2db.dispName = "(Anexo) Canchas de tenis"
        Canchas_de_Tenis,
        /** Es una vía de transporte de dominio y uso público, proyectada y construida fundamentalmente para la circulación de vehículos automóviles.
         */
        !!@ ili2db.dispName = "(Anexo) Carretera"
        Carretera,
        /** Cada una de las superficies de un edificio que disponen de una cara al interior y de otra al exterior.
         */
        !!@ ili2db.dispName = "(Anexo) Cerramiento"
        Cerramiento,
        /** Construcción anexa conformada por unos cimientos, muros y placa base.
         */
        !!@ ili2db.dispName = "(Anexo) Cimientos, estructura, muros y placa base"
        Cimientos_Estructura_Muros_y_Placa_Base,
        /** Construcciòn destinada a la cría y albergue de cerdos. Se utiliza cualesquiera de los tres nombres enunciados según la región donde se ubique; los elementos que la conforman son: estructura, muros y pisos.
         */
        !!@ ili2db.dispName = "(Anexo) Cocheras - Marraneras - Porquerizas"
        Cocheras_Marraneras_Porquerizas,
        /** Tenso estructuras, arquitectura textil, o membranas arquitectónicas, son los nombres con los que se le conoce a los tipos de estructura que emplean materiales que trabajan bajo tensión, sean membranas textiles, láminas, mallas de cables, etc.
         */
        !!@ ili2db.dispName = "(Anexo) Construcción en membrana arquitectónica"
        Construccion_en_Membrana_Arquitectonica,
        /** Un contenedor es un recipiente de carga para el transporte marítimo o fluvial, transporte terrestre y transporte multimodal adecuado para la vivienda o el comercio o servicios.
         */
        !!@ ili2db.dispName = "(Anexo) Contenedor"
        Contenedor,
        /** Sitio cerrado y descubierto que se utiliza par la cría y albergue de ganado generalmente vacuno. consta de los elementos estructura y pisos.
         */
        !!@ ili2db.dispName = "(Anexo) Corrales"
        Corrales,
        /** Lugar cubierto donde se encierra ganado o caballos y/o se realizan actividades propias de su explotación, constituidos por estructura, cubierta, muros y pisos.
         */
        !!@ ili2db.dispName = "(Anexo) Establos - Pesebreras - Caballerizas"
        Establos_Pesebreras_Caballerizas,
        /** Son obras arquitectónicas  que se construyen con el objeto de elevar el nivel del agua de la fuente de riego a los sitios donde se desea utilizar.
         */
        !!@ ili2db.dispName = "(Anexo) Estación de bombeo"
        Estacion_Bombeo,
        /** Instalación que permite el tránsito de personas y la conexión con sistemas de transporte como buses, metro, tren, tranvía, terminales y estaciones, destinadas para la movilidad de las personas.
         */
        !!@ ili2db.dispName = "(Anexo) Estación de sistema de transporte"
        Estacion_Sistema_Transporte,
        /** Unidad construida con destino a la cría y/o protección de aves principalmente para explotación avícola. Conformada por estructura cubierta pisos y muros que son parcialmente elaborados en ladrillo y el resto descubierto o con algún material provisional (plásticos, alambres, etc.).
         */
        !!@ ili2db.dispName = "(Anexo) Galpones - Gallineros"
        Galpones_Gallineros,
        /** Construcción en materiales livianos soportados sobre una base sólida anclada al piso, para uso temporal de vivienda (recreativa o de esparcimiento), generalmente aislada de otro tipo de construcciones.
         */
        !!@ ili2db.dispName = "(Anexo) Glamping"
        Glamping,
        /** Espacio destinado para el almacenamiento y disposición de aeronaves.
         */
        !!@ ili2db.dispName = "(Anexo) Hangar"
        Hangar,
        /** Construcción consistente en una cubierta apoyada en columnas de materiales diferentes, elaborados con el fin de guarecer de la intemperie.
         */
        !!@ ili2db.dispName = "(Anexo) Kioscos"
        Kioscos,
        /** Son depósitos construidos mediante la excavación y compactación de la tierra que almacenan agua de cualquier calidad por un periodo determinado.
         */
        !!@ ili2db.dispName = "(Anexo) Lagunas de oxidación"
        Lagunas_de_Oxidacion,
        /** Cobertizo dentro de una edificación de mayor extensión o patio cubierto, clasificados según su estructura, pisos y el material de la cubierta.
         */
        !!@ ili2db.dispName = "(Anexo) Marquesinas - Patios cubiertos"
        Marquesinas_Patios_Cubiertos,
        /** Deberán diferenciarse de acuerdo a su estructura, longitud, capacidad, usos turísticos o de carga.
         */
        !!@ ili2db.dispName = "(Anexo) Muelles"
        Muelles,
        /** Se denomina muralla a un muro cerrado destinado a la protección y defensa de determinado sitio.
         */
        !!@ ili2db.dispName = "(Anexo) Murallas"
        Murallas,
        /** Las pérgolas son estructuras compuestas por columnas y una armazón superior, cubiertas con mucho follaje o toldo especial que protegen de la lluvia y el sol, también usadas como elemento decorativo en un espacio de las viviendas.
         */
        !!@ ili2db.dispName = "(Anexo) Pérgolas"
        Pergolas,
        /** Estanque artificial con destino al deporte o a la recreación. Se diferencia por sus acabados y especificaciones técnicas para su mantenimiento y operación; sus dimensiones deben darse en unidades de área (m2).
         */
        !!@ ili2db.dispName = "(Anexo) Piscinas"
        Piscinas,
        /** Edificación sin cubierta con que se identifican las pistas de los aeropuertos construidas en asfalto o concreto, incluye la zona o calle de redaje y calles de salida rápida.
         */
        !!@ ili2db.dispName = "(Anexo) Pista aeropuerto"
        Pista_Aeropuerto,
        /** Perforaciones profundas manuales para extraer agua subterránea. Medida en metros de profundidad.
         */
        !!@ ili2db.dispName = "(Anexo) Pozos"
        Pozos,
        /** Consiste en un sitio cubierto elaborado con el fin de resguardar de la intemperie; el nombre de enramadas, cobertizos o caney se utiliza según la forma de la cubierta y la región donde se ubique.
         */
        !!@ ili2db.dispName = "(Anexo) Ramadas - Cobertizos - Caneyes"
        Ramadas_Cobertizos_Caneyes,
        /** Construcciones elaboradas con el objeto de secar en condiciones naturales el café principalmente, aunque es común su uso en otros productos. Consta de estructura y pisos para su calificación.
         */
        !!@ ili2db.dispName = "(Anexo) Secaderos"
        Secaderos,
        /** Construcción de grandes dimensiones que sirve para almacén o depósito, se exceptúan los silos cafeteros.
         */
        !!@ ili2db.dispName = "(Anexo) Silos"
        Silos,
        /** Depósitos subterráneos o de altura, construidos en zonas con deficiencias en abastecimiento para el consumo de los habitantes o para el uso agrícola.  El elemento a calificar es la estructura relacionada con la capacidad de almacenamiento medida en metros cúbicos.
         *  
         * Se excluyen de este tipo de construcción los tanques de almacenamiento domiciliario.
         */
        !!@ ili2db.dispName = "(Anexo) Tanques"
        Tanques,
        /** Deslizadores construidos alrededor de piscinas, medidos en metros lineales. Se clasifican según su altura y materiales de construcción.
         */
        !!@ ili2db.dispName = "(Anexo) Toboganes"
        Toboganes,
        /** Edificio en forma de torre, en cuya cima se sitúa una sala de control, desde la que se dirige y controla el tráfico de un puerto, de un aeropuerto o de un circuito de carreras.
         */
        !!@ ili2db.dispName = "(Anexo) Torre de control"
        Torre_de_Control,
        /** Son estructuras diseñadas para disminuir la temperatura del agua y otros medios.
         */
        !!@ ili2db.dispName = "(Anexo) Torres de enfriamiento"
        Torres_de_Enfriamiento,
        /** Parte de la infraestructura ferroviaria que une dos puntos determinados del territorio.
         */
        !!@ ili2db.dispName = "(Anexo) Vía férrea"
        Via_Ferrea
      )
    );

  TOPIC Catastro_Registro
  EXTENDS LADM_COL_V3_1.LADM_Nucleo =
    OID AS INTERLIS.UUIDOID;
    DEPENDS ON LADM_COL_V3_1.LADM_Nucleo;

    /** Clase que hereda los atributos de la  Clase COL_AgrupacionInteresados.
     */
    !!@ ili2db.dispName = "(CR) Agrupación de Interesados"
    CLASS CR_AgrupacionInteresados
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_AgrupacionInteresados =
    END CR_AgrupacionInteresados;

    !!@ ili2db.dispName = "(CR) Agrupación de Unidades Espaciales"
    CLASS CR_AgrupacionUnidadesEspaciales
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_AgrupacionUnidadesEspaciales =
    END CR_AgrupacionUnidadesEspaciales;

    /** Clase que permite agrupar las unidades de construcción por identificador, uso y tipología.
     */
    !!@ ili2db.dispName = "(CR) Características de la unidad de construcción"
    CLASS CR_CaracteristicasUnidadConstruccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.ObjetoVersionado =
      /** Identificador de la unidad de construcción, su codificación puede ser por letras del abecedario.
       */
      !!@ ili2db.dispName = "Identificador"
      Identificador : MANDATORY TEXT*20;
      /** Es el conjunto de elementos constructivos que conforman una edificación y que de acuerdo a sus características pueden ser consideradas convencionales cuando son de uso residencial, comercial e industrial o no convencionales cuando son anexos de la construcción.
       */
      !!@ ili2db.dispName = "Tipo de unidad de construcción"
      Tipo_Unidad_Construccion : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_UnidadConstruccionTipo;
      /** Número total de plantas en la unidad de construcción.
       */
      !!@ ili2db.dispName = "Total de plantas"
      Total_Plantas : 0 .. 150;
      /** Destinación de los materiales de una unidad constructiva con respecto a la actividad económica desarrollada en la edificación del predio.
       */
      !!@ ili2db.dispName = "Uso"
      Uso : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_UsoUConsTipo;
      /** Año de construcción de la unidad de construcción.
       */
      !!@ ili2db.dispName = "Año de construcción"
      Anio_Construccion : 1512 .. 2500;
      /** Área total construida en la unidad de construcción.
       */
      !!@ ili2db.dispName = "Área construida"
      Area_Construida : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Área total privada de la unidad de construcción para los predios en régimen de propiedad horizontal.
       */
      !!@ ili2db.dispName = "Área privada construida"
      Area_Privada_Construida : 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Observaciones generales respecto de la unidad de construcción.
       */
      !!@ ili2db.dispName = "Observaciones"
      Observaciones : TEXT;
    END CR_CaracteristicasUnidadConstruccion;

    /** Es la unión de materiales adheridos al terreno, con carácter de permanente, cualesquiera sean los elementos que la constituyan.
     */
    !!@ ili2db.dispName = "(CR) Construcción"
    CLASS CR_Construccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Identificador de la unidad de construcción, su codificación puede ser por letras del abecedario.
       */
      !!@ ili2db.dispName = "Identificador"
      Identificador : MANDATORY TEXT*20;
      /** Número total de pisos de la construcción.
       */
      !!@ ili2db.dispName = "Total de pisos"
      Total_Pisos : MANDATORY 0 .. 300;
      /** Número total de sótanos de la construcción.
       */
      !!@ ili2db.dispName = "Total de sótanos"
      Total_Sotanos : 0 .. 99;
      /** Número total de mezanines de la construcción.
       */
      !!@ ili2db.dispName = "Total de mezanines"
      Total_Mezanines : 0 .. 99;
      /** Número total de semisótanos de la construcción.
       */
      !!@ ili2db.dispName = "Total de semisótanos"
      Total_Semisotanos : 0 .. 99;
      /** Área total construida.
       */
      !!@ ili2db.dispName = "Área total de la construcción"
      Area_Total_Construccion : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Altura total de la construcción.
       */
      !!@ ili2db.dispName = "Altura total de la construcción"
      Altura_Total_Construccion : 0.00 .. 1000.00 [INTERLIS.m];
      /** Corresponde a la relación de puntos, líneas, polígono y volumen que en su conjunto tienen propiedades de espacio y estructura, que definen la construcción, es asignado por el sistema de captura.
       */
      !!@ ili2db.dispName = "Geometría"
      Geometria (EXTENDED) : ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END CR_Construccion;

    /** Clase que contiene los datos principales del predio matriz sometido al régimen de propiedad horizontal.
     */
    !!@ ili2db.dispName = "(CR) Datos PH Condominio"
    CLASS CR_DatosPHCondominio =
      /** Área total del terreno del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total de terreno"
      Area_Total_Terreno : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total privada del terreno del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total de terreno privada"
      Area_Total_Terreno_Privada : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total de terreno común del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total de terreno común"
      Area_Total_Terreno_Comun : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total de construida del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total construida"
      Area_Total_Construida : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total construida privada del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total construida privada"
      Area_Total_Construida_Privada : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total construida común del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total construida común"
      Area_Total_Construida_Comun : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Número de torres en el PH o Condominio.
       */
      !!@ ili2db.dispName = "Número de torres"
      Numero_Torres : 0 .. 1000;
      /** Total de unidades privadas en el PH o Condominio.
       */
      !!@ ili2db.dispName = "Total de unidades privadas"
      Total_Unidades_Privadas : 0 .. 99999999;
    END CR_DatosPHCondominio;

    /** Es la clase que hace referencia a los Derechos, Restricciones y Responsabilidades que existen entre algún o algunos interesados frente a un predio.
     */
    !!@ ili2db.dispName = "(CR) Derechos, Restricciones y Responsabilidades"
    CLASS CR_DRR (ABSTRACT)
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_DRR =
      /** Es el tipo de descripciòn por la cual se hacen las incripciones en registro de acuerdo con lo contemplado en el art. 8 de la ley 1579 de 2012.
       */
      !!@ ili2db.dispName = "Naturaleza jurídica"
      Naturaleza_Juridica : TEXT*100;
      /** es el número asignado en el registro a cada acto sujeto a registro.
       */
      !!@ ili2db.dispName = "Código de la naturaleza jurídica"
      Codigo_Naturaleza_Juridica : TEXT*5;
      /** Es el comentario que puede hacer cada calificador para dar claridad a cada inscripción registral.
       */
      !!@ ili2db.dispName = "Naturaleza complemento"
      Naturaleza_Complemento : TEXT*200;
      /** Es la fecha en la cual se culmina el tramite registral y queda centado el documento en la matricula inmobiliaria.
       */
      !!@ ili2db.dispName = "Fecha de la anotación"
      Fecha_Anotacion : INTERLIS.XMLDate;
    END CR_DRR;

    !!@ ili2db.dispName = "(CR) Estructura Avalúo Catastral"
    STRUCTURE CR_EstructuraAvaluoCatastral =
      !!@ ili2db.dispName = "Vigencia avalúo"
      Vigencia_Avaluo : INTERLIS.XMLDate;
      !!@ ili2db.dispName = "Valor avalúo"
      Valor_Avaluo : LADM_COL_V3_1.LADM_Nucleo.Peso;
    END CR_EstructuraAvaluoCatastral;

    /** Corresponde a la información del código de la ORIP y el número de matrícula inmobiliaria de los predios por los cuales nació el predio objeto de estudio.
     */
    !!@ ili2db.dispName = "(CR) Estructura Matrícula Matriz"
    STRUCTURE CR_EstructuraMatriculaMatriz =
      /** Es el nùmero que se ha asignado a la Oficina de Registro de Instrumentos públicos correspondiente.
       */
      !!@ ili2db.dispName = "Código ORIP"
      Codigo_ORIP : TEXT*20;
      /** Es el consecutivo que se asigna a cada predio jurídico abierto en la ORIP.
       */
      !!@ ili2db.dispName = "Matrícula inmobiliaria"
      Matricula_Inmobiliaria : TEXT*20;
    END CR_EstructuraMatriculaMatriz;

    /** Corresponde a la información del código de la ORIP y el número de matrícula inmobiliaria de los predios que se han aperturado con base en el predio objeto de estudio.
     */
    !!@ ili2db.dispName = "(CR) Estructura Matrícula Segregados"
    STRUCTURE CR_EstructuraMatriculaSegregados =
      /** Es el nùmero que se ha asignado a la Oficina de Registro de Instrumentos públicos correspondiente.
       */
      !!@ ili2db.dispName = "Código ORIP"
      Codigo_ORIP : TEXT*20;
      /** Es el consecutivo que se asigna a cada predio jurídico abierto en la ORIP.
       */
      !!@ ili2db.dispName = "Matrícula inmobiliaria"
      Matricula_Inmobiliaria : TEXT*20;
    END CR_EstructuraMatriculaSegregados;

    /** Clase que almacena las fuentes administrativas (escrituras, sentencias, actos administrativos, etc) que sustentan el Derecho respecto de la relación de tenencia entre el Interesado y el predio.
     */
    !!@ ili2db.dispName = "(CR) Fuente Administrativa"
    CLASS CR_FuenteAdministrativa
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_FuenteAdministrativa =
      /** Documentos como escritura pública, sentencia judicial, acto administrativo, documento privado o sin documento (puede ser una declaración verbal), que acredita la adquisición de derechos de dominio sobre un bien inmueble y la relación que existe entre el interesado y el predio.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo (EXTENDED) : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_FuenteAdministrativaTipo;
      /** Es tipo de oficina que emite el documento (notaria, juzgado)
       */
      !!@ ili2db.dispName = "Ente emisor"
      Ente_Emisor : TEXT*255;
      /** Es el número con el cual se identifica la oficina que origina el documento.
       */
      !!@ ili2db.dispName = "Oficina de origen"
      Oficina_Origen : 0 .. 100;
      /** Es la ciudad donde se encuentra ubicada la oficina que expide el documento.
       */
      !!@ ili2db.dispName = "Ciudad de origen"
      Ciudad_Origen : TEXT*60;
    END CR_FuenteAdministrativa;

    /** Clase que hereda los atributos de la  Clase COL_FuenteEspacial.
     */
    !!@ ili2db.dispName = "(CR) Fuente Espacial"
    CLASS CR_FuenteEspacial
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_FuenteEspacial =
      /** Insumos utilizados para la obtención de información espacial en la definición en los linderos para cada predio.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo (EXTENDED) : MANDATORY LADM_COL_V3_1.LADM_Nucleo.COL_FuenteEspacialTipo;
      /** Corresponde a la ficha técnica y especificaciones del insumo utilizado para el levantamiento catastral.
       */
      !!@ ili2db.dispName = "Metadato"
      Metadato (EXTENDED) : MTEXT;
    END CR_FuenteEspacial;

    /** Es la relación de tenencia que no corresponde a la propiedad, se presenta en los casos en los que la persona que ejerce la tenencia no es la misma que se encuentra en el registro de propiedad consignado en el folio de matrícula inmobiliaria correspondiente.
     */
    !!@ ili2db.dispName = "(CR) Informalidad"
    CLASS CR_Informalidad
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_DRR =
      /** tipo de informalidad que puede presentarse en cada predio
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_InformalidadTipo;
      /** Indica la fracción de la informalidad en relación a la forma de tenencia y el área que esta ocupa dentro de la extensión del predio. Ejemplo: un predio informal que se encuentra sobre un predio baldío y un predio privado tendrá un porcentaje de derecho de ocupación y posesión expresado en tanto por uno (0.0000000000 a 1.0000000000).
       */
      !!@ ili2db.dispName = "Fracción de informalidad"
      Fraccion_Informalidad : MANDATORY 0.0000000000 .. 1.0000000000;
    END CR_Informalidad;

    /** Es la parte que tiene una relación con el predio por algún tipo de derecho, restricción, publicidad o responsabilidad.
     */
    !!@ ili2db.dispName = "(CR) Interesado"
    CLASS CR_Interesado
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Interesado =
      /** Son considerados dos tipos de interesados, persona natural que actúa a nombre propio y se ocupa de algunas actividades que la ley considera mercantiles y persona jurídica que actúa como institución creada por una o más personas para cumplir un objetivo social que puede ser con o sin fines de lucro.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_InteresadoTipo;
      /** Clase de documentos públicos que permite la identificación del interesado.
       */
      !!@ ili2db.dispName = "Tipo de documento"
      Tipo_Documento : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_DocumentoTipo;
      /** Documento público que contiene datos de identificación personal y que caracteriza al interesado como ciudadano, relacionado mediante un numero de identificación.
       */
      !!@ ili2db.dispName = "Documento de identidad"
      Documento_Identidad : MANDATORY TEXT*50;
      /** Primer nombre de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Primer nombre"
      Primer_Nombre : TEXT*100;
      /** Segundo nombre de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Segundo nombre"
      Segundo_Nombre : TEXT*100;
      /** Primer apellido de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Primer apellido"
      Primer_Apellido : TEXT*100;
      /** Segundo apellido de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Segundo apellido"
      Segundo_Apellido : TEXT*100;
      /** Corresponde a “Masculino” y “Femenino” según como aparezca en el tipo de documento de identidad.
       */
      !!@ ili2db.dispName = "Sexo"
      Sexo : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_SexoTipo;
      /** Grupo de personas a la cual pertenece el interesado, quienes comparten una misma ideología cultural.
       */
      !!@ ili2db.dispName = "Grupo étnico"
      GrupoEtnico : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_GrupoEtnicoTipo;
      /** Nombre jurídico que recibe un sociedad colectiva o empresa constituida legalmente, con el cual se encuentra inscrito.
       */
      !!@ ili2db.dispName = "Razón social"
      Razon_Social : TEXT*255;
    END CR_Interesado;

    /** Linea de división que separa un bien inmueble de otro, que puede o no estar materializada físicamente.
     */
    !!@ ili2db.dispName = "(CR) Lindero"
    CLASS CR_Lindero
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_CadenaCarasLimite =
      /** Longitud en metros del lindero.
       */
      !!@ ili2db.dispName = "Longitud"
      Longitud : MANDATORY 0.0 .. 100000000000.0 [INTERLIS.m];
    END CR_Lindero;

    CLASS CR_NU_CarasLindero
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_CarasLindero =
    END CR_NU_CarasLindero;

    CLASS CR_NU_EspacioJuridicoRedServicios
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_EspacioJuridicoRedServicios =
    END CR_NU_EspacioJuridicoRedServicios;

    CLASS CR_NU_EspacioJuridicoUnidadEdificacion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_EspacioJuridicoUnidadEdificacion =
    END CR_NU_EspacioJuridicoUnidadEdificacion;

    CLASS CR_NU_Nivel
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Nivel =
    END CR_NU_Nivel;

    CLASS CR_NU_RelacionNecesariaBAUnits
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_RelacionNecesariaBAUnits =
    END CR_NU_RelacionNecesariaBAUnits;

    CLASS CR_NU_RelacionNecesariaUnidadesEspaciales
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_RelacionNecesariaUnidadesEspaciales =
    END CR_NU_RelacionNecesariaUnidadesEspaciales;

    !!@ ili2db.dispName = "(CR) Publicidad"
    CLASS CR_Publicidad =
      !!@ ili2db.dispName = "Tipo de publicidad"
      Tipo_Publicidad : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_PublicidadTipo;
      /** Es el tipo de descripciòn por la cual se hacen las incripciones en registro de acuerdo con lo contemplado en el art. 8 de la ley 1579 de 2012.
       */
      !!@ ili2db.dispName = "Naturaleza jurídica"
      Naturaleza_Juridica : TEXT*100;
      /** es el número asignado en el registro a cada acto sujeto a registro.
       */
      !!@ ili2db.dispName = "Código de naturaleza jurídica"
      Codigo_Naturaleza_Juridica : TEXT*5;
      /** Es el comentario que puede hacer cada calificador para dar claridad a cada inscripción registral.
       */
      !!@ ili2db.dispName = "Naturaleza complemento"
      Naturaleza_Complemento : TEXT*200;
      /** Es la fecha en la cual se culmina el tramite registral y queda centado el documento en la matricula inmobiliaria.
       */
      !!@ ili2db.dispName = "Fecha de anotación"
      Fecha_Anotacion : INTERLIS.XMLDate;
    END CR_Publicidad;

    /** Puntos topográficos o geodésicos utilizados como amarre para la ejecución del levantamiento catastral.
     */
    !!@ ili2db.dispName = "(CR) Punto Control"
    CLASS CR_PuntoControl
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Punto =
      /** Nombre o código del punto de control.
       */
      !!@ ili2db.dispName = "ID del punto de control"
      ID_Punto_Control : MANDATORY TEXT*255;
      /** Indica la clasificación del tipo de punto de acuerdo a sus características.
       */
      !!@ ili2db.dispName = "Tipo de punto"
      PuntoTipo (EXTENDED) : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_PuntoTipo;
      /** Es el método utilizado para definir puntos de terreno que son identificables dentro de una fotografía, a los cuales se les puede determinar las coordenadas terrestres de linderos y vértices una vez realizada su digitalización.
       */
      !!@ ili2db.dispName = "Tipo de punto de control"
      Tipo_Punto_Control : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_PuntoControlTipo;
      /** Describe la cercanía en posición de los objetos en el conjunto de datos, con respecto a sus posiciones verdaderas (o las asumidas como verdaderas).
       */
      !!@ ili2db.dispName = "Exactitud horizontal"
      Exactitud_Horizontal : 0.000 .. 10.000 [INTERLIS.m];
      !!@ name = "ValidacionValoresPuntoTipo"
      MANDATORY CONSTRAINT PuntoTipo <> #Control ;
      MANDATORY CONSTRAINT PuntoTipo <> #Otro ;
    END CR_PuntoControl;

    /** Punto que define la frontera de un predio con otro. La sucesión de estos puntos forma una línea que representa el límite entre dos terrenos. Asignado por el sistema de captura.
     */
    !!@ ili2db.dispName = "(CR) Punto Lindero"
    CLASS CR_PuntoLindero
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Punto =
      /** Nombre o código que identifica el punto lindero.
       */
      !!@ ili2db.dispName = "ID del punto de lindero"
      ID_Punto_Lindero : MANDATORY TEXT*255;
      /** Indica la clasificación del tipo de punto de acuerdo a sus características.
       */
      !!@ ili2db.dispName = "Tipo de punto"
      PuntoTipo (EXTENDED) : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_PuntoTipo;
      /** Indica si existe desacuerdo o no entre los colindantes en relación al punto lindero que se está midiendo.
       */
      !!@ ili2db.dispName = "Desacuerdo"
      Desacuerdo : MANDATORY BOOLEAN;
      /** Es el método utilizado para definir puntos de terreno que son identificables dentro de una fotografía, a los cuales se les puede determinar las coordenadas terrestres de linderos y vértices una vez realizada su digitalización.
       */
      !!@ ili2db.dispName = "Fotoidentificación"
      Fotoidentificacion : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_FotoidentificacionTipo;
      /** Describe la cercanía en posición de los objetos en el conjunto de datos, con respecto a sus posiciones verdaderas (o las asumidas como verdaderas).
       */
      !!@ ili2db.dispName = "Exactitud horizontal"
      Exactitud_Horizontal : 0.000 .. 10.000 [INTERLIS.m];
      !!@ name = "ValidacionValoresPuntoTipo"
      MANDATORY CONSTRAINT PuntoTipo <> #Control ;
      MANDATORY CONSTRAINT PuntoTipo <> #Otro ;
    END CR_PuntoLindero;

    /** Porción de tierra con una extensión geográfica definida.
     */
    !!@ ili2db.dispName = "(CR) Terreno"
    CLASS CR_Terreno
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Área total del terreno  resultante del levantamiento catastral..
       */
      !!@ ili2db.dispName = "Área del Terreno"
      Area_Terreno : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Corresponde a la figura geométrica vectorial poligonal, generada a partir de los linderos del predio.
       */
      !!@ ili2db.dispName = "Geometría"
      Geometria (EXTENDED) : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END CR_Terreno;

    /** Clase que contiene los cambios que se presentan en los componentes físico, jurídico o económico de un predio, una vez han sido formados.
     */
    !!@ ili2db.dispName = "(CR) Tramite Catastral"
    CLASS CR_TramiteCatastral =
      /** Para los efectos catastrales, las mutaciones se clasifican de acuerdo a lo definido en la resolución IGAC 1149 de 2021.
       */
      !!@ ili2db.dispName = "Clasificación de la Mutación Catastral"
      Clasificacion_Mutacion : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_MutacionTipo;
      /** Numero de la resolucion de la mutación expedida por el gestor catastral.
       */
      !!@ ili2db.dispName = "Número de la resolución"
      Numero_Resolucion : MANDATORY TEXT*30;
      /** Fecha de la resolucion de la mutación expedida por el gestor catastral.
       */
      !!@ ili2db.dispName = "Fecha de la resolución"
      Fecha_Resolucion : MANDATORY INTERLIS.XMLDate;
      !!@ ili2db.dispName = "Fecha de radicación"
      Fecha_Radicacion : MANDATORY INTERLIS.XMLDate;
    END CR_TramiteCatastral;

    /** Es cada conjunto de materiales consolidados dentro de un predio que tiene unas características específicas en cuanto a elementos constitutivos físicos y usos de la misma.
     */
    !!@ ili2db.dispName = "(CR) Unidad de Construcción"
    CLASS CR_UnidadConstruccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Indica el tipo de planta donde se ubica la unidad de construcción.
       */
      !!@ ili2db.dispName = "Tipo de planta"
      Tipo_Planta : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_ConstruccionPlantaTipo;
      /** Indica numéricamente la ubicación de la planta.
       */
      !!@ ili2db.dispName = "Ubicación de la planta"
      Planta_Ubicacion : MANDATORY 0 .. 300;
      /** Área total construida en la unidad de construcción.
       */
      !!@ ili2db.dispName = "Área construida de la planta"
      Area_Construida : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Altura total de la planta.
       */
      !!@ ili2db.dispName = "Altura de la planta"
      Altura : 1 .. 1000 [INTERLIS.m];
      /** Corresponde a la relación de puntos, líneas, polígono y volumen que en su conjunto tienen propiedades de espacio y estructura, que definen la construcción, es asignado por el sistema de captura.
       */
      !!@ ili2db.dispName = "Geometría"
      Geometria (EXTENDED) : ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END CR_UnidadConstruccion;

    /** Es la culminación de trámite registral, luego de efectuada la inscripción y puesta la constancia de ella en el título o documento objeto de registro.
     */
    !!@ ili2db.dispName = "(CR) Anotación Registro"
    CLASS CR_AnotacionRegistro
    EXTENDS CR_FuenteAdministrativa =
      /** Es el número del turno con el cual se radicó el título o documento presentado en la ORIP directamente o por medios electrónicos
       */
      !!@ ili2db.dispName = "Número de radicación"
      Numero_Radicacion : TEXT*10;
      /** Es la fecha en la cual se recibió el documento en la ORIP
       */
      !!@ ili2db.dispName = "Fecha de radicación"
      Fecha_Radicacion : INTERLIS.XMLDate;
      /** Es el consecutivo asignado por la ORIP a las inscripciones sobre la matrícula inmobiliaria.
       */
      !!@ ili2db.dispName = "Número de la anotación"
      Numero_Anotacion : 0 .. 9999999999;
      /** corresponde al estado de la anotación, ver dominios.
       */
      !!@ ili2db.dispName = "Estado de la anotación"
      Estado_Anotacion : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_EstadoAnotacionTipo;
      /** Es el valor de la transacción
       */
      !!@ ili2db.dispName = "Valor de la transacción"
      Valor_Transaccion : 0 .. 10000000000000000;
    END CR_AnotacionRegistro;

    /** Clase que registra las instancias de los derechos que un interesado ejerce sobre un predio. Es una especialización de la clase COL_DRR del propio modelo.
     */
    !!@ ili2db.dispName = "(CR) Derecho"
    CLASS CR_Derecho
    EXTENDS CR_DRR =
      /** Forma de relación del interesado con respecto al predio según su forma de tenencia.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_DerechoTipo;
      /** Indica la fracción del derecho en relación a la forma de tenencia y el área que esta ocupa dentro de la extensión del predio.
       * 
       * Expresado en tanto por uno (0.0000000000 a 1.0000000000).
       */
      !!@ ili2db.dispName = "Fracción de derecho"
      Fraccion_Derecho : MANDATORY TEXT*255;
    END CR_Derecho;

    /** Clase especializada de BaUnit, que describe la unidad administrativa básica para el caso de Colombia.
     * El predio es la unidad territorial legal propia de Catastro. Esta formada por el terreno y puede o no tener construcciones asociadas.
     */
    !!@ ili2db.dispName = "(CR) Predio"
    CLASS CR_Predio
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadAdministrativaBasica =
      /** Corresponde al codigo del departamento al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 2 dígitos.
       */
      !!@ ili2db.dispName = "Departamento"
      Departamento : MANDATORY TEXT*2;
      /** Corresponde al código del municipio al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 3 dígitos.
       */
      !!@ ili2db.dispName = "Municipio"
      Municipio : MANDATORY TEXT*3;
      /** Dirección del predio.
       */
      !!@ ili2db.dispName = "Dirección"
      Direccion : BAG {1..*} OF LADM_COL_V3_1.LADM_Nucleo.ExtDireccion;
      /** Circulo registral
       */
      !!@ ili2db.dispName = "Código ORIP"
      Codigo_ORIP : TEXT*4;
      /** Matricula inmobiliaria
       */
      !!@ ili2db.dispName = "Matrícula inmobiliaria"
      Matricula_Inmobiliaria : 1 .. 9999999999;
      /** Área consignada en el certificado de tradición y libertad, en la descripción de cabida y linderos o en los títulos registrados, expresada en metros cuadrados.
       */
      !!@ ili2db.dispName = "Área registral en metros cuadrados"
      Area_Registral_M2 : 0.00 .. 10000000000000000000000.00 [LADM_COL_V3_1.m2];
      /** se refiere a la situación actual en la que se encuentra una matricula inmobiliaria.
       */
      !!@ ili2db.dispName = "Estado del FMI"
      Estado_FMI : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_EstadoFMITipo;
      /** Es la fecha en la cual se abrió el Folio de matricula inmobiliaria.
       */
      !!@ ili2db.dispName = "Fecha de apertura FMI"
      Fecha_Apertura_FMI : INTERLIS.XMLDate;
      /** Es la matrícula por la cual se dio apertura al predio objeto de estudio (la madre).
       */
      !!@ ili2db.dispName = "Matrícula predio matriz"
      Matricula_Matriz : BAG {0..*} OF Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.Catastro_Registro.CR_EstructuraMatriculaMatriz;
      /** Las matriculas aperturadas con base en el folio objeto de estudio (los hijos).
       */
      !!@ ili2db.dispName = "Matrícula predios segregados"
      Matricula_Segregados : BAG {0..*} OF Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.Catastro_Registro.CR_EstructuraMatriculaSegregados;
      /** Nuevo código númerico de treinta (30) dígitos, que se le asigna a cada predio y busca localizarlo inequívocamente en los documentos catastrales, según el modelo determinado por el Instituto Geográfico Agustin Codazzi.
       */
      !!@ ili2db.dispName = "Número predial"
      Numero_Predial : MANDATORY TEXT*30;
      /** Es un código único para identificar los inmuebles en los sistemas de información catastral.
       */
      !!@ ili2db.dispName = "Código homologado"
      Codigo_Homologado : MANDATORY TEXT*11;
      /** Es un código único para identificar los inmuebles tanto en los sistemas de información catastral como registral. El NUPRE no implicará supresión de la numeración catastral ni registral asociada a la cédula catastral ni a la matrícula inmobiliaria actual.
       */
      !!@ ili2db.dispName = "Número único predial"
      NUPRE : TEXT*11;
      !!@ ili2db.dispName = "Fecha de inscripción catastral"
      Fecha_Inscripcion_Catastral : INTERLIS.XMLDate;
      !!@ ili2db.dispName = "Año de la última mutación"
      Anio_Ultima_Mutacion : 1512 .. 2550;
      /** El avalúo catastral consiste en la determinación del valor de los predios, obtenido mediante investigación y análisis estadístico del mercado inmobiliario. ?
       * 
       * El avalúo catastral de cada predio se determinará por la adición de los avalúos parciales practicados independientes o no, para los terrenos y para las unidades de construcción en él comprendidos.?
       * 
       * El avalúo catastral corresponde a un porcentaje adoptado del avalúo comercial según el estudio económico, dichos avalúos se redondean a miles.
       */
      !!@ ili2db.dispName = "Avalúo Catastral"
      Avaluo_Catastral : BAG {0..*} OF Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.Catastro_Registro.CR_EstructuraAvaluoCatastral;
      /** Es el valor determinado objetivamente para cada bien inmueble a partir de los datos obrantes en el Catastro, que se
       * corresponde con el precio más probable por el cual podría venderse.
       */
      !!@ ili2db.dispName = "Valor de referencia"
      Valor_Referencia : LADM_COL_V3_1.LADM_Nucleo.Peso;
      !!@ ili2db.dispName = "Tipo de predio"
      Tipo (EXTENDED) : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_PredioTipo;
      /** Corresponde a una caracterización temática de las condiciones de predio que se está censando relacionada a aspectos físicos y jurídicos.
       */
      !!@ ili2db.dispName = "Condición del predio"
      Condicion_Predio : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_CondicionPredioTipo;
      /** Es la clasificación para fines estadísticos y económicos que se da a cada inmueble en su conjunto–terreno, construcciones o edificaciones-, en el momento de la identificación predial de conformidad con la actividad predominante que en él se desarrolle.
       */
      !!@ ili2db.dispName = "Destinación económica"
      Destinacion_Economica : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_DestinacionEconomicaTipo;
      /** Se considerará como procedimientos catastrales con efectos registrales los siguientes: actualización de linderos, rectificación de área por imprecisa determinación, actualización masiva y puntual de linderos y áreas, rectificación de linderos por acuerdo entre las partes, e inclusión de área y/o linderos.
       */
      !!@ ili2db.dispName = "Procedimientos catastrales con efectos registrales"
      Procedimiento_Catastral_Registral : Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_ProcedimientoCatastralRegistralTipo;
      /** Estado de La información física, jurídica y económica, así como la resultante de los procedimientos de enfoque multipropósito entrarán en vigencia para efectos catastrales al momento de quedar en firme su inscripción o incorporación en las bases oficiales descritas en el  decreto 148 de 2020.
       */
      !!@ ili2db.dispName = "Vigencia de la actualización catastral"
      Vigencia_Actualizacion_Catastral : MANDATORY INTERLIS.XMLDate;
      UNIQUE Codigo_Homologado; 
      !!@ name = "ValidacionValoresPredioTipo"
      MANDATORY CONSTRAINT Tipo <> #Ordenamiento_Territorial ;
      MANDATORY CONSTRAINT Tipo <> #Servicios_Publicos ;
      MANDATORY CONSTRAINT Tipo <> #Reservas_Naturales ;
      MANDATORY CONSTRAINT Tipo <> #Parques_Naturales ;
      MANDATORY CONSTRAINT Tipo <> #Amenazas_Riesgos ;
      MANDATORY CONSTRAINT Tipo <> #Servidumbre ;
      MANDATORY CONSTRAINT Tipo <> #Superficies_Agua ;
      MANDATORY CONSTRAINT Tipo <> #Transporte ;
    END CR_Predio;

    /** es la obligación de hacer algo relacionado con el predio.
     */
    !!@ ili2db.dispName = "(CR) Responsabilidad"
    CLASS CR_Responsabilidad
    EXTENDS CR_DRR =
      /** los tipos se desarrollan por el origen de la responsabilidad.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_ResponsabilidadTipo;
    END CR_Responsabilidad;

    /** Restricción legalmente constituida y registrada que afecta el derecho de una persona en relación con el predio.
     */
    !!@ ili2db.dispName = "(CR) Restricción"
    CLASS CR_Restriccion
    EXTENDS CR_DRR =
      /** son los tipos de restricciones de acuerdo con la naturaleza del registro colombiano.c
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.CR_RestriccionTipo;
    END CR_Restriccion;

    ASSOCIATION cr_construccion_unidadconstruccion =
      cr_unidadconstruccion -- {0..*} CR_UnidadConstruccion;
      cr_construccion -- {0..1} CR_Construccion;
    END cr_construccion_unidadconstruccion;

    ASSOCIATION cr_publicidadBAUnit =
      cr_publicidad -- {0..*} CR_Publicidad;
      cr_baunit -- {1} LADM_COL_V3_1.LADM_Nucleo.COL_UnidadAdministrativaBasica;
    END cr_publicidadBAUnit;

    ASSOCIATION cr_publicidadFuente =
      cr_publicidad -- {0..1} CR_Publicidad;
      col_fuente -- {1..*} LADM_COL_V3_1.LADM_Nucleo.COL_FuenteAdministrativa;
    END cr_publicidadFuente;

    ASSOCIATION cr_publicidadInteresado =
      cr_publicidad -- {0..*} CR_Publicidad;
      col_interesado -- {0..1} LADM_COL_V3_1.LADM_Nucleo.COL_Interesado;
    END cr_publicidadInteresado;

    ASSOCIATION cr_unidadconstruccion_caracteristicasunidadconstruccion =
      cr_caracteristicasunidadconstruccion -- {1} CR_CaracteristicasUnidadConstruccion;
      cr_unidadconsutruccion -- {1..*} CR_UnidadConstruccion;
    END cr_unidadconstruccion_caracteristicasunidadconstruccion;

    /** Es un tipo de restricción específico que persigue al bien independientemente de la parte interesada que respalde la acreencia.
     */
    !!@ ili2db.dispName = "(CR) Hipoteca"
    CLASS CR_Hipoteca
    EXTENDS CR_Restriccion =
    END CR_Hipoteca;

    ASSOCIATION cr_ph_predio =
      cr_predio -- {1} CR_Predio;
      cr_datos_ph -- {0..1} CR_DatosPHCondominio;
    END cr_ph_predio;

    /** Relación entre unidades prediales y predios matrices bajo el régimen de propiedad horizontal y condominio.
     */
    ASSOCIATION cr_predio_copropiedad =
      /** Area privada de terreno matriz, adicional a la participación en el terreno común, según el coeficiente allí determinado.
       */
      unidad_predial -- {0..*} CR_Predio;
      /** Unidades residenciales tales como edificios, conjuntos y tipos de urbanizaciones cerradas en las que se comparten áreas comunes y que tienen régimen de propiedad horizontal.
       */
      matriz -<> {0..1} CR_Predio;
      /** Coeficiente de copropiedad de la unidad predial.
       */
      !!@ ili2db.dispName = "Coeficiente"
      Coeficiente : 0.0000000000 .. 1.0000000000;
    END cr_predio_copropiedad;

    ASSOCIATION cr_predio_informalidad =
      lc_predio_formal -- {0..*} CR_Predio;
      lc_predio_informal -- {0..*} CR_Predio;
    END cr_predio_informalidad;

    ASSOCIATION cr_predio_tramitecatastral =
      cr_predio -- {0..*} CR_Predio;
      cr_tramite_catastral -- {0..*} CR_TramiteCatastral;
    END cr_predio_tramitecatastral;

    ASSOCIATION cr_hipotecaDerecho =
      cr_hipoteca -- {0..*} CR_Hipoteca;
      cr_derecho -- {0..*} CR_Derecho;
    END cr_hipotecaDerecho;

  END Catastro_Registro;

END Modelo_Extendido_LADMCOL_Cat_Reg_V4_0.
