       * 0473
       * 0477
       * 0490
       * 0492
       * 0499
       * 04001
       */
      !!@ ili2db.dispName = "Demanda"
      Demanda,
      /** Se refiere a la agrupación de códigos de iniciación de procesos administrativos: 
       * 
       * 0403
       * 0404
       * 0446
       * 0447
       * 0448
       * 0449
       * 0450
       * 0451
       * 0452
       * 0481
       * 04004
       * 0916
       * 0936
       * 0937
       * 0938
       * 0939
       * 0952
       * 0965
       * 0969
       */
      !!@ ili2db.dispName = "Inicio de proceso administrativo"
      Inicio_Proceso_Administrativo,
      /** Se refiere a la agrupación de códigos de cancelaciones: 
       * 
       * 0841
       * 0842
       * 0843
       * 0844
       * 0845
       * 0846
       * 0847
       * 0848
       * 0849
       * 0850
       * 0851
       * 0852
       * 0853
       * 0854
       * 0855
       * 0856
       */
      !!@ ili2db.dispName = "Cancelación"
      Cancelacion,
      /** Es la agrupación de códigos que publicitan asuntos relacionados con desplazamiento, ley de víctimas o restitución: 
       * 
       * 0928
       * 0930
       * 0931
       * 0932
       * 0933
       * 0934
       * 0480
       * 0482
       * 04006
       * 0483
       */
      !!@ ili2db.dispName = "Desplazamiento forzado, víctimas o restitución"
      Victima_Restitucion,
