    CR_UsoUConsTipo = (
      !!@ ili2db.dispName = "Residencial"
      Residencial(
        /** Es una vivienda que comprende una o más habitaciones en un edificio de varios pisos 4 o más, sometido a régimen de propiedad horizontal
         */
        !!@ ili2db.dispName = "(Residencial) Apartamentos 4 y más pisos en PH"
        Apartamentos_4_y_mas_pisos_en_PH,
        /** Es una vivienda que comprende una o más habitaciones, en un edificio de varios pisos 4 o más pisos.
         */
        !!@ ili2db.dispName = "(Residencial) Apartamentos más de 4 pisos"
        Apartamentos_4_y_mas_pisos,
        /** Dormitorios de las fuerzas armadas y militares.
         */
        !!@ ili2db.dispName = "(Residencial) Barracas"
        Barracas,
        /** Típica casa con mampostería de piedra, pizarra y madera. Ha sido rehabilitada respetando escrupulosamente sus características exteriores y decorada con un interior tradicional.
         */
        !!@ ili2db.dispName = "(Residencial) Casa elbas"
        Casa_Elbas,
        /** Edificación destinada al almacenamiento o resguardo de enceres, generalmente ubicados en los sótanos y semisótanos de los edificios, junto a los parqueaderos. Las áreas de estos depósitos generalmente no supera los 25 metros cuadrados.
         */
        !!@ ili2db.dispName = "(Residencial) Depósitos o lockers"
        Depositos_Lockers,
        /** Es el lugar cubierto, destinado al estacionamiento privado de vehículos.
         */
        !!@ ili2db.dispName = "(Residencial) Garajes cubiertos"
        Garajes_Cubiertos,
        /** Es el lugar cubierto, destinado al estacionamiento privado o comunal en viviendas sometidas a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Residencial) Garajes en PH"
        Garajes_En_PH,
        /** Los salones comunales son dependencias que se construyen dentro de los edificios y conjuntos que sobrepasan un área determinada de construcción, y se clasifican de acuerdo a las normas urbanísticas como equipamiento comunal privado.
         */
        !!@ ili2db.dispName = "(Residencial) Salón comunal"
        Salon_Comunal,
        /** Bien inmueble cubierto o descubierto ubicado en el último piso de algunos edificios utilizado para extender y secar la ropa y que está sometido a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Residencial) Secadero de ropa"
        Secadero_Ropa,
        /** Son las viviendas construidas durante el tiempo de la colonia española, se caracterizan por tener varias habitaciones, con ventanales que dan a uno o dos patios generalmente ubicados en el centro de la vivienda. Los principales materiales de la época era la tapia, bahareque, ladrillo, paja y teja.
         */
        !!@ ili2db.dispName = "(Residencial) Vivienda colonial"
        Vivienda_Colonial,
        /** Es una vivienda que comprende una o más habitaciones en un edificio de 4 o más pisos sometidos a régimen de propiedad horizontal.  Se caracterizan por conservar gran parte o el total de la construcción original realizada durante el tiempo de la colonia española. Los principales materiales de la época era la tapia, bahareque, ladrillo, paja y teja.
         */
        !!@ ili2db.dispName = "(Residencial) Vivienda colonial en PH"
        Vivienda_Colonial_en_PH,
        /** Es una casa de tres niveles cuya función arquitectónica y ambiental principal, es dar albergue en forma adecuada a una familia.
         */
        !!@ ili2db.dispName = "(Residencial) Vivienda hasta 3 pisos"
        Vivienda_Hasta_3_Pisos,
        /** Corresponde a edificaciones residenciales desarrolladas sobre un lote de terreno que comprende más de tres unidades prediales independientes, generalmente en edificios de varios pisos. Este tipo de vivienda prevé áreas de servicios comunales cuya propiedad y utilización privada se definen en reglamentos de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Residencial) Vivienda hasta 3 pisos en PH"
        Vivienda_Hasta_3_Pisos_En_PH,
        /** Es una vivienda acondicionada para la realización de actividades recreativas libres y el descanso.
         */
        !!@ ili2db.dispName = "(Residencial) Vivienda recreacional"
        Vivienda_Recreacional,
        /** Es una casa cuya función arquitectónica y ambiental principal, es brindar descanso y recreación. Este tipo de vivienda prevé áreas de servicios comunales cuya propiedad y utilización privada se definen en reglamentos de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Residencial) Vivienda recreacional en PH"
        Vivienda_Recreacional_En_PH
      ),
      !!@ ili2db.dispName = "Comercial"
      Comercial(
        /** Es el espacio construido para la ejecución la recepción, almacenamiento y movimientos de materiales, materias primas y productos semielaborados, hasta el punto de consumo por un cliente externo o interno.
         */
        !!@ ili2db.dispName = "(Comercial) Bodegas comerciales - Grandes almacenes"
        Bodegas_Comerciales_Grandes_Almacenes,
        /** Es el espacio construido para la ejecución la recepción, almacenamiento y movimientos de materiales, materias primas y productos semielaborados, hasta el punto de consumo por un cliente externo o interno sometido a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Comercial) Bodegas comerciales en PH"
        Bodegas_Comerciales_en_PH,
        /** es una construcción que consta de uno o varios edificios, por lo general de gran tamaño, que albergan servicios, locales y oficinas comerciales aglutinados en un espacio determinado concentrando mayor cantidad de clientes potenciales dentro del recinto.
         */
        !!@ ili2db.dispName = "(Comercial) Centros comerciales"
        Centros_Comerciales,
        /** Es una construcción que consta de uno o varios edificios, por lo general de gran tamaño, que albergan servicios, locales y oficinas comerciales aglutinados en un espacio determinado concentrando mayor cantidad de clientes potenciales dentro del recinto, sometido a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Comercial) Centros comerciales en PH"
        Centros_Comerciales_en_PH,
        /** Es la edificación o establecimiento que brinda servicios recreativos y tiene capacidad para ciertos juegos de azar.
         */
        !!@ ili2db.dispName = "(Comercial) Clubes - Casinos"
        Clubes_Casinos,
        /** Se denomina a la construcción en la cual se lleva a acabo una actividad socioeconómica que consiste en el intercambio de algunos materiales en el mercado de compra y venta de bienes.
         */
        !!@ ili2db.dispName = "(Comercial) Comercio"
        Comercio,
        /** Se denomina a la construcción con características arquitectónicas coloniales, en el cual se lleva a acabo una actividad socioeconómica que consiste en el intercambio de algunos materiales en el mercado de compra y venta de bienes.
         */
        !!@ ili2db.dispName = "(Comercial) Comercio colonial"
        Comercio_Colonial,
        /** Se denomina a la construcción en la cual se lleva a acabo una actividad socioeconómica que consiste en el intercambio de algunos materiales en el mercado de compra y venta de bienes sometida a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Comercial) Comercio en PH"
        Comercio_en_PH,
        /** Establecimiento que ocupa un edificio total o parcialmente con uso exclusivo de sus servicios (entradas, ascensores, escaleras, etc.) y que ofrece alojamiento y posee características arquitectónicas coloniales.
         */
        !!@ ili2db.dispName = "(Comercial) Hotel colonial"
        Hotel_Colonial,
        /** Establecimiento que ocupa un edificio total o parcialmente con uso exclusivo de sus servicios (entradas, ascensores, escaleras, etc.) y que ofrece alojamiento.
         */
        !!@ ili2db.dispName = "(Comercial) Hoteles"
        Hoteles,
        /** Establecimiento que ocupa un edificio total o parcialmente que ofrece alojamiento.
         */
        !!@ ili2db.dispName = "(Comercial) Hoteles en PH"
        Hoteles_en_PH,
        /** Espacio construido en el que se realiza un trabajo profesional de gestión, administración o atención médica.
         */
        !!@ ili2db.dispName = "(Comercial) Oficinas - Consultorios"
        Oficinas_Consultorios,
        /** Espacio construido con características arquitectónicas coloniales en el que se realiza un trabajo profesional de gestión, administración o atención médica.
         */
        !!@ ili2db.dispName = "(Comercial) Oficinas - Consultorios coloniales"
        Oficinas_Consultorios_Coloniales,
        /** Espacio construido en el que se realiza un trabajo profesional de gestión, administración o atención médica, sometida a régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Comercial) Oficinas consultorios en PH"
        Oficinas_Consultorios_en_PH,
        /** Construcciones dedicadas al esparcimiento y a la diversión, generalmente son predios con grandes espacios, ejemplo parque el salitre.
         */
        !!@ ili2db.dispName = "(Comercial) Parque de diversiones"
        Parque_Diversiones,
        /** Es el espacio que con ánimo de lucro se destina a guardar o arrendar espacios para depositar vehículos dentro de una edificación construida para tal fin, o dentro de un predio habilitado con el mismo objeto.
         */
        !!@ ili2db.dispName = "(Comercial) Parqueaderos"
        Parqueaderos,
        /** Es el espacio o se destina a guardar o arrendar espacios para depositar vehículos dentro de una edificación construida privado o comunal bajo régimen de propiedad horizontal.
         */
        !!@ ili2db.dispName = "(Comercial) Parqueaderos en PH"
        Parqueaderos_en_PH,
        /** Vivienda que proporciona alojamiento y hospedaje temporal.
         */
        !!@ ili2db.dispName = "(Comercial) Pensiones y residencias"
        Pensiones_y_Residencias,
        /** Edificaciones tipo bodega destinadas a la prestacion de un servicio público, como es la oferta de productos básicos, principalmente de origen agropecuario y consumo doméstico.
         */
        !!@ ili2db.dispName = "(Comercial) Plaza de mercado"
        Plaza_Mercado,
        /** Establecimiento con características arquitectónicas coloniales en el que se preparan y sirven comidas.
