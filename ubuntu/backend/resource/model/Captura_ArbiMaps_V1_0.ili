      !!@ ili2db.dispName="Número de fuente"

      FA_Numero_Fuente : TEXT*150;

      !!@ ili2db.dispName="Fecha documento fuente"

      FA_Fecha_Documento_Fuente : INTERLIS.XMLDate;

      !!@ ili2db.dispName="Ente emisor"

      FA_Ente_Emisor : TEXT*255;

      !!@ ili2db.dispName="Oficina origen"

      Oficina_Origen : 0 .. 9999999999;

      !!@ ili2db.dispName=Nombre

      Nombre : TEXT*100;

      !!@ ili2db.dispName="Ciudad origen"

      Ciudad_Origen : TEXT*100;

      !!@ ili2db.dispName="Estado disponibilidad"

      Estado_Disponibilidad : TEXT*100;

      !!@ ili2db.dispName="Descripcion fuente"

      Descripcion_Fuente : TEXT*500;

      !!@ ili2db.dispName="Adjunto de fuente administrativa"

      FA_Adjunto : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AdjuntoFuenteAdministrativaValor;

      !!@ ili2db.dispName="Observación de fuente administrativa"

      FA_Observacion : TEXT*255;

      !!@ ili2db.dispName=Participación

      Participacion : 0 .. 100;

      /** Tipo de persona del que se trata

       */

      !!@ ili2db.dispName="Tipo de persona"

      I_Tipo : ARB_InteresadoTipo;

      /** Tipo de documento del que se trata.

       */

      !!@ ili2db.dispName="Tipo de documento"

      I_Tipo_Documento : ARB_InteresadoDocumentoTipo;

      /** Documento de identidad del interesado.

       */

      !!@ ili2db.dispName="Documento de identidad"

      I_Documento_Identidad : TEXT*50;

      !!@ ili2db.dispName="Naturaleza jurídica"

      Naturaleza_Juridica : ARB_NaturalezaJuridicaTipo;

      !!@ ili2db.dispName="Código naturaleza jurídica"

      Codigo_Naturaleza_Juridica : TEXT*50;

      /** Primer nombre de la persona física.

       */

      !!@ ili2db.dispName="Primer nombre"

      I_Primer_Nombre : TEXT*100;

      /** Segundo nombre de la persona física.

       */

      !!@ ili2db.dispName="Segundo nombre"

