      !!@ ili2db.dispName="Tipo de publicidad"

      tipo_publicidad : ARB_PublicidadTipo;

      !!@ ili2db.dispName="Número anotación"

      numero_anotacion : TEXT*30;

      !!@ ili2db.dispName="Número documento"

      numero_documento : TEXT*50;

      !!@ ili2db.dispName="Fecha documento"

      fecha_documento : INTERLIS.XMLDate;

      !!@ ili2db.dispName=Descripción

      descripcion : MTEXT;

      !!@ ili2db.dispName=Observacion

      observacion : MTEXT;

    END ARB_Publicidad;



    !!@ ili2db.dispName="(ARB) Informalidad"

    CLASS ARB_Informalidad =

      !!@ ili2db.dispName="Tipo de informalidad"

      tipo_informalidad : ARB_TipoInformalidadTipo;

      !!@ ili2db.dispName="Fracción informalidad"

      fraccion_informalidad : 0.0000000000 .. 1.0000000000;

      !!@ ili2db.dispName="Fecha registro"

      fecha_registro : INTERLIS.XMLDate;

      !!@ ili2db.dispName=Fuente

      fuente : TEXT*255;

      !!@ ili2db.dispName=Observacion

      observacion : MTEXT;

    END ARB_Informalidad;



    !!@ ili2db.dispName="(ARB) Alerta Predio"

    CLASS ARB_AlertaPredio =

      !!@ ili2db.dispName="Descripción alerta"

      Descripcion_Alerta : TEXT*255;

      !!@ ili2db.dispName="Entidad emisora alerta"

      Entidad_Emisora_Alerta : TEXT*255;

      !!@ ili2db.dispName="Fecha apertura alerta"

      Fecha_Apertura_Alerta : INTERLIS.XMLDate;

      !!@ ili2db.dispName="Fecha cierre alerta"

      Fecha_Cierre_Alerta : INTERLIS.XMLDate;

    END ARB_AlertaPredio;


    /** Clase especializada de BaUnit, que describe la unidad administrativa básica para el caso de Colombia.

     * El predio es la unidad territorial legal propia de Catastro. Está formada por el terreno y puede o no tener construcciones asociadas.

     */

    !!@ ili2db.dispName="(ARB) Predio"

    CLASS ARB_Predio =

      /** Identificador único temporal de cada predio que se asigna en el desarrollo del levantamiento catastral.

       */

      !!@ ili2db.dispName="Identificador único de operación"

      Id_Operacion : MANDATORY TEXT*50;

      /** Dirección del predio.

       */

      !!@ ili2db.dispName=Dirección

      Direccion : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_Direccion;

      /** Nuevo Código numérico de treinta (30) dígitos, que se le asigna a cada predio y busca localizarlo inequívocamente en los documentos catastrales, según el modelo determinado por el Instituto Geográfico Agustín Codazzi.

       */

      !!@ ili2db.dispName="Número predial"

      Numero_Predial : TEXT*30;

      Numero_Predial_Anterior : TEXT*20;

      /** Circulo registral

       */

      !!@ ili2db.dispName="Código ORIP"

      Codigo_ORIP : TEXT*4;

      /** Matricula inmobiliaria

       */

      !!@ ili2db.dispName="Matrícula inmobiliaria"

      Matricula_Inmobiliaria : 1 .. 9999999999;

      !!@ ili2db.dispName="Estado FMI"

      Estado_FMI : ARB_EstadoFMITipo;

      !!@ ili2db.dispName="Fecha apertura FMI"

      Fecha_Apertura_FMI : INTERLIS.XMLDate;

      !!@ ili2db.dispName="Fecha inscripción catastral"

      Fecha_Inscripcion_Catastral : INTERLIS.XMLDate;

      !!@ ili2db.dispName="Vigencia actualización"

      Vigencia_Actualizacion : INTERLIS.XMLDate;

      /** Registro asociado a la anotación en antiguo sistema de registro. (Libros)

       */

      !!@ ili2db.dispName="Referencia registral del sistema antiguo"

      Referencia_Registral_Sistema_Antiguo : Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_ReferenciaRegistralSistemaAntiguoValor;

      !!@ ili2db.dispName="Área registral en metros cuadrados"

      Area_Registral_M2 : 0.00 .. 10000000000000000000000.00 [Captura_ArbiMaps_V1_0.m2];

      /** Caracterización temática del predio.

       */

      !!@ ili2db.dispName="Condición del predio"

      Condicion_Predio : ARB_CondicionPredioTipo;

      !!@ ili2db.dispName="Coeficiente de Copropiedad"

      Coeficiente_Copropiedad : 0.0000000000 .. 100.0000000000;

      !!@ ili2db.dispName="Area Coeficiente de Copropiedad"

      Area_Coeficiente_Copropiedad : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      /** Es la clasificación para fines estadísticos que se da a cada inmueble en su conjunto-terreno, construcciones o edificaciones-, en el momento de la identificación predial de conformidad con la actividad predominante que en él se desarrolle.
       */

      !!@ ili2db.dispName="Destinación económica"

      Destinacion_Economica : ARB_DestinacionEconomicaTipo;

      !!@ ili2db.dispName="Tipo de predio"

      Tipo : ARB_PredioTipo;

      !!@ ili2db.dispName="Resultado de la visita predial"

      Resultado_Visita : ARB_ResultadoVisitaTipo;

      !!@ ili2db.dispName="Fecha de visita predial"

      Fecha_Visita_Predial : INTERLIS.XMLDate;

      !!@ ili2db.dispName="Tipo de documento de quien atendió la visita predial"

      Tipo_Documento_Quien_Atendio : ARB_InteresadoDocumentoTipo;

      !!@ ili2db.dispName="Numero de documento de quien atendió la visita predial"

      Numero_Documento_Quien_Atendio : TEXT*50;

      /** Nombres y apellidos de la persona encargada de atender la visita de ejecución de actividades catastrales sobre el predio.

       */

      !!@ ili2db.dispName="Nombres y apellidos de quien atendió"

      Nombres_Apellidos_Quien_Atendio : TEXT*150;

      !!@ ili2db.dispName=Celular

      Celular : 0.0 .. 9999999999.0;

      !!@ ili2db.dispName="Correo electrónico"

      Correo_Electronico : TEXT*100;

      /** Dirección de domicilio para notificaciones.

       */

      !!@ ili2db.dispName="Domicilio de notificaciones"

      Domicilio_Notificaciones : TEXT*255;

      /** Indica si autoriza las notificaciones administrativas por medio de vía electrónica.

       */

      !!@ ili2db.dispName="Autoriza notificaciones"

      Autoriza_Notificaciones : BOOLEAN;

      /** Tipo de novedad asociada al predio

       */

      !!@ ili2db.dispName="Tipo de novedad"

      Novedad_FMI : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_NovedadFMIValor;

      !!@ ili2db.dispName="Novedad número predial"

      Novedad_Numero_Predial : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_NovedadNumeroPredialValor;

      /** Método de captura del predio.

       */

      !!@ ili2db.dispName="Tipo de captura"

      Tipo_Captura : ARB_MetodoProduccionTipo;

      !!@ ili2db.dispName=Observaciones

      Observaciones : MTEXT;

      /** Área consignada en el certificado de tradición y  libertad, en la descripción de cabida y linderos o en los titúlos registrados, expresada en metros cuadrados.

       */

      !!@ ili2db.dispName="Área catastral del terreno en metros cuadrados"

      Area_Catastral_Terreno : 0.00 .. 1000000000000000000000000.00 [Captura_ArbiMaps_V1_0.m2];

      /** Nombre que recibe la unidad administrativa básica, en muchos casos toponímico, especialmente en terrenos rústicos.

       */

      Nombre : TEXT*255;

      /** Identificador único asociado al predio matriz

       */

      !!@ ili2db.dispName="Predio Matriz"

      Predio_Matriz : TEXT*30;

      !!@ ili2db.dispName="Código Homologado"

      codigo_homologado : TEXT*11;

      !!@ ili2db.dispName=NUPRE

      nupre : TEXT*11;

      !!@ ili2db.dispName=Estado

      Estado : ARB_EstadoTipo;

      !!@ ili2db.dispName="Created User"

      created_user : TEXT*255;

      !!@ ili2db.dispName="Created Date"

      created_date : INTERLIS.XMLDateTime;

      !!@ ili2db.dispName="Last Edited User"

      last_edited_user : TEXT*255;

      !!@ ili2db.dispName="Last Edited Date"

      last_edited_date : INTERLIS.XMLDateTime;

      /** Predios donde habitan comunidades indígenas que han sido entregados en comodato por entidades territoriales y que, por su uso tradicional se constituyen en espacio de prácticas culturales, materiales y espirituales   de   los pueblos indígenas.

       */

      !!@ ili2db.dispName=Comodato

      Comodato : BOOLEAN;

      /** Las tierras adquiridas por el Instituto Colombiano para la Reforma Agraria (INCORA), Instituto Colombiano de Desarrollo Rural (INCODER), o la Agencia Nacional de Tierras (ANT) en beneficio de comunidades indígenas.

       * Los predios provenientes del Fondo Nacional Agrario entregados y no titulados, y aquellos en proceso de entrega; así como los relacionados con el Fondo de Tierras del Acuerdo de Paz en beneficio de comunidades indígenas.

       */

      !!@ ili2db.dispName="Beneficio de comunidades indigenas"

      Beneficio_Comunidades_Indigenas : BOOLEAN;

      !!@ ili2db.dispName="Cabida y linderos"

      Cabida_Linderos : MTEXT;

      !!@ ili2db.dispName="Observación jurídica"

      Observacion_Juridica : MTEXT;

      /** El avalúo consiste en la determinación del valor de los predios, obtenido mediante investigación y análisis estadístico del mercado inmobiliario. El avalúo de cada predio se determinará por la adición de los avalúos parciales practicados independientemente para los terrenos y para las unidades de construcción en él comprendidos. El avalúo corresponde a un porcentaje adoptado del avalúo comercial según el estudio económico, dichos avalúos se redondean a miles.

       */

      !!@ ili2db.dispName=Avalúo

      Avaluo : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AvaluoValor;

      UNIQUE Id_Operacion;

    END ARB_Predio;

    /** Huella de construccion que agrupa multiples unidades de construccion.

     */

    !!@ ili2db.dispName="(ARB) Construccion"

    CLASS ARB_Construccion =

      !!@ ili2db.dispName=Identificador

      Identificador : MANDATORY TEXT*50;

      !!@ ili2db.dispName="Tipo construccion"

      Tipo_Construccion : ARB_TipoConstruccionTipo;

      !!@ ili2db.dispName="Tipo dominio"

      Tipo_Dominio : ARB_TipoDominioConstruccionTipo;

      !!@ ili2db.dispName="Total pisos"

      Total_Pisos : 0 .. 300;

      !!@ ili2db.dispName="Total sotanos"

      Total_Sotanos : 0 .. 100;

      !!@ ili2db.dispName="Total mezaninis"

      Total_Mezaninis : 0 .. 100;

      !!@ ili2db.dispName="Total semisotanos"

      Total_Semisotanos : 0 .. 100;

      !!@ ili2db.dispName="Area total construccion"

      Area_Total_Construccion : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName=Etiqueta

      Etiqueta : TEXT*100;

      !!@ ili2db.dispName="Estado construccion"

      Estado_Construccion : ARB_EstadoConstruccionTipo;

      !!@ ili2db.dispName=Observacion

      Observacion : MTEXT;

      Geometria : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface2D;

    END ARB_Construccion;



    /** Es cada conjunto de materiales consolidados dentro de un predio que tiene unas características específicas en cuanto a elementos constitutivos físicos y usos de la misma.

     */

    !!@ ili2db.dispName="(ARB) Unidad de construcción"

    CLASS ARB_UnidadConstruccion =

      !!@ ili2db.dispName="Tipo de planta"

      Tipo_Planta : MANDATORY ARB_ConstruccionPlantaTipo;

      !!@ ili2db.dispName="Planta ubicación"

      Planta_Ubicacion : MANDATORY 1 .. 300;

      /** Altura total de la unidad de construcción.

       */

      !!@ ili2db.dispName=Altura

      Altura : 0.000 .. 1000.000 [INTERLIS.m];

      /** Área de la unidad de construcción.

       */

      !!@ ili2db.dispName="Área unidad de construcción"

      Area_Unidad_Construccion : 0.0 .. 99999999999999.9 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName=Etiqueta

      Etiqueta : TEXT*100;

      !!@ ili2db.dispName="Relacion superficie"

      Relacion_Superficie : ARB_RelacionSuperficieConstruccionTipo;

      !!@ ili2db.dispName="Estado unidad construccion"

      Estado_Unidad_Construccion : ARB_EstadoConstruccionTipo;

      !!@ ili2db.dispName=Identificador

      Identificador : TEXT*50;

      !!@ ili2db.dispName=Adjunto

      Adjunto : BAG {0..*} OF Captura_ArbiMaps_V1_0.Captura_ArbiMaps.ARB_AdjuntoUnidadConstruccionValor;

      /** Observaciones generales respecto de la unidad de construcción.

       */

      !!@ ili2db.dispName=Observaciones

      Observaciones : MTEXT;

      Geometria : ISO19107_PLANAS_V3_0.GM_MultiSurface2D;

    END ARB_UnidadConstruccion;



    ASSOCIATION arb_predio_derecho =

      derecho -- {0..*} ARB_DerechoInteresadoFuente;

      predio -- {1} ARB_Predio;

    END arb_predio_derecho;



    ASSOCIATION arb_predio_informacionph =

      arb_predio -- {1} ARB_Predio;

      arb_informacionph -- {0..1} ARB_InformacionPH;

    END arb_predio_informacionph;



    ASSOCIATION arb_predio_marca =

      predio -- {1} ARB_Predio;

      marca -- {0..*} ARB_Marca;

    END arb_predio_marca;



    ASSOCIATION arb_predio_puntoreferencia =

      predio -- {1} ARB_Predio;

      punto_referencia -- {0..*} ARB_PuntoReferencia;

    END arb_predio_puntoreferencia;



    ASSOCIATION arb_predio_lindero =

      predio -- {1} ARB_Predio;

      lindero -- {0..*} ARB_Lindero;

    END arb_predio_lindero;



    ASSOCIATION arb_lindero_puntolindero =

      lindero -- {1} ARB_Lindero;

      punto_lindero -- {0..*} ARB_PuntoLindero;

    END arb_lindero_puntolindero;



    ASSOCIATION arb_predio_puntocontrol =

      predio -- {1} ARB_Predio;

      punto_control -- {0..*} ARB_PuntoControl;

    END arb_predio_puntocontrol;



    ASSOCIATION arb_predio_terreno =

      predio -- {1} ARB_Predio;

      terreno -- {0..*} ARB_Terreno;

    END arb_predio_terreno;



    ASSOCIATION arb_predio_terrenohistorico =

      predio -- {1} ARB_Predio;

      terreno_historico -- {0..*} ARB_TerrenoHistorico;

    END arb_predio_terrenohistorico;



    ASSOCIATION arb_predio_tramite =

      predio -- {0..*} ARB_Predio;

      tramite -- {0..*} ARB_Tramite;

    END arb_predio_tramite;

    

    ASSOCIATION arb_predio_estructuramatriculamatriz =

      predio -- {1} ARB_Predio;

      estructuramatriculamatriz -- {0..*} ARB_EstructuraMatriculaMatriz;

    END arb_predio_estructuramatriculamatriz;



    ASSOCIATION arb_predio_estructuramatriculasegregados =

      predio -- {1} ARB_Predio;

      estructuramatriculasegregados -- {0..*} ARB_EstructuraMatriculaSegregados;

    END arb_predio_estructuramatriculasegregados;



    ASSOCIATION arb_predio_estructuraprediomatriznpn =

      predio -- {1} ARB_Predio;

      estructuraprediomatriznpn -- {0..*} ARB_EstructuraPredioMatrizNPN;

    END arb_predio_estructuraprediomatriznpn;



    ASSOCIATION arb_predio_estructurapredioorigennpn =

      predio -- {1} ARB_Predio;

      estructurapredioorigennpn -- {0..*} ARB_EstructuraPredioOrigenNPN;

    END arb_predio_estructurapredioorigennpn;



    ASSOCIATION arb_predio_hipoteca =

      predio -- {1} ARB_Predio;

      hipoteca -- {0..*} ARB_Hipoteca;

    END arb_predio_hipoteca;



    ASSOCIATION arb_predio_restriccion =

      predio -- {1} ARB_Predio;

      restriccion -- {0..*} ARB_Restriccion;

    END arb_predio_restriccion;



    ASSOCIATION arb_predio_publicidad =

      predio -- {1} ARB_Predio;

      publicidad -- {0..*} ARB_Publicidad;

    END arb_predio_publicidad;



    ASSOCIATION arb_predio_informalidad =

      predio -- {1} ARB_Predio;

      informalidad -- {0..*} ARB_Informalidad;

    END arb_predio_informalidad;



    ASSOCIATION arb_predio_alertapredio =

      predio -- {1} ARB_Predio;

      alertapredio -- {0..*} ARB_AlertaPredio;

    END arb_predio_alertapredio;
    

    ASSOCIATION arb_predio_construccion =

      predio -- {1} ARB_Predio;

      construccion -- {0..*} ARB_Construccion;

    END arb_predio_construccion;



    ASSOCIATION arb_construccion_unidadconstruccion =

      construccion -- {1} ARB_Construccion;

      unidad_construccion -- {0..*} ARB_UnidadConstruccion;

    END arb_construccion_unidadconstruccion;



    ASSOCIATION unidadconstruccion_caracteristicasunidadconstruccion =

      caracteristicasunidadconstruccion -- {0..1} ARB_CaracteristicasUnidadConstruccion;

      unidadconstruccion -- {0..*} ARB_UnidadConstruccion;

    END unidadconstruccion_caracteristicasunidadconstruccion;



  END Captura_ArbiMaps;



END Captura_ArbiMaps_V1_0.

