          !!@ ili2db.dispName="Parque de diversiones"

          Parque_Diversiones,

          /** Es el espacio que con ánimo de lucro se destina a guardar o arrendar espacios para depositar vehículos dentro de una edificación construida para tal fin, o dentro de un predio habilitado con el mismo objeto.

           */

          !!@ ili2db.dispName=Parqueaderos

          Parqueaderos,

          /** Es el espacio o se destina a guardar o arrendar espacios para depositar vehículos dentro de una edificación construida privado o comunal bajo régimen de propiedad horizontal

