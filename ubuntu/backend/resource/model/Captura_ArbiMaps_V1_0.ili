        !!@ ili2db.dispName="Plaza de toros"

        Plazas_de_Toros(

          /** Recintos cerrados, generalmente circulares y descubiertos, donde se celebran las corridas de toros. Vida útil: 30 años.

           * 

           * Especificaciones Constructivas:

           * Estructura:  Entramado en  madera natural soportada sobre postes

           * Cubierta: Sin cubierta o con cubierta construida en estructura en madera con teja de zinc o fibrocemento

           * Fachada:  En madera con vinilo o sin vinilo

           * Piso:  Terreno natural o arena.

           */

          !!@ ili2db.dispName="(Plaza de toros) Madera"

          Madera_Tipo_20,

          /** Recintos cerrados, generalmente circulares y descubiertos, donde se celebran las corridas de toros. Vida útil: 70 años.

