      Total_Unidades_Privadas : 2 .. 10000;

      !!@ ili2db.dispName="Número de torres"

      Numero_Torres : 0 .. 1000;

      !!@ ili2db.dispName="Área total de terreno"

      Area_Total_Terreno : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Área total de terreno privada"

      Area_Total_Terreno_Privada : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Area privada terreno"

      Area_Privada_Terreno : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Área total de terreno común"

      Area_Total_Terreno_Comun : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Área total construida"

      Area_Total_Construida : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Área total construida privada"

      Area_Total_Construida_Privada : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Area privada construida"

      Area_Privada_Construida : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Área total construida común"

      Area_Total_Construida_Comun : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Area privada libre"

      Area_Privada_Libre : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

    END ARB_InformacionPH;



    /** Datos de los terrenos inscritos en las bases de datos catastrales en una entidad territorial.

     */

    !!@ ili2db.dispName="(ARB) Terreno histórico"

    CLASS ARB_TerrenoHistorico =

      /** Área de terreno digital registrada en la base de datos catastral.

       */

      !!@ ili2db.dispName="Área terreno digital"

      Area_Terreno_Digital : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      !!@ ili2db.dispName="Área terreno alfanumérica [m2]"

      Area_Terreno_Alfanumerica : 0.00 .. 99999999999999.98 [Captura_ArbiMaps_V1_0.m2];

      /** Polígono de la unidad de construcción existente en la base de datos catastral.

       */

      !!@ ili2db.dispName=Geometría

      Geometria : ISO19107_PLANAS_V3_0.GM_MultiSurface2D;

    END ARB_TerrenoHistorico;



    !!@ ili2db.dispName="(ARB) Adjunto Unidad de Construcción"

    STRUCTURE ARB_AdjuntoUnidadConstruccionValor =

      !!@ ili2db.dispName="Tipo de elemento"

      Tipo_Elemento : MANDATORY ARB_AdjuntoElementoTipo;

      !!@ ili2db.dispName=NPN

      npn : TEXT*30;

      !!@ ili2db.dispName=Archivo

      Archivo : TEXT;

      !!@ ili2db.dispName=Observacion

      Observacion : MTEXT;

    END ARB_AdjuntoUnidadConstruccionValor;



    /** Clase que permite agrupar las unidades de construcción por identificador, uso y tipología.

     */

    !!@ ili2db.dispName="(ARB) Características de la unidad de construcción"

    CLASS ARB_CaracteristicasUnidadConstruccion =

      /** Identificador de la unidad de construcción, su codificación puede ser por letras del abecedario.

       */

      !!@ ili2db.dispName=Identificador

      Identificador : MANDATORY TEXT*20;

      /** Es el conjunto de elementos constructivos que conforman una edificación y que de acuerdo a sus características pueden ser consideradas convencionales cuando son de uso residencial, comercial e industrial o no convencionales cuando son anexos de la construcción.

       */

      !!@ ili2db.dispName="Tipo de unidad de construcción"

      Tipo_Unidad_Construccion : MANDATORY ARB_UnidadConstruccionTipo;

      !!@ ili2db.dispName="Tipo de calificación"

      Tipo_Calificacion : MANDATORY ARB_CalificacionTipo;

      !!@ ili2db.dispName="ID Grupo (NPN)"

      ID_Grupo : MANDATORY TEXT*50;

      /** Número total de plantas en la unidad de construcción.

       */

      !!@ ili2db.dispName="Total de plantas"

      Total_Plantas : 0 .. 150;

      /** Destinación de los materiales de una unidad constructiva con respecto a la actividad económica desarrollada en la edificación del predio.

       */

      !!@ ili2db.dispName=Uso

      Uso : ARB_UsoUConsTipo;

      /** Año de construcción de la unidad de construcción.

       */

      !!@ ili2db.dispName="Año de construcción"

      Anio_Construccion : 1512 .. 2500;

      /** Área total construida en la unidad de construcción.

       */

      !!@ ili2db.dispName="Área construida"

      Area_Construida : 0.0 .. 99999999999999.9 [Captura_ArbiMaps_V1_0.m2];

      /** Área total privada de la unidad de construcción para los predios en régimen de propiedad horizontal.

       */

      !!@ ili2db.dispName="Área privada construida"

      Area_Privada_Construida : 0.0 .. 99999999999999.9 [Captura_ArbiMaps_V1_0.m2];

      /** Observaciones generales respecto de la unidad de construcción.

       */

      !!@ ili2db.dispName=Observaciones

      Observaciones : MTEXT;

      /** Identifica la relevancia tradicional y cultural de las unidades de construcción en predios de territorios y territorialidades indígenas

       */

      !!@ ili2db.dispName="Usos Tradicionales Culturales"

      Usos_Tradicionales_Culturales : ARB_UsosTradicionalesCulturalesTipo;

      !!@ ili2db.dispName="Tipo de anexo"

      CNC_Tipo_Anexo : ARB_AnexoTipo;

      /** Estado de conservación de tipología de construcción.

       */

      !!@ ili2db.dispName="Conservacion anexo"

      CNC_Conservacion_Anexo : ARB_EstadoConservacionTipologiaTipo;

      !!@ ili2db.dispName="Tipo tipología"

      CT_Tipo_Tipologia : ARB_TipologiaTipo;

      !!@ ili2db.dispName="Conservación de tipología"

      CT_Conservacion_Tipologia : ARB_EstadoConservacionTipologiaTipo;

      /** Indica si la calificación de construcción corresponde a residencial, comercial o industrial.

       */

      !!@ ili2db.dispName="Tipo a calificar"

      CC_Tipo_Calificar : ARB_CalificarTipo;

      /** Se refiere al conjunto compuesto por los cimientos, columnas, vigas, entrepisos y demás componentes del esqueleto o armadura que soportan las cargas y sostienen la edificación.  El adobe, bahareque, tapia, califíquelos con el puntaje correspondiente a madera.  En el caso de tener muros de carga en ladrillo, califíquelos como armazón de ladrillo.  En aquellas viviendas de hasta tres pisos y en donde se observe, vigas, columnas y planchas se colocan en la opción “concreto hasta tres pisos”.  La máxima calificación será para edificaciones de concreto de 4 o más pisos.

       */

      !!@ ili2db.dispName=Armazón

      CC_Armazon : ARB_ArmazonTipo;

      /** Se refiere a los muros divisorios no considerados como parte del armazón.

       */

      !!@ ili2db.dispName=Muros

      CC_Muros : ARB_MurosTipo;

      /** Techo exterior o tejado de la edificación.

       */

      !!@ ili2db.dispName=Cubierta

      CC_Cubierta : ARB_CubiertaTipo;

      /** CC_Conservacion_Estructura

       */

      !!@ ili2db.dispName="Conservación de estructura"

      CC_Conservacion_Estructura : ARB_EstadoConservacionTipo;

      /** Nombrase como tal al conjunto de elementos que constituyen el frente o parte exterior de una construcción, que da cara a la vía o camino, que incluye la puerta de acceso.  Tomada dentro de la variable, acabados principales constituyen un concepto bastante representativo de la calidad de la vivienda.

       */

      !!@ ili2db.dispName=Fachada

      CC_Fachada : ARB_FachadaTipo;

      /** Se califica de acuerdo al material y según las opciones que se presentan en el formulario, se tendrá en cuenta que si aparece por lo menos el 80% en pañete, se marcará este material y si aparece por lo menos un 20% de otro material de los más costosos (granito, madera, mármol), se marcará este en el formulario.  Si se encuentra por lo menos el 50% sin cubrimiento, se calificará como tal.  En caso de encontrarse un cubrimiento no completado en el formulario se asimilará, según el factor, más cercano de los referidos.  El pañete se refiere al cubrimiento en el cual se emplea solamente arena y cemento; el estuco es el cubrimiento fino sobre pañete.

       */

      !!@ ili2db.dispName="Cubrimiento de muros"

      CC_Cubrimiento_Muros : ARB_CubrimientoMurosTipo;

      /** En esta componente, se inscribirá lo referente al material predominante en el piso de la construcción según las opciones indicadas en el formulario y el más costoso si se encuentra en partes iguales.  Se marcará también con una X según la unidad de avalúo reconocida.

       */

      !!@ ili2db.dispName=Piso

      CC_Piso : ARB_PisoTipo;

      /** Estado de conservación del grupo calificado.

       */

      !!@ ili2db.dispName="Conservacion de acabados"

      CC_Conservacion_Acabados : ARB_EstadoConservacionTipo;

      /** Corresponde al tamaño del baño existente en la construcción.

       */

      !!@ ili2db.dispName="Tamaño de baño"

      CC_Tamanio_Banio : ARB_TamanioBanioTipo;

      /** Se refiere al cubrimiento de los muros del baño principal, se calificará según las opciones establecidas en el formulario de reconocimiento, teniendo en cuenta que los materiales y condiciones no contemplados se deben asimilar al más parecido de ellos de acuerdo con el costo.  Marque el material que corresponda al mayor porcentaje o al más costoso si se encuentran por partes iguales.

       */

      !!@ ili2db.dispName="Enchape de baño"

      CC_Enchape_Banio : ARB_EnchapeBanioTipo;

      /** Conjunto de muebles que hacen parte del baño.

       */

      !!@ ili2db.dispName="Mobiliario de baño"

      CC_Mobiliario_Banio : ARB_MobiliarioBanioTipo;

      /** Estado de conservación del grupo calificado.

       */

      !!@ ili2db.dispName="Conservación de baño"

      CC_Conservacion_Banio : ARB_EstadoConservacionTipo;

      !!@ ili2db.dispName="Tamaño de cocina"

      CC_Tamanio_Cocina : ARB_TamanioCocinaTipo;

      /** Se refiere al cubrimiento de los muros de la cocina principal, se calificará según las opciones establecidas en el formulario de reconocimiento, teniendo en cuenta que los materiales y condiciones no contemplados se deben asimilar al más parecido de ellos de acuerdo con el costo.  Marque el material que corresponda al mayor porcentaje o al más costoso si se encuentran por partes iguales.

       */

      !!@ ili2db.dispName="Enchape de cocina"

      CC_Enchape_Cocina : ARB_EnchapeCocinaTipo;

      /** Conjunto de muebles que hacen parte de la cocina.

       */

      !!@ ili2db.dispName="Mobiliario de cocina"

      CC_Mobiliario_Cocina : ARB_MobiliarioCocinaTipo;

      /** Estado de conservación del grupo calificado.

       */

      !!@ ili2db.dispName="Conservación de cocina"

      CC_Conservacion_Cocina : ARB_EstadoConservacionTipo;

      !!@ ili2db.dispName="Cerchas de complemento industrial"

