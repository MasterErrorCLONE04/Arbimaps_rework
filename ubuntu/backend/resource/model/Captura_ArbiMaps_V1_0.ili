      ARB_UsosTradicionalesCulturalesTipo = (

        /** Es una construcción cuya función es alojar temporalmente, tanto a visitantes como a miembros de una comunidad indígena. Es administrada por una autoridad indígena u organización zonal, regional o nacional.

         */

        !!@ ili2db.dispName="Casas de paso comunitarias"

        Casa_paso_comunitarios,

        /** Construcción a partir de elementos naturales destinada a usos residenciales de los pueblos indígenas

         */

        !!@ ili2db.dispName=Bohíos

        Bohio,

        /** Construcciones de uso colectivo, destinadas al intercambio y/o comercio de productos. Diseñadas según el sistema de conocimientos de cada pueblo indígena.

         */

        !!@ ili2db.dispName="Tiendas comunitarias"

        Tiendas_Comuntarias,

        /** Construcciones destinadas a la prestación de servicios comerciales, financieros de economías solidarias o cooperativistas, creadas por alguna comunidad u organización indígena.

         */

        !!@ ili2db.dispName="Cooperativas comunitarias"

        Cooperativas_Comunitarias,

        /** Construcciones o infraestructuras relacionadas con la cultura de cada pueblo indígena, destinadas al desarrollo de la actividad turística.

         */

        !!@ ili2db.dispName="Estructuras turísticas"

        Estructuras_Turisticas,

        /** Construcciones de uso colectivo donde se guardan y almacenan diferentes elementos de uso y aprovechamiento de las comunidades (alimentos, materias primas, herramientas, maquinaria, materiales de construcción, materiales reciclables, etc.)

         */

        !!@ ili2db.dispName="Bodegas comunitarias"

        Bodegas_Comunitarias,

        /** Construcciones destinadas para el secamiento y recolección de sal

         */

        !!@ ili2db.dispName="Piscinas de sal"

        Piscinas_Sal,

        /** Construcciones destinadas para congelamiento y refrigeración de alimentos o productos, que pertenecen a la comunidad, construidas según el sistema de conocimientos de cada pueblo indígena.

         */

        !!@ ili2db.dispName="Cuartos fríos comunitarios"

        Cuartos_Frios_Comunitarios,

        /** Construcciones donde funcionan las instancias de gobierno local o Cabildos Indígenas. En ellas se prestan servicios de atención a la comunidad, reuniones o asambleas de autoridades, asuntos relacionados con la administración de los sistemas autónomos, como educación, justicia, salud, entre otros. Pueden estar localizados en las cabeceras municipales o centros poblados rurales.

         */

        !!@ ili2db.dispName="Casas de cabildo"

        Casas_Cabildos,

        /** Construcciones donde funcionan las instancias representativas zonales, regionales o nacionales de los pueblos indígenas

         */

        !!@ ili2db.dispName="Sedes de organizaciones"

        Sedes_organizaciones,

        /** Son construcciones elaboradas con base en materiales y técnicas tradicionales de los pueblos indígenas, donde se crea, recrea y transmite la palabra, conocimientos, experiencias, saberes, se dan recomendaciones para la vida de los pueblos indígenas a partir de sus leyes de origen, y se desarrollan aspectos de su espiritualidad.

         */

        !!@ ili2db.dispName="Espacios de pensamiento"

        Espacios_Pensamiento,

        /** Son construcciones donde las comunidades indígenas discuten y toman decisiones en torno a diferentes asuntos internos y externos, que inciden organizativamente y administrativamente en sus territorios.

         */

        !!@ ili2db.dispName="Espacios de reunión"

        Espacios_Reunion,

        /** Son construcciones donde los pueblos indígenas aparcan sus embarcaciones tradicionales (canoas, botes, lanchas no motorizadas); sirven para cargar y descargar productos tradicionales, animales, mercancías, víveres, muebles y materiales de construcción. Además para el transporte de personas.

         */

        !!@ ili2db.dispName="Muelles comunitarios"

        Muelles_Comunitarios,

        /** Son construcciones permanentes o itinerantes con elementos destinados a la destilación de bebidas tradicionales. Pueden tener diferentes tipologías constructivas y materiales.

         */

        !!@ ili2db.dispName="Destiladeros tradicionales"

        Destiladores_Tradicionales,

        /** Construcciones permanentes o itinerantes para la molienda de granos o cereales para la producción de harinas. Puede ser de tracción animal o mecánica

         */

        !!@ ili2db.dispName="Molinos comunitarios"

        Molinos_Comunitarios,

        /** Construcciones permanentes o itinerantes para la molienda de caña de azúcar para la producción de panela o guarapo. Puede ser de tracción animal o mecánica.

         */

        !!@ ili2db.dispName="Trapiches comunitarios"

        Trapiches_Comunitarios,

        /** Construcciones permanentes o itinerantes para el secado de productos agrícolas diversos. La fuente de calor puede ser natural (Sol) o artificial (gas natural, propano,eléctrica).

         */

        !!@ ili2db.dispName=Tostaderos

        Tostaderos,

        /** Construcciones destinadas a la elaboración de alimentos, pueden contar con un fogón de uso colectivo, elaborado según el sistema de conocimientos de cada pueblo.

         */

        !!@ ili2db.dispName="Cocina Comunitaria"

        Cocina_Comunitaria,

        /** Construcciones donde en ocasiones se pernocta, y se llevan a cabo prácticas colectivas o individuales, relacionadas con la producción de alimentos, artesanías, textiles y almacenamiento temporal de cosechas. Pueden ser itinerantes o permanentes.

         */

        !!@ ili2db.dispName=Trabajaderos

        Trabajaderos,

        /** Construcciones elaboradas en materiales rústicos destinada para sembrar y secar alimentos.

         */

        !!@ ili2db.dispName=Paseras

        Paseras,

        /** Construcciones propias de los pueblos indígenas diseñadas para preservar elementos que tienen alto valor cultural, espiritual y ancestral.

         */

        !!@ ili2db.dispName=Etnomuseos

        Etnomuseos,

        /** Son construcciones de uso colectivo que están destinadas al reposo de restos mortales o cadáveres, cuyo manejo depende del sistema de conocimientos de cada pueblo.

         */

        !!@ ili2db.dispName="Cementerios indígenas"

        Cementerios_Indigenas,

        /** Construcciones donde se llevan a cabo prácticas por parte del médico tradicional y/u occidental, para el tratamiento y sanación física y espiritual.

         */

        !!@ ili2db.dispName="Centros de salud"

        Centros_Salud,

        /** Son construcciones donde se comparten tanto conocimientos propios de los sistemas de pensamiento de pueblos indígenas, como del sistema educativo ordinario.

         */

        !!@ ili2db.dispName="Instituciones educativas indígenas"

        Instituciones_Educativas_Indigenas,

        /** Son construcciones destinadas a la reunión de la comunidad, donde se llevan a cabo actividades de interés como asambleas, ceremonias, elecciones indígenas.

         */

        !!@ ili2db.dispName="Salones comunales comunitarios"

        Salones_Comunales_Comunitarios

      );



      ARB_UsoUConsTipo = (

        !!@ ili2db.dispName=Residencial

        Residencial(

          /** Es una vivienda que comprende una o más habitaciones, en un edificio de varios pisos 4 o más pisos sometido en régimen de propiedad horizontal.

           */

          !!@ ili2db.dispName="Apartamentos 4 y más pisos en PH"

          Apartamentos_4_y_mas_pisos_en_PH,

          /** Es una vivienda que comprende una o más habitaciones, en un edificio de varios pisos 4 o más pisos.

           */

          !!@ ili2db.dispName="Apartamentos más de 4 pisos"

          Apartamentos_4_y_mas_pisos,

          /** Dormitorios de las fuerzas armadas y militares

           */

          !!@ ili2db.dispName=Barracas

          Barracas,

          /** Típica casa con mampostería de piedra, pizarra y madera. Ha sido rehabilitada respetando escrupulosamente sus características exteriores y decorada con un interior tradicional

           */

          !!@ ili2db.dispName="Casa elbas"

          Casa_Elbas,

          /** Edificación destinada al almacenamiento o resguardo de enceres, generalmente ubicados en los sótanos y semisótanos de los edificios, junto a los parqueaderos. Las áreas de estos depósitos generalmente no supera los 25 metros cuadrados.

           */

          !!@ ili2db.dispName="Depósitos o lockers"

          Depositos_Lockers,

          /** Es el lugar cubierto, destinado al estacionamiento privado de vehículos.

           */

          !!@ ili2db.dispName="Garajes cubiertos"

          Garajes_Cubiertos,

          /** Es el lugar cubierto, destinado al estacionamiento privado o comunal en viviendas sometidas a régimen de propiedad  horizontal.

           */

          !!@ ili2db.dispName="Garajes en PH"

          Garajes_En_PH,

          /** Los salones comunales son dependencias que se construyen dentro de los edificios y conjuntos que sobrepasan un área determinada de construcción, y se clasifican de acuerdo a las normas urbanísticas como equipamiento comunal privado.

           */

          !!@ ili2db.dispName="Salón comunal"

          Salon_Comunal,

          /** Bien inmueble cubierto o descubierto ubicado en el último piso de algunos edificios utilizado para extender y secar la ropa y que está sometido a régimen de propiedad horizontal.

           */

          !!@ ili2db.dispName="Secadero de ropa"

          Secadero_Ropa,

          /** Son las viviendas construidas durante el tiempo de la colonia española, se caracterizan por tener varias habitaciones, con ventanales que dan a uno o dos patios generalmente ubicados en el centro de la vivienda. Los principales materiales de la época era la tapia, bahareque, ladrillo, paja y teja.

           */

          !!@ ili2db.dispName="Vivienda colonial"

          Vivienda_Colonial,

          /** Es una vivienda que comprende una o más habitaciones en un edificio de 4 o más pisos sometidos a régimen de propiedad horizontal.  Se caracterizan por conservar gran parte o el total de la construcción original realizada durante el tiempo de la colonia española. Los principales materiales de la época era la tapia, bahareque, ladrillo, paja y teja.

           */

          !!@ ili2db.dispName="Vivienda colonial en PH"

          Vivienda_Colonial_en_PH,

          /** Es una casa de tres niveles cuya función arquitectónica y ambiental principal, es dar albergue en forma adecuada a una familia.

           */

          !!@ ili2db.dispName="Vivienda hasta 3 pisos"

          Vivienda_Hasta_3_Pisos,

          /** Corresponde a edificaciones residenciales desarrolladas sobre un lote de terreno que comprende más de tres unidades prediales independientes, generalmente en edificios de varios pisos. Este tipo de vivienda prevé áreas de servicios comunales cuya propiedad y utilización privada se definen en reglamentos de propiedad horizontal

           */

          !!@ ili2db.dispName="Vivienda hasta 3 pisos en PH"

          Vivienda_Hasta_3_Pisos_En_PH,

          /** Es una vivienda acondicionada para la realización de actividades recreativas libres y el descanso.

           */

          !!@ ili2db.dispName="Vivienda recreacional"

          Vivienda_Recreacional,

          /** Es una casa cuya función arquitectónica y ambiental principal, es brindar descanso y recreación. Este tipo de vivienda  prevé áreas de servicios comunales cuya propiedad y utilización privada se definen en reglamentos de propiedad horizontal.

           */

          !!@ ili2db.dispName="Vivienda recreacional en PH"

          Vivienda_Recreacional_En_PH

        ),

        !!@ ili2db.dispName=Comercial

        Comercial(

          /** Es el espacio construido para la ejecución la recepción, almacenamiento y movimientos de materiales, materias primas y productos semielaborados, hasta el punto de consumo por un cliente externo o interno

           */

          !!@ ili2db.dispName="Bodegas comerciales - Grandes almacenes"

          Bodegas_Comerciales_Grandes_Almacenes,

          /** Es el espacio construido para la ejecución la recepción, almacenamiento y movimientos de materiales, materias primas y productos semielaborados, hasta el punto de consumo por un cliente externo o interno sometido a régimen de propiedad horizontal.

           */

          !!@ ili2db.dispName="Bodegas comerciales en PH"

          Bodegas_Comerciales_en_PH,

          /** es una construcción que consta de uno o varios edificios, por lo general de gran tamaño, que albergan servicios, locales y oficinas comerciales aglutinados en un espacio determinado concentrando mayor cantidad de clientes potenciales dentro del recinto.

           */

          !!@ ili2db.dispName="Centros comerciales"

          Centros_Comerciales,

          /** Es una construcción que consta de uno o varios edificios, por lo general de gran tamaño, que albergan servicios, locales y oficinas comerciales aglutinados en un espacio determinado concentrando mayor cantidad de clientes potenciales dentro del recinto, sometido a régimen de propiedad horizontal.

           */

          !!@ ili2db.dispName="Centros comerciales en PH"

          Centros_Comerciales_en_PH,

          /** Es la edificación o  Establecimiento que brinda servicios recreativos y tiene capacidad para ciertos juegos de azar

