    /** Clase que registra las instancias de los derechos que un interesado ejerce sobre un predio. Es una especialización de la clase COL_DRR del propio modelo.

     */

    !!@ ili2db.dispName="(ARB) Derecho Interesado Fuente"

    CLASS ARB_DerechoInteresadoFuente =

      /** Derecho que se ejerce.

       */

      !!@ ili2db.dispName="Tipo derecho"

      D_Tipo : ARB_DerechoTipo;

      !!@ ili2db.dispName="Cuota de participación"

      D_Cuota_Participacion : 0.0000000000 .. 100.0000000000;

