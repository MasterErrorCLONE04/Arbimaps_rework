      ARB_GrupoEtnicoTipo = (

        Etnico(

          /** Son el grupo humano que vive de acuerdo con las formas de relación con el medio natural en el que se asentaron los diferentes grupos aborígenes desde antes de la conquista y la han conservado y dinamizado a lo largo de la historia.

           */

          !!@ ili2db.dispName=Indígena

          Indigena,

          /** El pueblo Rrom o gitano se consolida y fortalece como grupo étnico que hacer parte de la diversidad étnica y cultural de la nación colombiana. Su origen se remonta a más de 1000 años, proviene del norte de la India y conserva un alto bagaje cultural que lo diferencia de otros pueblos y de la sociedad mayoritaria. En este sentido, cuenta con unos elementos identitarios que los diferencian notablemente de los demás grupos étnicos de la sociedad. Sé es Rrom o gitano por derecho de nacimiento y se lleva la sangre gitana.

           */

          !!@ ili2db.dispName=Rrom

          Rrom,

          /** Es la población nativa de las Islas de San Andrés, Providencia Y Santa Catalina descendientes de la unión entre europeos (principalmente ingleses, españoles y holandeses) y esclavos africanos. Se distinguen por su cultura, lengua (creole), creencias religiosas (iglesia bautista) y pasado histórico similar a los pueblos antillanos como Jamaica y Haití.

           */

          !!@ ili2db.dispName=Raizal

          Raizal,

          /** La comunidad palenquera está conformada por los descendientes de los esclavizados que mediante actos de resistencia y de libertad, se refugiaron en los territorios de la Costa Norte de Colombia desde el Siglo XV denominados palenques. Existen 4 Palenques reconocidos: San Basilio de Palenque (Mahates - Bolívar), San José de Uré (Córdoba), Jacobo Pérez Escobar (Magdalena) y La Libertad (Sucre)
           */

          !!@ ili2db.dispName=Palenquero

          Palenquero,

          /** Es el conjunto de familias de ascendencia afrocolombiana que poseen una cultura propia, comparten una historia y tienen sus propias tradiciones y costumbres dentro de la relación campo-poblado, además revelan y conservan conciencia de identidad que las distinguen de otros grupos étnicos. Se suele denominar a este grupo humano como negros, morenos, mulatos y afrodescendientes.

           */

          !!@ ili2db.dispName="Negro o afrocolombiano"

          Negro_Afrocolombiano

        ),

        /** No pertenece a ningún grupo étnico.

         */

        !!@ ili2db.dispName=Ninguno

        Ninguno

      );



      ARB_InteresadoDocumentoTipo = (

        /** Es un documento emitido por la Registraduría Nacional del Estado Civil para permitir la identificación personal de los ciudadanos.

         */

        !!@ ili2db.dispName="Cédula de ciudadanía"

        Cedula_Ciudadania,

        /** Es el documento que cumple los fines de identificación de los extranjeros en el territorio nacional y su utilización deberá estar acorde con la visa otorgada al extranjero.

         */

        !!@ ili2db.dispName="Cédula de extranjería"

        Cedula_Extranjeria,

        /** El Número de Identificación Tributaria (NIT) es un código privado, secreto e intransferible que solamente debe conocer el contribuyente.

         */

        !!@ ili2db.dispName=NIT

        NIT,

        /** Es el documento oficial que hace las veces de identificación para los menores de edad entre los 7 y los 18 años.

         */

        !!@ ili2db.dispName="Tarjeta de identidad"

        Tarjeta_Identidad,

        /** Registro donde se hacen constar por autoridades competentes los nacimientos, matrimonios, defunciones y demás hechos relativos al estado civil de las personas. En el modelo se tendrá en cuenta el número de registro como identificación personal de las personas de 0 a 7 años.

         */

        !!@ ili2db.dispName="Registro civil"

        Registro_Civil,

        /** Es un consecutivo asignado automáticamente en registro en lugar del número de la identificación de la persona que hace el trámite, se usa especialmente en trámites de construcción cuando el proyecto está a nombre de una Fiducia el cual tiene el mismo número del banco.

         */

        !!@ ili2db.dispName=Secuencial

        Secuencial,

        /** Documento que acredita la identidad y la nacionalidad de una persona y que es necesario para viajar a determinados países.

         */

        !!@ ili2db.dispName=Pasaporte

        Pasaporte

      );



      ARB_InteresadoTipo = (

        /** Se refiere a la persona humana.

         */

        !!@ ili2db.dispName="Persona natural"

        Persona_Natural,

        /** Se llama persona jurídica, una persona ficticia, capaz de ejercer derechos y contraer obligaciones civiles, y de ser representada judicial y extrajudicialmente. Las personas jurídicas son de dos especies: corporaciones y fundaciones de beneficencia pública.

         */

        !!@ ili2db.dispName="Persona jurídica"

        Persona_Juridica

      );



      !!@ ili2db.dispName="Marca predial tipo"

      ARB_MarcaPredialTipo = (

        /** Actividad esperada: Analizar la matricula su origen y su estado, para determinar si está abierto el folio y como se generó, para poder identificar el predio sobre el que se debe inscribir o ubicar dicha matricula. Analizar el antecedente registral, para determinar el origen de la matricula

         * 

         * Acciones: Ubicación en campo de predio nuevo, partiendo del antecedente registral que se encuentre inscrito en catastro.

         * Informar si existe error registral para no incorporarlo en el inventario.

         */

        !!@ ili2db.dispName="Folio de matrícula inmobiliaria no existente en el Catastro"

        Predio_Registro_Matricula_No_Existe_Catastro,

        /** Actividad esperada: Revisar el circulo registral que tiene catastro reportado para definir si se debe ubicar o no el predio en la jurisdicción de trabajo.

         * Analizar si es un folio cerrado, se debe identificar la naturaleza jurídica, la cual se debe cargar en la base de datos.

         * 

         * Acciones: Informar a Registro de los errores,mantener el predio en el censo y eliminar el predio del censo.

         */

        !!@ ili2db.dispName="Predio catastral con Folio de matrícula Inmobiliaria no ubicado en el Registro"

        Predio_Catastro_Matricula_No_Existe_Registro,

        /** Actividad esperada: Analizar el motivo de cierre del folio para determinar si existen nuevas matrículas.

         * 

         * Acciones: Inscripción de predios nuevos resultantes del cierre del folio.

         */

        !!@ ili2db.dispName="Revisión de folios cerrados"

        Predio_Con_Matricula_Cerrada,

        /** Actividad esperada: Son números de identificación ficticios cargados en la base de datos.

         * 

         * Acciones: Validar en campo el correcto número de identificación de los propietarios.

         * Actualizar los datos del interesado según el modelo de datos LADMCOL, y cargar copia del documento de identidad.

         */

        !!@ ili2db.dispName="Códigos asignados"

        Predio_Con_Codigo_Asignado,

        /** Actividad esperada: Analizar si es un error registral o catastral de ubicación de predios.

         * 

         * Acciones: Realizar el análisis que confirme o no la existencia de folios duplicados. En caso de ser un error, se debe analizar que folio corresponde a alguno de los polígonos relacionados.

         * Se deben marcar los predios para que en campo se valide la información con soporte jurídico de oficina.

         */

        !!@ ili2db.dispName="Matricula registral repetida en catastro"

        Predio_Con_Matricula_Repetida_Catastro,

        /** Actividad esperada: Conseguir los fallos de restitución con la URT, marcar los predios que tengan sentencias.

         * 

         * Acciones: Realizar el recorrido de campo teniendo en cuenta que prima la sentencia ante la realidad física, mantener los polígonos de la sentencia.

         */

        !!@ ili2db.dispName="Predios con sentencias judiciales de restitución de tierras"

        Predio_Con_Sentencia_Restitucion_De_Tierras,

        /** Actividad esperada: Estos predios en el momento de la visita, se debe tratar de identificar los linderos de los títulos, en caso de no tenerse, preguntar a los propietarios sobre estos.

         * 

         * En caso de ser u proceso iniciado, se debe identificar el estado para poder remitir a la ANT la información faltante según la ruta misional.

         * 

         * Acciones:Analizar en oficina los títulos otorgados, el levantamiento en campo realizado, para poder identificar la existencia o no de presuntos baldíos, en los predios tanto titulados como en los colindantes, se debe analizar con detenimiento los títulos de los predios colindantes, sus antecedentes registrales y las variaciones de áreas, es un trabajo conjunto y de apoyo entre el jurídico y reconocedor predial.

         * 

         * Análisis de la ruta de OSPR de lo rezagos remitidos para obtener los insumos necesarios y remitir a la información a la ANT.

         */

        !!@ ili2db.dispName="Predios titulados por los anteriores INCORA, INCODER o el actual ANT"

        Predio_Titulado_ANT,

        /** Actividad esperada: Se validan las bases de datos remitidas por el Gestor y la caracterización para identificar el tipo de restricción ambiental y poder determinar si requiere una actuación especial o no.

         * 

         * Acciones: Remitirse al documento de lineamientos de salvaguardas ambientales donde se explica el tipo de actuación a generar.

         */

        !!@ ili2db.dispName="Predios en zonas de importancia ambiental"

        Predio_Zona_Importancia_Ambiental,

        !!@ ili2db.dispName="Propietario sin identificación"

        Propietario_Sin_Identificacion,

        !!@ ili2db.dispName="Error en la estructura de la codificación del propietario"

        Error_Estructura_Codificacion_Propietario,

        !!@ ili2db.dispName="Mismo propietario y diferente identificación"

        Mismo_Propietario_Diferente_Identificacion,

        !!@ ili2db.dispName="Misma identificación y diferente propietario"

        Misma_Identificacion_Diferente_Propietario,

        !!@ ili2db.dispName="Error en el tipo de documento"

        Error_Tipo_Documento,

        !!@ ili2db.dispName="Error estructura codificación del tipo de documento"

        Error_Estructura_Tipo_Documento,

        !!@ ili2db.dispName="Predio sin dirección"

        Predio_Sin_Direccion,

        !!@ ili2db.dispName="Error en la estructura de la dirección"

