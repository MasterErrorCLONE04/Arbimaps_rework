        Planetario,
        /** Son recintos cerrados, generalmente circulares y descubiertos, donde se celebran las corridas de toros.
         */
        Plaza_de_Toros,
        /** Edificio donde se atiende a la población en un primer nivel asistencial sanitario.
         */
        Puestos_de_Salud,
        /** Construcciones, oficiales o privadas, destinadas a salvaguardar obras de arte, reliquias o antigüedades de carácter histórico, religioso o científico, que representan un periodo, una época de la humanidad o del país.
         */
        Museos,
        /** Edificación donde habitan congregaciones religiosas de distintas órdenes menticantes en el itinerario de formación o consagración religiosa.
         */
        Seminarios_Conventos,
        /** Edificio o sala destinados a la representación de obras de teatro o de otro tipo de espectáculos, que dispone de un escenario y gradas o asientos para el público, se caracterizan por sus condiciones arquitectónicas.
         */
        Teatro,
        /** Escenario deportivo destinado a la práctica de distintas disciplinas deportivas.
         */
        Unidad_Deportiva,
        /** Instalación deportiva donde se desarrollan carreras ciclistas o de patinaje.
         */
        Velodromo_Patinodromo
      ),
      /** Edificaciones Anexas.
       */
      Anexo(
        /** Depósito de agua construido a nivel del terreno con el propósito de almacenar agua, o en el caso de las bañaderas con el fin de hacer limpieza al ganado, estas construcciones son cubiertas para guardar de la intemperie.
         */
        Albercas_Banaderas,
        /** Nombre dado en zonas cafeteras a aquellas construcciones donde realizan el beneficio del café. Consiste en áreas cubiertas dentro de las cuales se encuentran los elementos destinados a la labor de seleccionar, lavar y despulpar el grano y su posterior empaque.
         */
        Beneficiaderos,
        /** Construcción para el desarrollo de proyectos acuícolas del cultivo de camarones.
         */
        Camaroneras,
        /** Superficie de terreno adecuada sobre una placa para la práctica de deportes como fútbol de salón, voleibol, baloncesto u alguna otra disciplina que haga uso de la cancha, todo ello a pequeña escala. Se excluyen las canchas de tenis, los estadios, coliseo u otras edificaciones de gran tamaño.
         */
        Canchas,
        /** Superficie terreno rectangular cruzada al medio por una red baja.
         */
        Canchas_de_Tenis,
        /** Es una vía de transporte de dominio y uso público, proyectada y construida fundamentalmente para la circulación de vehículos automóviles.
         */
        Carretera,
        /** Cada una de las superficies de un edificio que disponen de una cara al interior y de otra al exterior.
         */
        Cerramiento,
        /** Construcción anexa conformada por unos cimientos, muros y placa base.
         */
        Cimientos_Estructura_Muros_y_Placa_Base,
        /** Construcción destinada a la cría y albergue de cerdos. Se utiliza cualesquiera de los tres nombres enunciados según la región donde se ubique; los elementos que la conforman son: estructura, muros y pisos.
         */
        Cocheras_Marraneras_Porquerizas,
        /** Tenso estructuras, arquitectura textil, o membranas arquitectónicas, son los nombres con los que se le conoce a los tipos de estructura que emplean materiales que trabajan bajo tensión, sean membranas textiles, láminas, mallas de cables, etc.
         */
        Construccion_en_Membrana_Arquitectonica,
        /** Un contenedor es un recipiente de carga para el transporte marítimo o fluvial, transporte terrestre y transporte multimodal adecuado para la vivienda o el comercio o servicios.
         */
        Contenedor,
        /** Sitio cerrado y descubierto que se utiliza para la cría y albergue de ganado generalmente vacuno. consta de los elementos estructura y pisos.
         */
        Corrales,
        /** Lugar cubierto donde se encierra ganado o caballos y/o se realizan actividades propias de su explotación, constituidos por estructura, cubierta, muros y pisos.
         */
        Establos_Pesebreras_Caballerizas,
        /** Son obras arquitectónicas  que se construyen con el objeto de elevar el nivel del agua de la fuente de riego a los sitios donde se desea utilizar.
         */
        Estacion_Bombeo,
        /** Instalación que permite el tránsito de personas y la conexión con sistemas de transporte como buses, metro, tren, tranvía, terminales y estaciones, destinadas para la movilidad de las personas.
         */
        Estacion_Sistema_Transporte,
        /** Unidad construida con destino a la cría y/o protección de aves principalmente para explotación avícola. Conformada por estructura cubierta pisos y muros que son parcialmente elaborados en ladrillo y el resto descubierto o con algún material provisional (plásticos, alambres, etc.).
         */
        Galpones_Gallineros,
        /** Construcción en materiales livianos soportados sobre una base sólida anclada al piso, para uso temporal de vivienda (recreativa o de esparcimiento), generalmente aislada de otro tipo de construcciones.
         */
        Glamping,
        /** Espacio destinado para el almacenamiento y disposición de aeronaves.
         */
        Hangar,
        /** Construcción consistente en una cubierta apoyada en columnas de materiales diferentes, elaborados con el fin de guarecer de la intemperie.
         */
        Kioscos,
        /** Son depósitos construidos mediante la excavación y compactación de la tierra que almacenan agua de cualquier calidad por un periodo determinado.
         */
        Lagunas_de_Oxidacion,
        /** Cobertizo dentro de una edificación de mayor extensión o patio cubierto, clasificados según su estructura, pisos y el material de la cubierta.
         */
        Marquesinas_Patios_Cubiertos,
        /** Deberán diferenciarse de acuerdo a su estructura, longitud, capacidad, usos turísticos o de carga.
         */
        Muelles,
        /** Se denomina muralla a un muro cerrado destinado a la protección y defensa de determinado sitio.
         */
        Murallas,
        /** Las pérgolas son estructuras compuestas por columnas y una armazón superior, cubiertas con mucho follaje o toldo especial que protegen de la lluvia y el sol, también usadas como elemento decorativo en un espacio de las viviendas.
         */
        Pergolas,
        /** Estanque artificial con destino al deporte o a la recreación. Se diferencia por sus acabados y especificaciones técnicas para su mantenimiento y operación; sus dimensiones deben darse en unidades de área (m2).
         */
        Piscinas,
        /** Edificación sin cubierta con que se identifican las pistas de los aeropuertos construidas en asfalto o concreto, incluye la zona o calle de redaje y calles de salida rápida.
         */
        Pista_Aeropuerto,
        /** Perforaciones profundas manuales para extraer agua subterránea. Medida en metros de profundidad.
         */
        Pozos,
        /** Consiste en un sitio cubierto elaborado con el fin de resguardar de la intemperie; el nombre de enramadas, cobertizos o caney se utiliza según la forma de la cubierta y la región donde se ubique.
         */
        Ramadas_Cobertizos_Caneyes,
        /** Construcciones elaboradas con el objeto de secar en condiciones naturales el café principalmente, aunque es común su uso en otros productos. Consta de estructura y pisos para su calificación.
         */
        Secaderos,
        /** Construcción de grandes dimensiones que sirve para almacén o depósito, se exceptúan los silos cafeteros.
         */
        Silos,
        /** Depósitos subterráneos o de altura, construidos en zonas con deficiencias en abastecimiento para el consumo de los habitantes o para el uso agrícola.  El elemento a calificar es la estructura relacionada con la capacidad de almacenamiento medida en metros cúbicos.
         * 
         * Se excluyen de este tipo de construcción los tanques de almacenamiento domiciliario.
         */
        Tanques,
        /** Deslizadores construidos alrededor de piscinas, medidos en metros lineales. Se clasifican según su altura y materiales de construcción.
         */
        Toboganes,
        /** Edificio en forma de torre, en cuya cima se sitúa una sala de control, desde la que se dirige y controla el tráfico de un puerto, de un aeropuerto o de un circuito de carreras.
         */
        Torre_de_Control,
        /** Son estructuras diseñadas para disminuir la temperatura del agua y otros medios.
         */
        Torres_de_Enfriamiento,
        /** Parte de la infraestructura ferroviaria que une dos puntos determinados del territorio.
         */
        Via_Ferrea
      )
    );

    /** Valores para indicar el tipo de informalidad.
     */
    SINIC_DerechoCatastralTipo = (
      /** Persona natural o jurídica asentada en un predio con título de dominio.
       */
      Dominio,
      /** Persona natural o jurídica asentada en un predio de propiedad privada con ánimo de señor y dueño, que no cuenta con título de dominio.
       */
      Posesion,
      /** Persona natural o jurídica asentada en un predio público baldío, público fiscal patrimonial, uso público o público presunto baldío.
       */
      Ocupacion
    );

  TOPIC SINIC
  EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo =
    OID AS INTERLIS.UUIDOID;
    DEPENDS ON LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo;

    /** Clase que hereda los atributos de la  Clase COL_AgrupacionInteresados.
     */
    CLASS CR_AgrupacionInteresados
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_AgrupacionInteresados =
    END CR_AgrupacionInteresados;

    /** Clase que contiene los datos principales del predio matriz sometido al régimen de propiedad horizontal.
     */
    CLASS CR_DatosMatriz =
      /** Área total del terreno del PH, Condominio, parque cementerio Matriz.
       */
      Area_Total_Terreno : 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área total privada del terreno del PH, Condominio, parque cementerio Matriz.
       */
      Area_Total_Terreno_Privada : 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área total de terreno común del PH, Condominio, parque cementerio Matriz.
       */
      Area_Total_Terreno_Comun : 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área total construida del PH, Condominio, parque cementerio Matriz.
       */
      Area_Total_Construida : 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área total construida privada del PH, Condominio, parque cementerio Matriz.
       */
      Area_Total_Construida_Privada : 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área total construida común del PH, Condominio, parque cementerio Matriz.
       */
      Area_Total_Construida_Comun : 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Número de torres en el PH, Condominio, parque cementerio Matriz.
       */
      Numero_Torres : 0 .. 1000 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Total de unidades privadas en el PH, Condominio, parque cementerio Matriz.
       */
      Total_Unidades_Privadas : 0 .. 99999999 [LADM_COL_v_4_0_1_Nucleo.m2];
    END CR_DatosMatriz;

    /** Estructura que contiene el estado del predio en la base de datos catastral.
     */
    STRUCTURE CR_EstructuraAlertaPredio =
      /** Descripción general de la alerta del predio en la base de datos catastral.
       */
      Descripcion_Alerta : MANDATORY TEXT*255;
      /** Nombre de la entidad emisora del estado de alerta del predio.
       */
      Entidad_Emisora_Alerta : MANDATORY TEXT*255;
      /** Fecha de apertura de la alerta emitida por la entidad competente o por el gestor catastral.
       */
      Fecha_Apertura_Alerta : MANDATORY INTERLIS.XMLDate;
      /** Fecha de cierre de la alerta emitida por la entidad competente o por el gestor catastral.
       */
      Fecha_Cierre_Alerta : INTERLIS.XMLDate;
    END CR_EstructuraAlertaPredio;

    /** Estructura que contiene el avalúo del predio en la base de datos catastral.
     */
    STRUCTURE CR_EstructuraAvaluo =
      /** Fecha de la realización del avalúo catastral.
       */
      Fecha_Avaluo : MANDATORY INTERLIS.XMLDate;
      /** Precio más probable por el cual un predio se transaría en un mercado en donde el comprador y el vendedor actuarían libremente con el conocimiento de las condiciones físicas y jurídicas que afectan el bien, el cual debe contar con soporte económico acorde con la teoría de valor y su único fin es la determinación de los avalúos catastrales por parte de los gestores catastrales.
       */
      Valor_Comercial : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Valor de un predio resultante de un ejercicio técnico en desarrollo de los procesos catastrales, que, en ningún caso, podrá ser inferior al 60% del valor comercial o superar el valor de este último.  
       */
      Avaluo_Catastral : MANDATORY LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Valor más probable por el cual se transaría el terreno en el mercado.
       */
      Valor_Comercial_Terreno : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Avalúo catastral del terreno.
       */
      Avaluo_Catastral_Terreno : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Valor más probable por el cual se transarían las unidades constructivas  en el mercado.
       */
      Valor_Comercial_Total_UnidadesConstruccion : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Avalúo catastral de las unidades de construcción.
       */
      Avaluo_Catastral_Total_UnidadesConstruccion : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Derecho que tiene todo interesado de presentar antes del 30 de junio de cada año ante el correspondiente gestor catastral, la Secretaría de Hacienda municipal, distrital y/o quien haga sus veces, la estimación del avalúo catastral de su inmueble.
       */
      Autoestimacion : MANDATORY BOOLEAN;
      /** Se deberá indicar si el predio tuvo aplicación de lo dispuesto en el artículo 49 de la ley 2294 del 2023 por el cual se expide el plan nacional de desarrollo 2022 - 2026 "Colombia potencia mundial de la vida".
       */
      Incremento : BOOLEAN;
    END CR_EstructuraAvaluo;

    /** Estructura que contiene los avalúos de la característica de construcción.
     */
    STRUCTURE CR_EstructuraAvaluoCaracterizacion =
      /** Corresponde a la fecha de la estimación o cálculo del avalúo.
       */
      Fecha_Avaluo : MANDATORY INTERLIS.XMLDate;
      /** Corresponde al valor comercial de la caracteristica de construcción.
       */
      Valor_Comercial : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Corresponde al avalúo catastral de la característica de construcción.
       */
      Avaluo_Catastral : MANDATORY LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
    END CR_EstructuraAvaluoCaracterizacion;

    /** Estructura que define los valores de avaluos catastrales de la intersección de un predio informal con un predio formal.
     */
    STRUCTURE CR_EstructuraAvaluoInterseccion =
      /** Avalúo Catastral de la intersección del terreno del predio informal con el terreno del predio formal.
       */
      Avaluo_Catastral_Interseccion_Terreno : MANDATORY LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Avalúo Catastral de la intersección de las unidades de construcción de un predio informal con el terreno de un predio formal.
       */
      Avaluo_Catastral_Interseccion_Unidades_Construccion : LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
      /** Avalúo Catastral de la intersección total.
       */
      Avaluo_Catastral_Interseccion_Total : MANDATORY LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.Peso;
    END CR_EstructuraAvaluoInterseccion;

    /** Estructura que permite identificar el predio o los predios de los cuales proviene(n) nueva(s) unidad(es) predial(es) producto de segregación o agregación.
     */
    STRUCTURE CR_EstructuraPredioMatrizNPN =
      /** Código numérico de treinta (30) dígitos, que se le asigna a cada predio para su identificación en la base de datos catastral de acuerdo con la estructura definida por el IGAC.
       */
      Numero_Predial_Nacional : MANDATORY TEXT*30;
      /** Es el área del terreno inscrita en la base de datos catastral, de conformidad con el artículo 5.2.3. de la Resolución 1040 de 2023.
       */
      Area_Catastral_Terreno : 0.00 .. 10000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
    END CR_EstructuraPredioMatrizNPN;

    /** Estructura que permite identificar el  número predial nacional anterior a los cambios de renumeración producto de la adopción de la estructura definida por el IGAC  y que permite mantener el historial del predio.
     */
    STRUCTURE CR_EstructuraPredioOrigenNPN =
      /** Código numérico de treinta (30) dígitos, que se le asigna a cada predio para su identificación en la base de datos catastral de acuerdo con la estructura definida por el IGAC.
       */
      Numero_Predial_Nacional : MANDATORY TEXT*30;
      /** Fecha en la cual se cambió el Numero Predial Nacional.
       */
      Fecha_Cambio_NPN : MANDATORY INTERLIS.XMLDate;
    END CR_EstructuraPredioOrigenNPN;

    /** Estructura que contiene los procedimientos catastrales con efectos registrales.
     */
    STRUCTURE CR_EstructuraProcedimientoCatastralRegistral =
      /** Indicar el o los procedimientos catastrales con efectos registrales utilizados sobre el predio.
       */
      ProcedimientoCatastralRegistral : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_ProcedimientoCatastralRegistralTipo;
    END CR_EstructuraProcedimientoCatastralRegistral;

    /** Estructura que permite incorporar referencias registrales del sistema antiguo.
     */
    STRUCTURE CR_EstructuraReferenciaRegistralSistemaAntiguo =
      /** Valores: Estructurada y No Estructurada.
       */
      Tipo_Referencia : MANDATORY (
        Estructurada,
        No_Estructurada
      );
      /** Nombre de la oficina de registro de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Oficina : TEXT*50;
      /** Número del libro indicado en la ficha catastral.
       */
      Libro : TEXT*1;
      /** Número del tomo indicado en la ficha catastral.
       */
      Tomo : TEXT*2;
      /** Página de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Pagina : TEXT*4;
      /** Número de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Numero : TEXT*4;
      /** Día de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Dia : TEXT*2;
      /** Mes de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Mes : TEXT*2;
      /** Año de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Anio : TEXT*2;
      /** Número de la matrícula de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Matricula : MANDATORY TEXT*20;
    END CR_EstructuraReferenciaRegistralSistemaAntiguo;

    /** Clase que almacena las fuentes administrativas (escrituras, sentencias, actos administrativos, etc) que sustentan el Derecho respecto de la relación de tenencia entre el Interesado y el predio.
     */
    CLASS CR_FuenteAdministrativa
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_FuenteAdministrativa =
      /** Documentos como escritura pública, sentencia judicial, acto administrativo, documento privado o sin documento (puede ser una declaración verbal), que acredita la adquisición de derechos de dominio sobre un bien inmueble y la relación que existe entre el interesado y el predio.
       */
      Tipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_FuenteAdministrativaTipo;
      /** El  tipo de oficina que emite el documento (notaria, juzgado, entidad pública).
       */
      Ente_Emisor : TEXT*255;
      /** Es el número con el cual se identifica la oficina que origina el documento.
       */
      Oficina_Origen : 0 .. 100;
      /** Es la ciudad donde se encuentra ubicada la oficina que expide el documento.
       */
      Ciudad_Origen : TEXT*60;
    END CR_FuenteAdministrativa;

    /** Clase que hereda los atributos de la Clase COL_FuenteEspacial.
     */
    CLASS CR_FuenteEspacial
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_FuenteEspacial =
    END CR_FuenteEspacial;

    /** Para el desarrollo de la gestión catastral es la persona que frente a un inmueble ostenta la relación jurídica de propietario, poseedor u ocupante.
     */
    CLASS CR_Interesado
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_Interesado =
      /** Clase de documentos públicos que permite la identificación del interesado.
       */
      Tipo_Documento (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_DocumentoTipo;
      /** Primer nombre del interesado en la gestión catastral.
       */
      Primer_Nombre : TEXT*100;
      /** Segundo nombre del interesado en la gestión catastral.
       */
      Segundo_Nombre : TEXT*100;
      /** Primer apellido del interesado en la gestión catastral.
       */
      Primer_Apellido : TEXT*100;
      /** Segundo apellido del interesado en la gestión catastral.
       */
      Segundo_Apellido : TEXT*100;
      /** Corresponde a “Masculino”, “Femenino”, “No Binario” o "Sin determinar" según como aparezca en el documento de identidad. No aplica este tipo de identificación para personas jurídicas.
       */
      Sexo : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_SexoTipo;
      /** "Según la Corte Constitucional (sentencia T-445-22), las personas tienen el derecho a auto reconocerse como pertenecientes a cualquier etnia si subjetivamente considera que tiene los vínculos culturales, familiares o históricos.
       * 
       * En este sentido, la persona puede auto reconocerse como indígena, gitano Romaní, raizal, palenquero, negro o afrocolombiano"
       */
      AutoreconocimientoEtnico : Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_AutoreconocimientoEtnicoTipo;
      /** Todo habitante de zonas rurales tiene la opción de autoreconocerse como campesino en función del artículo 64 de la Constitución Política.
       */
      AutoreconocimientoCampesino : BOOLEAN;
      /** Nombre jurídico que recibe un sociedad colectiva o empresa constituida legalmente, con el cual se encuentra inscrito.
       */
      Razon_Social : TEXT*255;
    END CR_Interesado;

    /** Linea de división que separa un bien inmueble de otro, que puede o no estar materializada físicamente.
     */
    CLASS CR_Lindero
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_CadenaCarasLimite =
      /** Longitud en metros del lindero.
       */
      Longitud : MANDATORY 0.0 .. 100000000000.0 [INTERLIS.m];
    END CR_Lindero;

    /** Puntos topográficos o geodésicos utilizados como amarre para la ejecución del levantamiento catastral.
     */
    CLASS CR_PuntoControl
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_Punto =
      /** Nombre o código del punto de control.
       */
      ID_Punto_Control : MANDATORY TEXT*255;
      /** Indica la clasificación del tipo de punto de acuerdo a sus características.
       */
      PuntoTipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_PuntoTipo;
      /** Es el método utilizado para definir puntos de terreno que son identificables dentro de una fotografía, a los cuales se les puede determinar las coordenadas terrestres de linderos y vértices una vez realizada su digitalización.
       */
      Tipo_Punto_Control : Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_PuntoControlTipo;
      /** Describe la cercanía en posición de los objetos en el conjunto de datos, con respecto a sus posiciones verdaderas (o las asumidas como verdaderas).
       */
      Exactitud_Horizontal : 0.000 .. 10.000 [INTERLIS.m];
      MANDATORY CONSTRAINT PuntoTipo <> #Control ;
      MANDATORY CONSTRAINT PuntoTipo <> #Otro ;
    END CR_PuntoControl;

    /** Punto que define la frontera de un predio con otro. La sucesión de estos puntos forma una línea que representa el límite entre dos terrenos. 
     */
    CLASS CR_PuntoLindero
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_Punto =
      /** Nombre o código que identifica el punto lindero.
       */
      ID_Punto_Lindero : MANDATORY TEXT*255;
      /** Indica la clasificación del tipo de punto de acuerdo a sus características.
       */
      PuntoTipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_PuntoTipo;
      /** Indica si existe desacuerdo o no entre los colindantes en relación al punto lindero que se está midiendo.
       */
      Desacuerdo : MANDATORY BOOLEAN;
      /** Es el método utilizado para definir puntos de terreno que son identificables dentro de una fotografía, a los cuales se les puede determinar las coordenadas terrestres de linderos y vértices una vez realizada su digitalización.
       */
      Fotoidentificacion : Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_FotoidentificacionTipo;
      /** Describe la cercanía en posición de los objetos en el conjunto de datos, con respecto a sus posiciones verdaderas (o las asumidas como verdaderas).
       */
      Exactitud_Horizontal : 0.000 .. 10.000 [INTERLIS.m];
      MANDATORY CONSTRAINT PuntoTipo <> #Control ;
      MANDATORY CONSTRAINT PuntoTipo <> #Otro ;
    END CR_PuntoLindero;

    /** Extensión geográfica espacial del predio
     */
    CLASS CR_Terreno
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_UnidadEspacial =
      /** Corresponde a la figura geométrica vectorial poligonal.
       */
      Geometria (EXTENDED) : MANDATORY ISO19107_PLANAS_V3_1.GM_MultiSurface3D;
    END CR_Terreno;

    /** Clase que contiene los cambios que se presentan en los componentes físico, jurídico o económico de un predio, una vez han sido formados.
     */
    CLASS CR_TramiteCatastral =
      /** Cambios que se presentan en los componentes físico, jurídico o económico de un predio.
       */
      Clasificacion_Mutacion : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_MutacionTipo;
      /** Numero de la resolucion de la mutación o trámite expedida por el gestor catastral.
       */
      Numero_Resolucion : MANDATORY TEXT*30;
      /** Fecha de la resolucion de la mutación o trámite expedida por el gestor catastral.
       */
      Fecha_Resolucion : MANDATORY INTERLIS.XMLDate;
      /** Fecha de la recepción de la solicitud ante el gestor catastral cuando es a solicitud de parte, o inicio de la actuación administrativa cuando es de oficio.
       */
      Fecha_Radicacion : MANDATORY INTERLIS.XMLDate;
      /** Fecha  de incorporación de la mutación o trámite en la base de datos catastral.
       */
      Fecha_Inscripcion : MANDATORY INTERLIS.XMLDate;
    END CR_TramiteCatastral;

    /** Edificación dentro de un predio, que tiene unas características específicas en cuanto a uso y elementos constitutivos físicos.
     */
    CLASS CR_UnidadConstruccion
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_UnidadEspacial =
      /** Indica el tipo de planta donde se ubica la unidad de construcción.
       */
      Tipo_Planta : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_ConstruccionPlantaTipo;
      /** Indica numéricamente la ubicación de la planta.
       */
      Planta_Ubicacion : MANDATORY 0 .. 300;
      /** Altura total de la planta.
       */
      Altura : 1 .. 1000 [INTERLIS.m];
      /** Corresponde a la figura geométrica vectorial poligonal.
       */
      Geometria (EXTENDED) : ISO19107_PLANAS_V3_1.GM_MultiSurface3D;
    END CR_UnidadConstruccion;

    /** Derecho Catastral: Dominio (Formal), Ocupación (Informal) o Posesión (Informal)
     */
    CLASS SINIC_DerechoCatastral
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_DRR =
      /** Tipo de informalidad que puede presentarse en cada predio.
       */
      Tipo : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC_DerechoCatastralTipo;
    END SINIC_DerechoCatastral;

    /** Clase que permite agrupar las unidades de construcción por identificador, uso y tipología.
     */
    CLASS CR_CaracteristicasUnidadConstruccion =
      /** Identificador de la unidad de construcción, su codificación puede ser por letras del abecedario.
       */
      Identificador : MANDATORY TEXT*20;
      /** Tipo de unidad de construcción.
       */
      Tipo_Unidad_Construccion : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_UnidadConstruccionTipo;
      /** Número total de plantas en la unidad de construcción.
       */
      Total_Plantas : MANDATORY 0 .. 150;
      /** Es la actividad que se desarrolla en las unidades de construcción al momento de la identificación predial.
       */
      Uso : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_UsoUConsTipo;
      /** Año de construcción de la unidad de construcción.
       */
      Anio_Construccion : MANDATORY 1512 .. 2500;
      /** Área total construida en la unidad de construcción.
       */
      Area_Construida : MANDATORY 0.0 .. 99999999999999.9;
      /** Elemento que permite estimar el estado de las características constructivas en distintos criterios de integridad.
       */
      Estado_Conservacion : MANDATORY TEXT*30;
      /** Avalúo correspondiente a la carateristica de las unidades de construcción.
       */
      Avaluo_Caracterizacion : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraAvaluoCaracterizacion;
      /** Observaciones generales respecto de la unidad de construcción.
       */
      Observaciones : TEXT;
    END CR_CaracteristicasUnidadConstruccion;

    /** Clase especializada de BaUnit, que describe al predio como la unidad administrativa básica para la gestión catastral con enfoque multipropósito en Colombia.
     * 
     * Predio: inmueble con o sin título registrado, no separado por otro predio, con o sin unidades de construcción y vinculado con personas naturales o jurídicas, según su relación de tenencia: propietario, poseedor u ocupante.
     */
    CLASS SINIC_Predio
    EXTENDS LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.COL_UnidadAdministrativaBasica =
      /** Corresponde al codigo del departamento al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 2 dígitos.
       */
      Departamento : MANDATORY TEXT*2;
      /** Corresponde al código del municipio al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 3 dígitos.
       */
      Municipio : MANDATORY TEXT*3;
      /** Es la descripción de la ubicación del predio.
       */
      Direccion : BAG {1..*} OF LADM_COL_v_4_0_1_Nucleo.LADM_Nucleo.ExtDireccion;
      /** Cifras distintivas de la oficina de registro, a la cual pertenece la matrícula inmobiliaria.
       */
      Codigo_ORIP : TEXT*4;
      /** Folio destinado a la inscripción de los actos, contratos y providencias relacionados en el artículo 4° de la Ley 1579 de 2012 “Por la cual se expide el estatuto de registro de instrumentos públicos y se dictan otras disposiciones”, referente a un bien raíz, el cual se distinguirá con un código alfanumérico o complejo numeral indicativo del orden interno de cada oficina de registro y de la sucesión en que se vaya sentando.
       */
      Matricula_Inmobiliaria : 1 .. 9999999999;
      /** Registro asociado a la anotación en antiguo sistema de registro (Libros).
       */
      Referencia_Registral_Sistema_Antiguo : Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraReferenciaRegistralSistemaAntiguo;
      /** Código numérico de treinta (30) dígitos, que se le asigna a cada predio para su identificación en la base de datos catastral de acuerdo con la estructura definida por el IGAC.
       */
      Numero_Predial_Nacional : MANDATORY TEXT*30;
      /** Número predial nacional anterior a los cambios de renumeración producto de la adopación de la estructura definida por el IGAC  y que permite mantener el historial del predio. Ejemplo: cambio de predios formales a informales, mejoras a informales, rural a urbano, urbano a rural o cambio de vereda o manzana. En este caso el predio sigue siendo el mismo, solo cambia el identificador predial.
       */
      Predio_Origen_NPN : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraPredioOrigenNPN;
      /** Predio o los predios de los cuales proviene(n) nueva(s) unidad(es) predial(es) producto de segregación o agregación.
       */
      Predio_Matriz_NPN : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraPredioMatrizNPN;
      /** Código único para identificar los inmuebles en los sistemas de información catastral que se utiliza para efectos de la interrelación catastro-registro, el cual es entregado por el IGAC a los gestores catastrales para su correspondiente asignación.
       */
      Codigo_Homologado : MANDATORY TEXT*11;
      /** Código único para identificar los predios tanto en los sistemas de información catastral como registral. El NUPRE se obtiene a partir del código homologado de identificación predial una vez efectuada la interrelación de la base catastral con la registral.  No implicará la supresión del número predial nacional ni la matrícula inmobiliaria actual. 
       */
      NUPRE : TEXT*11;
      /** Fecha de registro de los ingresos, modificaciones o cancelaciones en la base de datos catastral, de acuerdo con lo señalado en el título IV de la Resolución 1040 de 2023.
       */
      Fecha_Inscripcion_Catastral : INTERLIS.XMLDate;
      /** Distinción conceptual que permite identificar a qué régimen se encuentran sometidos los bienes inmuebles, y por tanto si son de propiedad privada o por el contrario son predios públicos que pueden catalogarse como: predios que pertenecen a la Nación, a una entidad territorial o a alguna entidad de derecho público.
       */
      Tipo_Predio : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_PredioTipo;
      /** Caracterización temática de las condiciones de predio que se está censando relacionada a aspectos físicos y jurídicos.
       */
      Condicion_Predio : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_CondicionPredioTipo;
      /** Clasificación que se da a cada inmueble en su conjunto -terreno y unidades de construcción-, en el momento de la identificación predial de conformidad con la actividad predominante que en él se desarrolle.
       */
      Destinacion_Economica : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_DestinacionEconomicaTipo;
      /** Área del terreno inscrita en la base de datos catastral, de conformidad con el artículo 5.2.3. de la Resolución 1040 de 2023.
       */
      Area_Catastral_Terreno : MANDATORY 0.00 .. 10000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área consignada en el certificado de tradición y libertad, en la descripción de cabida y linderos o en los títulos registrados, expresada en metros cuadrados.
       */
      Area_Registral_M2 : 0.00 .. 10000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Estructura que contiene los datos de los avalúos de la gestión catastral.
       */
      Avaluo : BAG {1..*} OF Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraAvaluo;
      /** Se considerará como procedimientos catastrales con efectos registrales los siguientes: actualización de linderos, rectificación de área por imprecisa determinación, actualización masiva y puntual de linderos y áreas, rectificación de linderos por acuerdo entre las partes, e inclusión de área y/o linderos.
       */
      Procedimiento_Catastral_Registral : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraProcedimientoCatastralRegistral;
      /** Fecha en la que entró en vigencia el último proceso de actualización catastral.
       */
      Vigencia_Actualizacion_Catastral : MANDATORY INTERLIS.XMLDate;
      /** Describe si el predio se encuentra activo o cancelado en la base de datos catastral.
       */
      Estado : MANDATORY Modelo_Aplicacion_LADMCOL_SINIC_V1_0.CR_EstadoTipo;
      /** Advertencia generada por entidades públicas sobre el predio.
       */
      Alerta_Predio : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraAlertaPredio;
      UNIQUE Numero_Predial_Nacional;
      UNIQUE Codigo_Homologado;
      UNIQUE NUPRE;
    END SINIC_Predio;

    /** Relación entre unidades prediales y predios matrices bajo el régimen de propiedad horizontal y condominio.
     */
    ASSOCIATION cr_predio_copropiedad =
      unidad_predial -- {0..*} SINIC_Predio;
      /** Unidades residenciales tales como edificios, conjuntos y tipos de urbanizaciones cerradas en las que se comparten áreas comunes y que tienen régimen de propiedad horizontal.
       */
      matriz -<> {0..1} SINIC_Predio;
      /** Porcentaje de participación en la copropiedad de acuerdo con el reglamento de propiedad horizontal registrado.
       */
      Coeficiente : MANDATORY 0.000000000000 .. 1.000000000000;
      /** Área con propósitos estadísticos calculada como el producto del coeficiente de copropiedad, tal como se establece en el reglamento de propiedad horizontal registrado, por las áreas comunes de terreno.
       */
      Area_Catastral_Terreno_Coeficiente : MANDATORY 0.00 .. 99999999999999.98 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Corresponde únicamente a los predios en condición de condominio (8), este dato es el resultante de la información registrada y consignado en los respectivos folios de matrícula inmobiliaria, los cuales están debidamente delimitados, funcionalmente independientes, de propiedad y aprovechamiento exclusivo, integrantes de un reglamento de propiedad horizontal debidamente registrado.
       * 
       * Para predios en condición de condominio unidad predial y cuya diferencia porcentual entre el área geométrica de terreno privada en relación con el área registral se encuentre dentro de la tolerancia, se incorporará en la base de datos el área registral. Si la diferencia excede los límites de tolerancia se incorporará el área geométrica.
       */
      Area_Privada_Terreno : 0.00 .. 1000000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área cubierta de cada bien privado, excluyendo los bienes comunes dentro de sus linderos, de acuerdo con el reglamento de propiedad horizontal debidamente registrado y las normas legales.
       */
      Area_Privada_Construida : 0.00 .. 1000000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área semidescubierta o descubierta, excluyendo los bienes comunes localizados dentro de sus linderos, de conformidad con el reglamento de propiedad horizontal debidamente registrado y las normas legales.
       */
      Area_Privada_Libre : 0.00 .. 1000000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
    END cr_predio_copropiedad;

    /** Relación entre unidades prediales y predios matrices.
     */
    ASSOCIATION cr_predio_datosmatriz =
      cr_predio -- {1} SINIC_Predio;
      cr_datos_matriz -- {0..1} CR_DatosMatriz;
    END cr_predio_datosmatriz;

    /** Atributo que permite identificar las relaciones entre los predios formales e informales.
     */
    ASSOCIATION cr_predio_informalidad =
      /** Relación de la llave principal (T_Id) de la clase predio del predio formal.
       */
      cr_predio_formal -- {0..*} SINIC_Predio;
      /** Relación de llave principal (T_Id) de la clase predio del predio informal.
       */
      cr_predio_informal -- {0..*} SINIC_Predio;
      /** Área del terreno donde se presenta la sobreposición entre el predio informal sobre el formal.
       */
      Area_Terreno_Interseccion : MANDATORY 0.00 .. 10000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Área construida donde se presenta la sobreposición entre el predio informal sobre el formal.
       */
      Area_Construida_Interseccion : 0.00 .. 10000000000000000000000.00 [LADM_COL_v_4_0_1_Nucleo.m2];
      /** Estructura que define los valores de avaluos catastrales de la intersección de un predio formal con un predio informal.
       */
      Avaluo_Catastral_Interseccion : Modelo_Aplicacion_LADMCOL_SINIC_V1_0.SINIC.CR_EstructuraAvaluoInterseccion;
    END cr_predio_informalidad;

    ASSOCIATION cr_predio_tramitecatastral =
      cr_predio -- {0..*} SINIC_Predio;
      cr_tramite_catastral -- {0..*} CR_TramiteCatastral;
    END cr_predio_tramitecatastral;

    ASSOCIATION cr_unidadconstruccion_caracteristicasunidadconstruccion =
      cr_caracteristicasunidadconstruccion -- {1} CR_CaracteristicasUnidadConstruccion;
      cr_unidadconsutruccion -- {1..*} CR_UnidadConstruccion;
    END cr_unidadconstruccion_caracteristicasunidadconstruccion;

  END SINIC;

END Modelo_Aplicacion_LADMCOL_SINIC_V1_0.
